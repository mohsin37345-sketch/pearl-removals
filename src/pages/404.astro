---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Icon from 'theme/components/Icon.astro';
import { siteConfig } from 'src/data/site';

const breadcrumbs = [
  { name: '404 - Page Not Found', url: '/404/' }
];
---

<BaseLayout
  title="Page Not Found (404) | Pearl Removals"
  description="The page you are looking for does not exist or has been moved. Explore Pearl Removals services and areas in North West London."
  canonicalUrl="https://www.pearlremovals.co.uk/404/"
  noindex={true}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <div class="glass-panel p-8 sm:p-12 rounded-3xl space-y-6">
      
      <div class="text-6xl sm:text-7xl font-black text-royal">
        404
      </div>

      <div class="space-y-2">
        <h1 class="text-2xl sm:text-3xl font-black text-navy dark:text-pearl tracking-tight">
          Page Not Found
        </h1>
        <p class="text-sm text-surface-600 dark:text-surface-400 max-w-md mx-auto leading-relaxed">
          The link you followed may be incorrect, or the page may have been moved.
        </p>
      </div>

      <!-- Quick Helpful Links -->
      <div class="pt-4 border-t border-surface-200 dark:border-white/10 text-xs">
        <h2 class="font-bold text-navy dark:text-pearl mb-3">Popular Helpful Destinations:</h2>
        <div class="flex flex-wrap items-center justify-center gap-2">
          <a href="/" class="glass-pill px-4 py-2 rounded-xl text-royal font-bold hover:bg-royal hover:text-white transition-colors">
            Homepage
          </a>
          <a href="/removals/" class="glass-pill px-4 py-2 rounded-xl text-navy dark:text-pearl hover:text-royal transition-colors">
            Our Services
          </a>
          <a href="/areas/" class="glass-pill px-4 py-2 rounded-xl text-navy dark:text-pearl hover:text-royal transition-colors">
            Areas We Cover
          </a>
          <a href="/prices/" class="glass-pill px-4 py-2 rounded-xl text-navy dark:text-pearl hover:text-royal transition-colors">
            Pricing Guide
          </a>
          <a href="/get-a-quote/" class="glass-pill px-4 py-2 rounded-xl text-navy dark:text-pearl hover:text-royal transition-colors">
            Get a Quote
          </a>
        </div>
      </div>

      <div class="pt-6">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-royal text-white font-bold text-xs tracking-wide hover:bg-royal-hover transition-colors shadow-md shadow-royal/20"
        >
          <Icon name="home" class="w-4 h-4" />
          <span>Back to Home</span>
        </a>
      </div>

      <p class="text-[11px] text-surface-400">
        Need immediate help? Call our office on <a href={`tel:${siteConfig.phoneE164}`} class="text-royal underline font-bold">{siteConfig.phone}</a>.
      </p>

    </div>
  </article>
</BaseLayout>
