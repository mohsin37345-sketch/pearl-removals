---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { siteConfig } from 'src/data/site';

const breadcrumbs = [
  { name: '404 - Page Not Found', url: '/404/' }
];
---

<BaseLayout
  title="Page Not Found (404) | Pearl Removals"
  description="The page you are looking for does not exist or has been moved. Explore Pearl Removals services and areas in North West London."
  canonicalUrl="https://www.pearlremovals.co.uk/404/"
  noindex={true}
  breadcrumbs={breadcrumbs}
>
  <article class="container" style="max-width: 720px; padding-block: 80px; text-align: center;">
    <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); padding: clamp(32px, 6vw, 64px); box-shadow: var(--shadow-md);">
      
      <div style="font-family: var(--font-display); font-size: clamp(64px, 10vw, 96px); font-weight: 800; color: var(--accent); line-height: 1;">
        404
      </div>

      <div style="margin-top: 16px;">
        <h1 style="font-size: clamp(24px, 4vw, 36px); font-family: var(--font-display); color: var(--ink);">
          Page Not Found
        </h1>
        <p style="color: var(--muted); font-size: 16px; margin-top: 8px;">
          The link you followed may be incorrect, or the page may have been moved.
        </p>
      </div>

      <!-- Quick Helpful Links -->
      <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--line);">
        <h2 style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 16px;">
          Popular Helpful Destinations:
        </h2>
        <div class="chips" style="justify-content: center; margin-top: 0;">
          <a href="/" class="chip">Homepage</a>
          <a href="/removals/" class="chip">Our Services</a>
          <a href="/areas/" class="chip">Areas We Cover</a>
          <a href="/get-a-quote/" class="chip">Get a Quote</a>
        </div>
      </div>

      <div style="margin-top: 36px;">
        <a href="/" class="btn btn--accent">
          Return to Homepage <svg class="arrow"><use href="#i-arrow"/></svg>
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
