---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Hero from 'theme/components/Hero.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import CTABand from 'theme/components/CTABand.astro';
import StatsPanel from 'theme/components/StatsPanel.astro';
import Icon from 'theme/components/Icon.astro';

const breadcrumbs = [
  { name: 'About Us', url: '/about-us/' }
];
---

<BaseLayout
  title="About Pearl Removals | North West London Removal Company"
  description="Learn about Pearl Removals: our Cricklewood NW2 transport base, experienced moving crews, £50k GIT insurance, and commitment to stress-free London relocations."
  canonicalUrl="https://www.pearlremovals.co.uk/about-us/"
  schemaType="about"
  breadcrumbs={breadcrumbs}
>
  <Hero
    variant="simple"
    title="About Pearl Removals"
    subtitle="A trusted North West London house removals team dedicated to careful, punctual, and transparent moving services."
    eyebrow="OUR HERITAGE & PROMISE"
    badges={["Cricklewood NW2 Base", "Fully Insured", "Local London Movers"]}
  />

  <TrustStrip />

  <Breadcrumbs items={breadcrumbs} />

  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    
    <!-- Company Story & Base -->
    <div class="glass-panel p-6 sm:p-10 rounded-3xl space-y-6 text-sm sm:text-base leading-relaxed text-surface-700 dark:text-surface-300">
      <div class="flex items-center gap-2 text-royal font-bold text-xs uppercase tracking-widest">
        <Icon name="home" class="w-4 h-4" />
        <span>Rooted in Cricklewood NW2</span>
      </div>

      <h2 class="text-2xl sm:text-3xl font-black text-navy dark:text-pearl tracking-tight">
        Careful Moving Driven by Experience and Local Knowledge
      </h2>

      <p>
        Pearl Removals was founded on a simple principle: moving home should be an exciting milestone, not an ordeal of broken promises, damaged furniture, and surprise fees. Based in Cricklewood, North West London, we have built our reputation street by street, delivering attentive, white-glove relocations across Camden, Brent, Barnet, Westminster, and throughout the capital.
      </p>

      <p>
        Moving in London presents unique obstacles. Narrow Victorian terraced hallways in Kilburn, restricted parking on red routes along the A5, strict lift-booking slots in Maida Vale mansion blocks, and steep communal staircases in West Hampstead all demand practical foresight. Our crews know the local borough parking suspension rules, arrive on time with the appropriate permits in hand, and take personal pride in safeguarding your home.
      </p>
    </div>

    <!-- Core Values Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="glass-panel p-6 rounded-3xl">
        <div class="w-10 h-10 rounded-2xl bg-royal/10 text-royal flex items-center justify-center mb-4">
          <Icon name="shield-check" class="w-5 h-5" />
        </div>
        <h3 class="font-bold text-base text-navy dark:text-pearl mb-2">
          Genuine Protection
        </h3>
        <p class="text-xs sm:text-sm text-surface-600 dark:text-surface-400 leading-relaxed">
          Every move is protected by comprehensive £50,000 Goods in Transit insurance and £5,000,000 Public Liability cover, with quilted blankets and sofa covers standard.
        </p>
      </div>

      <div class="glass-panel p-6 rounded-3xl">
        <div class="w-10 h-10 rounded-2xl bg-royal/10 text-royal flex items-center justify-center mb-4">
          <Icon name="receipt" class="w-5 h-5" />
        </div>
        <h3 class="font-bold text-base text-navy dark:text-pearl mb-2">
          Transparent Pricing
        </h3>
        <p class="text-xs sm:text-sm text-surface-600 dark:text-surface-400 leading-relaxed">
          No vague hourly meters that tick away in London traffic. We conduct thorough pre-move surveys and issue clear written fixed-price quotations.
        </p>
      </div>

      <div class="glass-panel p-6 rounded-3xl">
        <div class="w-10 h-10 rounded-2xl bg-royal/10 text-royal flex items-center justify-center mb-4">
          <Icon name="users" class="w-5 h-5" />
        </div>
        <h3 class="font-bold text-base text-navy dark:text-pearl mb-2">
          Trained, Respectful Crews
        </h3>
        <p class="text-xs sm:text-sm text-surface-600 dark:text-surface-400 leading-relaxed">
          Our moving staff are courteous, punctual professionals who treat your family and belongings with the consideration and patience they deserve.
        </p>
      </div>
    </div>

    <!-- Fleet & Equipment -->
    <div class="glass-panel p-6 sm:p-10 rounded-3xl space-y-4 text-sm sm:text-base leading-relaxed text-surface-700 dark:text-surface-300">
      <h3 class="text-xl sm:text-2xl font-black text-navy dark:text-pearl tracking-tight">
        Our Fleet & Specialist Equipment
      </h3>
      <p>
        Our fleet consists of modern, clean 3.5-tonne Luton box vans equipped with hydraulic tail lifts, carpet protection runners, heavy-duty appliance sack trucks, piano skids, and ratchet tie-down rails. Because London streets are frequently congested, our vehicle sizing allows us to access restricted residential roads and mews where larger articulated lorries cannot navigate.
      </p>
      <p>
        For substantial 4 and 5-bedroom residences, we deploy multiple synchronized vehicles or 7.5-tonne vehicles, ensuring full loading can be completed swiftly on exchange and completion day without holding up the property transaction chain.
      </p>
    </div>

    <!-- Standards & Trust Promises -->
    <StatsPanel />

    <CTABand
      title="Meet the Pearl Removals Team"
      subtitle="Call our Cricklewood dispatch office today to discuss your upcoming move or schedule a free video survey."
    />
  </article>
</BaseLayout>
