---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Hero from 'theme/components/Hero.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import AreaCoverageMap from 'theme/components/AreaCoverageMap.astro';
import QuoteFormSection from 'theme/components/QuoteFormSection.astro';
import CTABand from 'theme/components/CTABand.astro';
import LocationCard from 'theme/components/LocationCard.astro';
import { getPublishedAreas, getPublishedRegions } from 'theme/utils/published';
import { areasRegistry } from 'src/data/areas';
import { siteConfig } from 'src/data/site';

const breadcrumbs = [
  { name: 'Areas We Cover', url: '/areas/' }
];

const publishedAreas = await getPublishedAreas();
const publishedRegions = await getPublishedRegions();

// Phase 1 preview areas for display while content collections are staged
const phase1RegistryAreas = areasRegistry.filter((a) => a.phase === 1);
---

<BaseLayout
  title="Areas We Cover Across North West London | Pearl Removals"
  description="Discover the areas Pearl Removals serves across North West London, West London, and surrounding boroughs. Operating from our central Cricklewood NW2 depot."
  canonicalUrl="https://www.pearlremovals.co.uk/areas/"
  breadcrumbs={breadcrumbs}
>
  <Hero
    variant="area"
    title="Areas We Cover in North West London & Beyond"
    subtitle="Based in Cricklewood NW2, our fleet provides comprehensive house and flat removals across all North West London postcodes and nationwide."
    eyebrow="LOCAL LONDON COVERAGE"
    highlightText="North West London"
  />

  <TrustStrip />

  <Breadcrumbs items={breadcrumbs} />

  <!-- Area Coverage Map Section -->
  <AreaCoverageMap />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {publishedAreas.length === 0 ? (
      <div class="space-y-12">
        <div class="glass-panel p-8 sm:p-12 text-center max-w-3xl mx-auto space-y-6">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-royal/10 text-royal text-xs font-bold uppercase tracking-wider">
            <span>● Daily Dispatch from Cricklewood NW2</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-navy dark:text-pearl tracking-tight">
            Actively Moving Homes Across All NW Postcodes
          </h2>
          <p class="text-sm sm:text-base text-surface-600 dark:text-surface-400 leading-relaxed">
            Our comprehensive local area guides and street-by-street access profiles are being released in stages. However, our fleet is on the road 7 days a week, carrying out residential and commercial moves across every North West London neighbourhood.
          </p>
          <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
            <a
              href={`tel:${siteConfig.phoneE164}`}
              class="px-6 py-3 rounded-full bg-royal text-white font-bold text-sm hover:bg-royal-hover transition-colors shadow-lg shadow-royal/20"
            >
              Call Dispatch: {siteConfig.phone}
            </a>
            <a
              href="/get-a-quote/"
              class="px-6 py-3 rounded-full glass-panel border border-surface-300 dark:border-white/20 text-navy dark:text-pearl font-bold text-sm hover:bg-white/40 transition-colors"
            >
              Request Online Quote &rarr;
            </a>
          </div>
        </div>

        <div>
          <div class="text-center max-w-2xl mx-auto mb-8">
            <h3 class="text-xl sm:text-2xl font-black text-navy dark:text-pearl tracking-tight">
              Phase 1 Priority Service Areas
            </h3>
            <p class="text-xs sm:text-sm text-surface-500 mt-1">
              Direct service within 0-5 miles of our Cricklewood operations hub.
            </p>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 sm:gap-4">
            {phase1RegistryAreas.map((area) => (
              <div class="glass-panel p-4 rounded-2xl flex flex-col justify-between hover:border-royal/40 transition-colors">
                <div>
                  <div class="flex items-center justify-between gap-1 mb-1">
                    <span class="text-xs font-bold text-navy dark:text-pearl">{area.name}</span>
                    {area.premium && <span class="text-gold text-xs" title="Premium Area">&#9733;</span>}
                  </div>
                  <div class="text-[11px] text-surface-500">{area.postcodes.join(', ')}</div>
                </div>
                <div class="mt-3 pt-2 border-t border-surface-200 dark:border-white/5 text-[10px] text-surface-400 flex items-center justify-between">
                  <span>~{area.distanceMiles}m from base</span>
                  <span class="text-royal font-medium">{area.micros.length} micro areas</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    ) : (
      <div class="space-y-12">
        {publishedRegions.map((region) => (
          <div class="space-y-6">
            <div class="flex items-center justify-between border-b border-surface-200 dark:border-white/10 pb-4">
              <div>
                <h2 class="text-2xl font-bold text-navy dark:text-pearl">{region.name}</h2>
                <p class="text-xs sm:text-sm text-surface-500">{region.areas.length} active coverage areas</p>
              </div>
              <a
                href={`/areas/${region.slug}/`}
                class="text-xs sm:text-sm font-bold text-royal hover:underline"
              >
                View {region.name} Hub &rarr;
              </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {region.areas.map((area) => (
                <LocationCard
                  name={area.name}
                  slug={area.slug}
                  postcodes={area.postcodes}
                  distanceMiles={area.distanceMiles}
                  premium={area.premium}
                  microCount={area.micros.length}
                />
              ))}
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  <!-- Quote Form Section -->
  <QuoteFormSection title="Check Availability in Your Area" />

  <!-- CTA Band -->
  <CTABand
    title="Moving Outside North West London?"
    subtitle="We provide long-distance removals from London to anywhere across England, Wales, and Scotland."
  />
</BaseLayout>
