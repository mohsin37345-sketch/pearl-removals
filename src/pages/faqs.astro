---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import FAQ from 'theme/components/FAQ.astro';
import CTABand from 'theme/components/CTABand.astro';
import QuoteFormSection from 'theme/components/QuoteFormSection.astro';
import globalFaqs from 'src/data/faqs.json';

const breadcrumbs = [
  { name: 'FAQs', url: '/faqs/' }
];
---

<BaseLayout
  title="Removals FAQs | Pearl Removals North West London"
  description="Got questions about moving home in North West London? Read our removals FAQs covering prices, packing, council parking suspensions, insurance, and completion day."
  canonicalUrl="https://www.pearlremovals.co.uk/faqs/"
  schemaType="page"
  breadcrumbs={breadcrumbs}
  faqs={globalFaqs}
>
  <section class="page-intro">
    <div class="container">
      <div class="page-intro__content">
        <div class="page-intro__eyebrow">
          <span class="eyebrow">HELP &amp; ANSWERS</span>
        </div>
        <h1 class="page-intro__title">
          Frequently Asked <span class="mark">Questions<svg viewBox="0 0 200 20" preserveAspectRatio="none"><path d="M3 15 C 50 4, 140 2, 197 12" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg></span>
        </h1>
        <p class="page-intro__lead">
          Clear, direct answers to common questions about house removals, London parking permits, quotes, and insurance.
        </p>
        <div class="page-intro__badges">
          <span class="pill"><span class="pill__dot"><svg><use href="#i-chat"/></svg></span>Pricing &amp; Surveys</span>
          <span class="pill"><span class="pill__dot"><svg><use href="#i-pin"/></svg></span>Parking Suspensions</span>
          <span class="pill"><span class="pill__dot"><svg><use href="#i-shield"/></svg></span>Insurance Cover</span>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />

  <Breadcrumbs items={breadcrumbs} />

  <article class="container" style="padding-block: 40px; display: flex; flex-direction: column; gap: 40px;">
    <FAQ items={globalFaqs} title="General Moving & Booking Questions" />

    <CTABand
      title="Still Have a Specific Question?"
      description="Our Cricklewood team is here to assist with any unusual access conditions or questions."
    />

    <QuoteFormSection title="Ready to Get Your Free Quote?" />
  </article>
</BaseLayout>
