---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import QuoteFormFull from 'theme/components/QuoteFormFull.astro';

// Extract query parameters if redirected from an inline form or area page
const fromPostcode = Astro.url.searchParams.get('from_postcode') || '';
const moveType = Astro.url.searchParams.get('move_type') || 'house';

const breadcrumbs = [
  { name: 'Get a Quote', url: '/get-a-quote/' }
];
---

<BaseLayout
  title="Get a Free Moving Quote | Pearl Removals London"
  description="Request a free, no-obligation moving quote from Pearl Removals. Transparent fixed prices for house removals, flat moves, and man & van in North West London."
  canonicalUrl="https://www.pearlremovals.co.uk/get-a-quote/"
  breadcrumbs={breadcrumbs}
  showStickyBar={false}
>
  <section class="page-intro">
    <div class="container">
      <div class="page-intro__content">
        <div class="page-intro__eyebrow">
          <span class="eyebrow">QUICK &amp; SIMPLE ESTIMATE</span>
        </div>
        <h1 class="page-intro__title">
          Request Your Free <span class="mark">Moving Quote<svg viewBox="0 0 200 20" preserveAspectRatio="none"><path d="M3 15 C 50 4, 140 2, 197 12" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg></span>
        </h1>
        <p class="page-intro__lead">
          Tell us a few details about your move and we'll prepare an accurate, transparent fixed quotation with no hidden fees.
        </p>
        <div class="page-intro__badges">
          <span class="pill"><span class="pill__dot"><svg><use href="#i-check"/></svg></span>No Obligation</span>
          <span class="pill"><span class="pill__dot"><svg><use href="#i-pound"/></svg></span>Guaranteed Fixed Prices</span>
          <span class="pill"><span class="pill__dot"><svg><use href="#i-shield"/></svg></span>Free Video Surveys</span>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />

  <Breadcrumbs items={breadcrumbs} />

  <article class="container py-8 sm:py-12">
    <QuoteFormFull
      initialFromPostcode={fromPostcode}
      initialMoveType={moveType}
    />
  </article>
</BaseLayout>
