---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import HowItWorksComponent from 'theme/components/HowItWorks.astro';
import CTABand from 'theme/components/CTABand.astro';

const breadcrumbs = [
  { name: 'How It Works', url: '/how-it-works/' }
];
---

<BaseLayout
  title="How Removals Work | Pearl Removals North West London"
  description="Step-by-step guide to our house removal process: free video surveys, packing assistance, completion day key waiting, and settling into your new London home."
  canonicalUrl="https://www.pearlremovals.co.uk/how-it-works/"
  breadcrumbs={breadcrumbs}
>
  <section class="page-intro">
    <div class="container">
      <div class="page-intro__content">
        <div class="page-intro__eyebrow">
          <span class="eyebrow">STEP-BY-STEP PROCESS</span>
        </div>
        <h1 class="page-intro__title">
          How Pearl Removals <span class="mark">Works<svg viewBox="0 0 200 20" preserveAspectRatio="none"><path d="M3 15 C 50 4, 140 2, 197 12" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg></span>
        </h1>
        <p class="page-intro__lead">
          A calm, structured, and fully supported moving experience from your first estimate to the final box unpacked.
        </p>
        <div class="page-intro__badges">
          <span class="pill"><span class="pill__dot"><svg><use href="#i-clipboard"/></svg></span>Survey &amp; Inventory</span>
          <span class="pill"><span class="pill__dot"><svg><use href="#i-pin"/></svg></span>Council Parking Guidance</span>
          <span class="pill"><span class="pill__dot"><svg><use href="#i-clock"/></svg></span>Completion Day Protocol</span>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />

  <Breadcrumbs items={breadcrumbs} />

  <article class="container" style="padding-block: 40px; display: flex; flex-direction: column; gap: 40px;">
    
    <HowItWorksComponent marginTop={false} />

    <!-- In-Depth Phases Breakdown -->
    <div style="display: grid; gap: 24px;">
      
      <!-- Phase 1 -->
      <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); padding: clamp(24px, 4vw, 36px); box-shadow: var(--shadow-sm);">
        <span class="eyebrow" style="margin-bottom: 8px;">Stage 1: Pre-Move Planning &amp; Survey</span>
        <h3 style="font-size: 22px; font-weight: 700; color: var(--ink); margin-bottom: 12px;">
          Precise Volume Calculation via Free Video Survey
        </h3>
        <p style="color: var(--muted); font-size: 15px; line-height: 1.65; margin: 0;">
          Accurate estimates avoid moving-day chaos. We offer a convenient 15-minute video survey where you walk through your home, opening cupboards and showing large furniture items. This allows us to calculate the exact cubic footage, determine the required number of Luton vans and movers, and identify fragile goods requiring bespoke protection.
        </p>
      </div>

      <!-- Phase 2 -->
      <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); padding: clamp(24px, 4vw, 36px); box-shadow: var(--shadow-sm);">
        <span class="eyebrow" style="margin-bottom: 8px;">Stage 2: London Parking Suspensions &amp; Permits</span>
        <h3 style="font-size: 22px; font-weight: 700; color: var(--ink); margin-bottom: 12px;">
          CPZ Management Across Camden, Brent, Barnet &amp; Westminster
        </h3>
        <p style="color: var(--muted); font-size: 15px; line-height: 1.65; margin: 0;">
          London parking requires careful advance coordination. We advise you on the exact suspension notice periods required by your local council (often 10–14 working days) and help you reserve the kerbside space needed directly outside your property, ensuring zero van access delays on removal morning.
        </p>
      </div>

      <!-- Phase 3 -->
      <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); padding: clamp(24px, 4vw, 36px); box-shadow: var(--shadow-sm);">
        <span class="eyebrow" style="margin-bottom: 8px;">Stage 3: Loading, Protection &amp; Transit</span>
        <h3 style="font-size: 22px; font-weight: 700; color: var(--ink); margin-bottom: 12px;">
          Floor Runners, Quilted Covers &amp; £50k Transit Cover
        </h3>
        <p style="color: var(--muted); font-size: 15px; line-height: 1.65; margin: 0;">
          Our uniformed team arrives on schedule. We lay heavy-duty floor runners to protect carpets and hardwood flooring. Mattresses, sofas, and dining tables are wrapped in quilted transit blankets. Wardrobe boxes ensure hanging clothes travel without creasing.
        </p>
      </div>

      <!-- Phase 4 -->
      <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); padding: clamp(24px, 4vw, 36px); box-shadow: var(--shadow-sm);">
        <span class="eyebrow" style="margin-bottom: 8px;">Stage 4: Key Release &amp; Unloading</span>
        <h3 style="font-size: 22px; font-weight: 700; color: var(--ink); margin-bottom: 12px;">
          Patient Completion Day Key Waiting &amp; Room-by-Room Placement
        </h3>
        <p style="color: var(--muted); font-size: 15px; line-height: 1.65; margin: 0;">
          Property chains can experience delays. We understand key release schedules and wait patiently outside your new property. Once keys are released, our crew unloads every box into its designated room and reassembles beds and heavy furniture so you can sleep comfortably on your very first night.
        </p>
      </div>

    </div>

    <CTABand />

  </article>
</BaseLayout>
