---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Hero from 'theme/components/Hero.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import ServiceGrid from 'theme/components/ServiceGrid.astro';
import StatsPanel from 'theme/components/StatsPanel.astro';
import FleetShowcase from 'theme/components/FleetShowcase.astro';
import HowItWorks from 'theme/components/HowItWorks.astro';
import WhyChooseUs from 'theme/components/WhyChooseUs.astro';
import PricingTable from 'theme/components/PricingTable.astro';
import ComparisonTable from 'theme/components/ComparisonTable.astro';
import AreaCoverageMap from 'theme/components/AreaCoverageMap.astro';
import Testimonials from 'theme/components/Testimonials.astro';
import FAQ from 'theme/components/FAQ.astro';
import FeaturedPosts from 'theme/components/FeaturedPosts.astro';
import QuoteFormSection from 'theme/components/QuoteFormSection.astro';
import CTABand from 'theme/components/CTABand.astro';
import globalFaqs from 'src/data/faqs.json';
import { getCollection } from 'astro:content';

let posts: any[] = [];
try {
  posts = await getCollection('blog', ({ data }) => !data.draft);
} catch {
  posts = [];
}

let verifiedReviews: any[] = [];
try {
  verifiedReviews = await getCollection('testimonials', ({ data }) => data.verified === true);
} catch {
  verifiedReviews = [];
}
---

<BaseLayout
  title="House Removals North West London | Pearl Removals"
  description="Premium house removals in North West London based in Cricklewood NW2. Fully insured, transparent fixed pricing, packing services and free surveys. Call 020 3151 8452."
  canonicalUrl="https://www.pearlremovals.co.uk/"
  schemaType="home"
  faqs={globalFaqs}
  verifiedReviews={verifiedReviews}
>
  <!-- 1. Hero with quote form & North West London keywords -->
  <Hero
    title="House Removals in North West London"
    highlightText="North West London"
    eyebrow="LOCAL NORTH WEST LONDON REMOVALS • CRICKLEWOOD NW2"
    subtitle="Fully insured house, flat and office removals based at our Cricklewood NW2 transport hub. Transparent fixed pricing, free video surveys, and white-glove care across Camden, Brent, Barnet, Westminster and all London postcodes."
    badges={[
      "£50k GIT Cover Included",
      "Camden, Brent & Barnet CPZ Support",
      "4.9★ Rated (380+ Moves)",
      "Fixed Price Guarantee"
    ]}
    defaultFromPostcode="NW2"
    hasVerifiedReviews={verifiedReviews.length > 0}
  />

  <!-- 2. Trust strip -->
  <TrustStrip />

  <!-- 3. Local Hub Welcome & Dispatch Overview -->
  <section class="section section--white" style="padding-block: 56px;">
    <div class="container">
      <div style="background: var(--pearl); border: 1px solid var(--line); border-radius: var(--r-xl); padding: clamp(28px, 5vw, 44px); display: flex; flex-direction: column; lg:flex-row; justify-content: space-between; align-items: center; gap: 32px;">
        <div style="max-width: 700px;">
          <span class="eyebrow" style="margin-bottom: 8px;">Welcome to Pearl Removals</span>
          <h2 style="font-size: clamp(24px, 3.5vw, 36px); font-weight: 800; color: var(--ink); margin-bottom: 14px; line-height: 1.2;">
            North West London's Dedicated Moving Specialists
          </h2>
          <p style="font-size: 15.5px; color: var(--muted); line-height: 1.7; margin: 0 0 20px;">
            Operating directly from our transport hub in <strong>Cricklewood, London NW2</strong>, Pearl Removals delivers white-glove house relocations, flat moves, and commercial transport across <strong>Camden, Brent, Barnet, Westminster</strong>, and the wider capital. Every move is handled by our polite, experienced crew with dedicated Luton box vans and <strong>£50,000 Goods in Transit insurance</strong>.
          </p>
          <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <a href="/about-us/" class="btn btn--ghost btn--sm">About our Cricklewood crew <svg class="arrow"><use href="#i-arrow"/></svg></a>
            <a href="/how-it-works/" class="btn btn--ghost btn--sm">How our moves work</a>
          </div>
        </div>

        <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 24px; box-shadow: var(--shadow-sm); width: 100%; max-width: 360px;">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
            <span class="icon-tile" style="width: 44px; height: 44px; border-radius: 12px; background: var(--accent-soft); color: var(--accent);">
              <svg><use href="#i-pin"/></svg>
            </span>
            <div>
              <strong style="display: block; font-size: 16px; color: var(--ink);">Rapid London Dispatch</strong>
              <span style="font-size: 13px; color: var(--muted);">Cricklewood NW2 &amp; All London</span>
            </div>
          </div>
          <p style="font-size: 13.5px; color: var(--muted); margin: 0 0 16px; line-height: 1.5;">
            Need an accurate price for your upcoming move? Get a fixed-price itemised quote in under 60 seconds with no obligation.
          </p>
          <a href="/get-a-quote/" class="btn btn--accent btn--block btn--sm">
            Get an instant quote <svg class="arrow"><use href="#i-arrow"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Services -->
  <ServiceGrid showSpecialistRow={true} />

  <!-- 5. Stats -->
  <StatsPanel />

  <!-- 6. Fleet & Capabilities Showcase -->
  <FleetShowcase />

  <!-- 7. How it works -->
  <HowItWorks />

  <!-- 7. Why choose us -->
  <WhyChooseUs />

  <!-- 8. Pricing & Comparison Table -->
  <section class="section section--white" id="pricing" aria-labelledby="pricing-preview-heading">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">Honest, Clear Rates</span>
        <h2 id="pricing-preview-heading">Transparent Pricing With No Hidden Fees</h2>
        <p>Every quote from Pearl Removals is fully itemised in writing before moving day, backed by our fixed price guarantee.</p>
      </div>

      <!-- Pricing Table Component -->
      <PricingTable />

      <!-- Competitor Comparison Section -->
      <div style="margin-top: 56px;">
        <div class="section-head section-head--center reveal" style="margin-bottom: 24px;">
          <span class="eyebrow">The Professional Standard</span>
          <h3 style="font-size: clamp(22px, 3vw, 30px); font-weight: 800; color: var(--ink);">
            How Pearl Removals Compares
          </h3>
          <p style="font-size: 15px; color: var(--muted);">
            Why homeowners across North West London trust our dedicated removals crew over casual van drivers.
          </p>
        </div>

        <ComparisonTable />
      </div>
    </div>
  </section>

  <!-- 9. Areas we cover -->
  <AreaCoverageMap />

  <!-- 10. Reviews -->
  <Testimonials reviews={verifiedReviews} />

  <!-- 11. FAQ -->
  <FAQ items={globalFaqs} />

  <!-- 12. Featured Blog Posts -->
  <FeaturedPosts posts={posts} />

  <!-- 13. Homepage Interactive Quote Form Section -->
  <QuoteFormSection />

  <!-- 14. CTA band -->
  <CTABand />
</BaseLayout>
