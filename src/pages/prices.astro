---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import PricingTable from 'theme/components/PricingTable.astro';
import ComparisonTable from 'theme/components/ComparisonTable.astro';
import CTABand from 'theme/components/CTABand.astro';

const breadcrumbs = [
  { name: 'Pricing', url: '/prices/' }
];
---

<BaseLayout
  title="Removal Costs & Pricing Guide | Pearl Removals London"
  description="Transparent removals pricing for North West London. Rate bands for flats, houses, man and van, and packing services with clear qualifying conditions. No hidden fees."
  canonicalUrl="https://www.pearlremovals.co.uk/prices/"
  breadcrumbs={breadcrumbs}
>
  <section class="page-intro">
    <div class="container">
      <div class="page-intro__content">
        <div class="page-intro__eyebrow">
          <span class="eyebrow">CLEAR &amp; HONEST PRICING</span>
        </div>
        <h1 class="page-intro__title">
          House Removals <span class="mark">Pricing Guide<svg viewBox="0 0 200 20" preserveAspectRatio="none"><path d="M3 15 C 50 4, 140 2, 197 12" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg></span>
        </h1>
        <p class="page-intro__lead">
          Transparent, upfront rate bands with clearly stated conditions. We believe you should know what your move costs before booking.
        </p>
        <div class="page-intro__badges">
          <span class="pill"><span class="pill__dot"><svg><use href="#i-pound"/></svg></span>Fixed Written Quotes</span>
          <span class="pill"><span class="pill__dot"><svg><use href="#i-clock"/></svg></span>No Hidden Key-Wait Fees</span>
          <span class="pill"><span class="pill__dot"><svg><use href="#i-shield"/></svg></span>All Insurance Included</span>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />

  <Breadcrumbs items={breadcrumbs} />

  <article class="container" style="padding-block: 40px; display: flex; flex-direction: column; gap: 40px;">
    
    <div>
      <PricingTable />
    </div>

    <!-- Pricing Factors Explanation -->
    <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); padding: clamp(28px, 5vw, 44px); box-shadow: var(--shadow-sm);">
      <span class="eyebrow" style="margin-bottom: 8px;">Cost Breakdown</span>
      <h3 style="font-size: clamp(22px, 3.2vw, 30px); font-weight: 700; color: var(--ink); margin-bottom: 20px;">
        What Key Factors Determine Your Removal Quote?
      </h3>

      <div class="features" style="margin-top: 0;">
        <div class="feature">
          <span class="icon-tile"><svg><use href="#i-box"/></svg></span>
          <h4>1. Total Volume of Belongings</h4>
          <p>The overall volume of goods dictates whether your move requires one 3.5T Luton van, multiple vans, or a larger vehicle, along with the size of the moving crew.</p>
        </div>

        <div class="feature">
          <span class="icon-tile"><svg><use href="#i-pin"/></svg></span>
          <h4>2. Travel Distance &amp; London Traffic</h4>
          <p>Distance between collection and delivery addresses, including travel time across London, congestion zones, and access routes.</p>
        </div>

        <div class="feature">
          <span class="icon-tile"><svg><use href="#i-home"/></svg></span>
          <h4>3. Property Access &amp; Flights of Stairs</h4>
          <p>Whether your property has direct driveway access, tight staircase turns, elevator availability, or long walking distances from the van parking bay.</p>
        </div>

        <div class="feature">
          <span class="icon-tile"><svg><use href="#i-shield"/></svg></span>
          <h4>4. Specialist Services &amp; Packing</h4>
          <p>Adding our full professional packing service, wardrobe boxes, fine art handling, or piano relocation.</p>
        </div>
      </div>
    </div>

    <!-- Moving Cost Calculator Interactive Callout -->
    <div style="background: var(--pearl); border: 1px solid var(--line); border-radius: var(--r-xl); padding: clamp(24px, 4vw, 36px); display: flex; flex-direction: column; md:flex-row; justify-content: space-between; align-items: center; gap: 24px; box-shadow: var(--shadow-sm);">
      <div style="max-width: 600px;">
        <span class="eyebrow" style="margin-bottom: 6px;">Instant Online Estimator</span>
        <h3 style="font-size: clamp(20px, 2.5vw, 24px); font-weight: 700; color: var(--ink); margin-bottom: 8px;">
          Want a Tailored Fixed Price in 60 Seconds?
        </h3>
        <p style="color: var(--muted); font-size: 14.5px; line-height: 1.6; margin: 0;">
          Use our interactive multi-step quote form to select your exact items, dates, and property details for a guaranteed fixed price.
        </p>
      </div>
      <div>
        <a href="/get-a-quote/" class="btn btn--accent btn--block">
          Get a Free Quote <svg class="arrow"><use href="#i-arrow"/></svg>
        </a>
      </div>
    </div>

    <!-- Comparison Table -->
    <div>
      <div class="section-head section-head--center" style="margin-bottom: 24px;">
        <span class="eyebrow">The Professional Standard</span>
        <h3 style="font-size: clamp(22px, 3vw, 30px); font-weight: 800; color: var(--ink);">
          Fixed Written Quotes vs Casual Hourly Rates
        </h3>
        <p style="font-size: 15px; color: var(--muted);">
          Why fixed price quotes protect your budget from unpredictable London traffic delays and key-waiting disputes.
        </p>
      </div>
      <ComparisonTable />
    </div>

    <CTABand />

  </article>
</BaseLayout>
