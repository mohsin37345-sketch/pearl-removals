---
import ServiceLayout from 'theme/layouts/ServiceLayout.astro';

const serviceData = {
  title: 'Fine Art & Antiques Removals',
  slug: 'fine-art-and-antiques-removals',
  metaTitle: 'Fine Art & Antiques Removals London | Pearl Removals',
  metaDescription: 'Specialist fine art and antiques removals in North West London. Museum-grade packing, bespoke timber crating, acid-free tissue & temperature-controlled care.',
  heroHeading: 'Fine Art & Antiques Removals in North West London',
  heroSubheading: 'Museum-grade packaging, bespoke timber crating, and white-glove handling for irreplaceable paintings, sculptures, porcelain, and period antique furnishings.',
  icon: 'frame',
  summary: 'High-value art and antique relocation featuring custom wooden crates, acid-free barrier wraps, and dedicated climate-conscious transit.',
  priceFrom: 220,
  priceUnit: 'move',
  priceNotes: 'Tailored pricing based on crate dimensions, quantity of delicate items, and insurance declarations. Fixed quote following video or in-person review.',
  benefits: [
    'Custom-built timber crates constructed to exact sculpture and canvas dimensions with internal foam suspension',
    'Acid-free archival tissue paper, glassine covers, and breathable non-abrasive art blankets',
    'White-cotton-gloved art handlers trained in conservation packing and historic joinery handling',
    'Comprehensive high-value Goods in Transit cover up to £50,000 standard with declared value extensions',
    'Corner edge protectors, shock-absorbent cushioning, and rigid Correx boxing for gilded frames',
    'Coordination with galleries, auction houses, private collectors, and historic residential estates'
  ],
  whatsIncluded: [
    'Condition report documentation with high-resolution photographic cataloguing prior to wrapping',
    'Bespoke packaging using acid-free tissue, archival wrapping, and shock-dampening bubble wraps',
    'Custom timber crate fabrication for delicate marble sculptures, bronze busts, and large canvases',
    'Secure vertical transport in dedicated air-ride suspension vehicles equipped with load-lock rails',
    'White-glove uncrating, unwrapping, and precise placement in your new gallery room or residence',
    'Clean collection and recycling of all specialist crates and protective packaging materials'
  ],
  whatsNotIncluded: [
    'Independent third-party art authentication, restoration work, or formal probate appraisal valuations',
    'Heavy masonry wall drill mounting and museum hanging rail installation (liaison available)',
    'Conservation cleaning of fragile antique textiles or oil varnish surfaces'
  ],
  process: [
    {
      step: 1,
      title: 'Detailed Item Inventory & Condition Assessment',
      description: 'We document dimensions, medium (oil, acrylic, marble, porcelain, antique walnut), fragility points, and prior restorations, generating a clear condition log.'
    },
    {
      step: 2,
      title: 'Bespoke Archival Wrapping & Crating',
      description: 'Each piece is wrapped in acid-free glassine to safeguard varnishes, surrounded with high-density polyfoam, and seated inside custom wooden crates with reinforced corners.'
    },
    {
      step: 3,
      title: 'Vertical Stacking & Secure Vehicle Lashing',
      description: 'Canvases are never laid flat. Artworks are stood on cushioned baseboards and strapped against internal vehicle tracking with padded load bars to eliminate road vibration.'
    },
    {
      step: 4,
      title: 'White-Glove Unpacking & Condition Sign-Off',
      description: 'At destination, we unbox and unwrap each item with cotton gloves, position it according to your curator floorplan, and cross-reference condition notes with you.'
    }
  ],
  premiumAngle: 'For collectors across Hampstead Village, The Bishops Avenue, St John\'s Wood, and Maida Vale, our fine art team provides discreet, unmarked vehicle transport, dual-custody handling protocols, and seamless collaboration with estate managers.',
  faqs: [
    {
      question: 'Why can oil paintings never be wrapped directly in standard plastic bubble wrap?',
      answer: 'Standard plastic bubble wrap traps ambient moisture against the paint film and can imprint circular marks into oil varnish under warm conditions. We first apply an archival layer of acid-free glassine paper or breathable Tyvek before adding secondary cushioned wraps.',
      display: true
    },
    {
      question: 'How do you protect delicate antique marquetry and French-polished veneers?',
      answer: 'French polish is extraordinarily sensitive to friction and moisture. We avoid adhesive tapes completely, wrapping pieces in breathable cotton fleece before securing with outer stretch bands that never touch the wood surface.',
      display: true
    },
    {
      question: 'Can you transport fragile chandeliers, porcelain, and crystal glassware?',
      answer: 'Yes. Glass and crystal items are individually nested in cell-divided cartons with biodegradable void fill, while chandeliers are dismounted, foam-cushioned, and suspended inside bespoke reinforced wooden boxes.',
      display: true
    },
    {
      question: 'Is higher insurance cover available for valuable private collections?',
      answer: 'Yes. While our standard cover includes £50,000 Goods in Transit, we provide bespoke high-value extensions covering individual pieces or comprehensive private collections upon inventory declaration.',
      display: true
    }
  ]
};
---

<ServiceLayout service={serviceData}>
  <div class="prose dark:prose-invert max-w-none space-y-6">
    <h2 class="text-2xl sm:text-3xl font-black text-navy dark:text-pearl tracking-tight">
      Museum-Grade Art & Antique Relocation Across London & Nationwide
    </h2>
    <p>
      Transporting fine art, rare antiques, heirloom ceramics, and delicate sculptures requires a discipline far beyond conventional furniture removals. Every painting possesses unique sensitivities to humidity, surface contact, and kinetic shock. Antique timber furniture constructed with historic hide glue, hand-cut mortise-and-tenon joints, and fragile parquetry cannot tolerate torque, sudden jolts, or moisture entrapment.
    </p>
    <p>
      At <strong>Pearl Removals</strong>, our Cricklewood-based Fine Art & Antiques division caters to private collectors, antique dealers, interior design studios, and discerning homeowners across Hampstead, Highgate, St John's Wood, Marylebone, and Chelsea. We treat every consignment as irreplaceable, combining museum conservation principles with meticulous road transport logistics.
    </p>

    <h3 class="text-xl font-bold text-navy dark:text-pearl pt-4">
      Bespoke Timber Crating & Archival Barrier Materials
    </h3>
    <p>
      Off-the-shelf cardboard cartons are entirely inadequate for delicate framed oils, gilded mirrors, and marble sculptures. Our carpentry workshop crafts bespoke timber crates tailored to exact physical dimensions. Inside each crate, custom Plastazote foam blocks support the frame corners and outer borders, allowing the central canvas or glass panel to float without point-pressure.
    </p>
    <p>
      We use exclusively archival-grade materials. Glassine barrier paper prevents sticking on cured varnishes; DuPont Tyvek shields against moisture ingress while allowing the medium to breathe; and acid-free tissue paper ensures unvarnished gesso and gold leaf finishes remain pristine.
    </p>

    <h3 class="text-xl font-bold text-navy dark:text-pearl pt-4">
      Specialist Vehicle Stowing & Kinetic Shock Reduction
    </h3>
    <p>
      Road vibration during transit across London's cobbled mews, speed cushions, and arterial routes poses a constant threat to framed artworks. Unsecured canvases laid flat can flex under road inertia, causing spiderweb cracking in antique paint layers.
    </p>
    <p>
      Our vehicles are configured with dual-row load tracks and padded shoring beams. Every framed canvas and mirror travels vertically, oriented parallel to the vehicle’s direction of travel on padded carpeted skids. Sculptures and heavy bronzes are base-bolted or anchored using wide, soft-webbing straps to prevent kinetic shifts during braking.
    </p>

    <h3 class="text-xl font-bold text-navy dark:text-pearl pt-4">
      Discreet Service for Prestigious London Residences
    </h3>
    <p>
      Many of our art removal clients reside in private roads and exclusive enclaves throughout North West London, such as Winnington Road, Hamilton Terrace, and Frognal. We operate with absolute discretion, ensuring team members adhere to strict non-disclosure standards, security gate verification, and polite liaison with on-site building managers and concierges.
    </p>
  </div>
</ServiceLayout>
