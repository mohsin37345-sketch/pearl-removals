---
import ServiceLayout from 'theme/layouts/ServiceLayout.astro';

const serviceData = {
  title: 'Piano Removals',
  slug: 'piano-removals',
  metaTitle: 'Piano Removals North West London | Pearl Removals',
  metaDescription: 'Specialist piano removals in North West London. Upright, baby grand & grand pianos moved with heavy-duty piano shoes, hoists & padded transit blankets.',
  heroHeading: 'Expert Piano Removals in North West London',
  heroSubheading: 'Specialist equipment, heavy-duty piano shoes, and seasoned piano movers delivering upright, baby grand, and concert grand pianos safely across London.',
  icon: 'music',
  summary: 'Dedicated piano transport using specialized lifting dollies, padded covers, and stair-climbing techniques for upright and grand pianos.',
  priceFrom: 180,
  priceUnit: 'move',
  priceNotes: 'Indicative guide for local ground-floor upright piano moves. Multi-flight stairs and grand pianos quoted following visual or video survey.',
  benefits: [
    'Specialist piano shoes, heavy-duty skids, and multi-wheel piano dollies suited for up to 500kg instruments',
    'Custom-fitted quilted transit covers and thick insulated blankets securing key lids and delicate timber casework',
    'Experienced 3 to 4 person piano moving crews trained in counter-balanced stair work and threshold navigation',
    'Full £50,000 Goods in Transit insurance cover tailored for valuable acoustic and digital pianos',
    'Floor and door frame protection including heavy rubber stair treads and reinforced threshold ramps',
    'Careful post-move positioning in your new property with advice on humidity and settling before re-tuning'
  ],
  whatsIncluded: [
    'Pre-move access survey evaluating stair width, turning circles, banisters, and exterior steps',
    'Heavy-duty padded piano transit coat strapped securely with tension webbings',
    'Specialist piano shoe attachment for grand piano lyre and leg disassembly',
    'Vehicle transport in air-suspension removal vans fitted with internal tie rails',
    'Placement in your designated room on rubber castor cups or protective timber shims',
    'Comprehensive transit insurance covering internal mechanisms and polished casing'
  ],
  whatsNotIncluded: [
    'Acoustic piano re-tuning (recommended 2 to 3 weeks after move once timber acclimates)',
    'Crane or external hoist hire for upper-floor balcony entries (quoted separately if required)',
    'Internal mechanical restoration, voicing, or action regulation',
    'Council parking bay suspension charges for loading vehicles outside red routes or CPZ bays'
  ],
  process: [
    {
      step: 1,
      title: 'Detailed Access & Instrument Assessment',
      description: 'We review the piano type (upright, baby grand, or concert grand), measure tight stairwells, doorway turns, and exterior steps, and verify weight distribution.'
    },
    {
      step: 2,
      title: 'Protective Padding & Disassembly',
      description: 'For uprights, the lid and pedals are locked and padded in quilted blankets. For grand pianos, legs, lyre, and music desk are removed and packed into padded cases while the body rests on a custom piano shoe.'
    },
    {
      step: 3,
      title: 'Secured Loading & Smooth Transit',
      description: 'Using balanced dollies and ramps, our crew navigates the instrument into our air-cushioned vehicle, locking it against heavy-duty load rails with soft-faced ratchet straps.'
    },
    {
      step: 4,
      title: 'Careful Delivery & Precise Reassembly',
      description: 'Upon arrival, the piano is transported to your designated spot, legs and lyre reassembled, protective floor cups installed, and wrapping removed for your final inspection.'
    }
  ],
  premiumAngle: 'For grand pianos in Hampstead, St John\'s Wood, and Belsize Park residences, our white-glove piano division provides climate-conscious transport, bespoke timber crating for antique rosewood and ebonised cases, and liaison with resident tuning masters.',
  faqs: [
    {
      question: 'Will my piano need tuning immediately after the move?',
      answer: 'We advise waiting 14 to 21 days before hiring a tuner. Acoustic pianos contain thousands of wooden and felt parts under massive string tension that need time to acclimatise to the temperature and humidity of your new home before tuning holds stably.',
      display: true
    },
    {
      question: 'Can you move a grand piano down narrow Victorian staircases?',
      answer: 'Yes. Our crews are trained in grand piano disassembly, resting the piano body securely on its straight side atop a protective piano shoe. We measure banister clearances, door frames, and landing pivots in advance to verify safe transit angles.',
      display: true
    },
    {
      question: 'How do you protect parquet, antique hardwood, and stone floors from piano wheels?',
      answer: 'We never roll a piano on its metal or nylon castors across your flooring. The instrument is transferred directly onto our soft, non-marking rubber pneumatic dollies, and floor runners are laid along the entire transit route.',
      display: true
    },
    {
      question: 'Are digital pianos and stage pianos handled differently than upright acoustics?',
      answer: 'Digital pianos are lighter but feature sensitive electronics, weighted hammer action keys, and delicate veneer stands. We disconnect cabling, disassemble modular stands, and cushion keybeds in bespoke shock-absorbent foam.',
      display: true
    }
  ]
