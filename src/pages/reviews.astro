---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import Testimonials from 'theme/components/Testimonials.astro';
import CTABand from 'theme/components/CTABand.astro';
import { getCollection } from 'astro:content';

let verifiedReviews: any[] = [];
try {
  verifiedReviews = await getCollection('testimonials', ({ data }) => data.verified === true);
} catch {
  verifiedReviews = [];
}

const breadcrumbs = [
  { name: 'Reviews', url: '/reviews/' }
];
---

<BaseLayout
  title="Customer Reviews & Testimonials | Pearl Removals London"
  description="Read verified homeowner feedback for Pearl Removals. Honest reviews from residential moves across Cricklewood, Hampstead, Kilburn, Hendon, and North West London."
  canonicalUrl="https://www.pearlremovals.co.uk/reviews/"
  breadcrumbs={breadcrumbs}
  verifiedReviews={verifiedReviews}
>
  <section class="page-intro">
    <div class="container">
      <div class="page-intro__content">
        <div class="page-intro__eyebrow">
          <span class="eyebrow">GENUINE CUSTOMER FEEDBACK</span>
        </div>
        <h1 class="page-intro__title">
          Customer <span class="mark">Reviews<svg viewBox="0 0 200 20" preserveAspectRatio="none"><path d="M3 15 C 50 4, 140 2, 197 12" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg></span> &amp; Experiences
        </h1>
        <p class="page-intro__lead">
          Verified feedback from homeowners and tenants who have moved with Pearl Removals across North West London.
        </p>
        <div class="page-intro__badges">
          <span class="pill"><span class="stars" style="margin-right:2px"><svg><use href="#i-star"/></svg></span>4.9★ Google Rating</span>
          <span class="pill"><span class="pill__dot"><svg><use href="#i-check"/></svg></span>380+ Verified Moves</span>
          <span class="pill"><span class="pill__dot"><svg><use href="#i-pin"/></svg></span>North West London Base</span>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />

  <Breadcrumbs items={breadcrumbs} />

  <Testimonials reviews={verifiedReviews} />

  <CTABand
    title="Ready for your next stress-free move?"
    description="Join hundreds of happy customers across North West London. Get a transparent, fixed-price quote today."
  />
</BaseLayout>
