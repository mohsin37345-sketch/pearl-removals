---
import Icon from './Icon.astro';

interface Props {
  highlightArea?: string;
}

const { highlightArea } = Astro.props;

// Key initial launch areas to display in pill tags
const keyPillAreas = [
  { name: 'Cricklewood (Base)', slug: 'cricklewood', postcode: 'NW2', isBase: true },
  { name: 'Hampstead', slug: 'hampstead', postcode: 'NW3', premium: true },
  { name: 'Belsize Park', slug: 'belsize-park', postcode: 'NW3', premium: true },
  { name: 'West Hampstead', slug: 'west-hampstead', postcode: 'NW6' },
  { name: 'Kilburn', slug: 'kilburn', postcode: 'NW6' },
  { name: 'Hendon', slug: 'hendon', postcode: 'NW4' },
  { name: 'Golders Green', slug: 'golders-green', postcode: 'NW11' },
  { name: 'Mill Hill', slug: 'mill-hill', postcode: 'NW7', premium: true },
  { name: 'St John\'s Wood', slug: 'st-johns-wood', postcode: 'NW8', premium: true },
  { name: 'Maida Vale', slug: 'maida-vale', postcode: 'W9', premium: true },
  { name: 'Primrose Hill', slug: 'primrose-hill', postcode: 'NW1', premium: true },
  { name: 'Brent Cross', slug: 'brent-cross', postcode: 'NW4' },
  { name: 'Paddington', slug: 'paddington', postcode: 'W2' }
];
---

<section class="py-12 lg:py-16" aria-labelledby="coverage-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="glass-panel p-6 sm:p-10 lg:p-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left: Text & Pill Tags -->
        <div class="lg:col-span-7 space-y-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-royal mb-2 block">Local North West London Territory</span>
            <h2 id="coverage-heading" class="text-3xl sm:text-4xl font-black text-navy dark:text-pearl tracking-tight">
              Areas We Cover Across London
            </h2>
            <p class="text-sm sm:text-base text-surface-600 dark:text-surface-400 mt-2 leading-relaxed">
              Based at Cricklewood NW2, our fleet operates throughout Camden, Brent, Barnet, Westminster, and surrounding boroughs. We manage parking suspensions, CPZs, and building porter liaison daily.
            </p>
          </div>

          <!-- Quick Pill Tags -->
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-surface-500 mb-3">
              Core North West & West London Areas:
            </h3>
            <div class="flex flex-wrap gap-2">
              {keyPillAreas.map((area) => (
                <a
                  href={`/areas/${area.slug}/`}
                  class={`glass-pill px-3.5 py-1.5 rounded-full text-xs font-medium transition-all hover:scale-105 hover:bg-royal hover:text-white flex items-center gap-1.5 ${
                    area.isBase ? 'border-royal/50 text-royal font-bold' : 'text-navy dark:text-pearl'
                  } ${highlightArea === area.slug ? 'ring-2 ring-royal bg-royal/10' : ''}`}
                >
                  <Icon name="map-pin" class="w-3 h-3 text-royal" />
                  <span>{area.name}</span>
                  <span class="text-[10px] opacity-60">({area.postcode})</span>
                  {area.premium && <span class="text-gold text-[10px]">★</span>}
                </a>
              ))}
            </div>
          </div>

          <div class="pt-2 flex flex-wrap items-center gap-4 text-xs font-bold">
            <a href="/areas/" class="text-royal hover:underline inline-flex items-center gap-1">
              Explore All Coverage Areas <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </a>
            <span class="text-surface-300">•</span>
            <a href="/areas/north-west-london/" class="text-navy dark:text-pearl hover:text-royal inline-flex items-center gap-1">
              North West London Hub <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>

        <!-- Right: Stylised Click-to-Load Map Representation -->
        <div class="lg:col-span-5">
          <div class="glass-pill p-4 rounded-3xl relative overflow-hidden bg-gradient-to-br from-royal/5 to-surface-100 dark:from-navy-dark dark:to-navy/80 border border-white/60 dark:border-white/10 shadow-lg">
            
            <div class="relative aspect-square w-full rounded-2xl overflow-hidden flex items-center justify-center">
              <!-- Stylised SVG Map of NW London Radial Coverage -->
              <svg viewBox="0 0 300 300" class="w-full h-full" xmlns="http://www.w3.org/2000/svg" aria-label="Pearl Removals North West London Service Area Map">
                <!-- Outer Range Circle (10 miles) -->
                <circle cx="150" cy="150" r="130" fill="none" stroke="#1F5BFF" stroke-width="1" stroke-dasharray="4 4" opacity="0.3" />
                <!-- Middle Range Circle (5 miles) -->
                <circle cx="150" cy="150" r="85" fill="#1F5BFF" fill-opacity="0.05" stroke="#1F5BFF" stroke-width="1.5" stroke-dasharray="2 2" opacity="0.5" />
                <!-- Inner Core Circle (3 miles) -->
                <circle cx="150" cy="150" r="45" fill="#1F5BFF" fill-opacity="0.1" stroke="#1F5BFF" stroke-width="1.5" />

                <!-- Road Arteries (M1, A406 North Circular, A5 Edgware Rd, A41 Hendon Way) -->
                <!-- A406 North Circular -->
                <path d="M 30 110 Q 150 90 270 120" fill="none" stroke="#64748B" stroke-width="2.5" opacity="0.6" />
                <text x="50" y="105" font-family="sans-serif" font-size="7" fill="#64748B" font-weight="bold">A406 NORTH CIRCULAR</text>

                <!-- M1 Motorway -->
                <line x1="140" y1="130" x2="110" y2="30" stroke="#0F1E3D" stroke-width="3" opacity="0.7" />
                <text x="100" y="45" font-family="sans-serif" font-size="7" fill="#0F1E3D" font-weight="bold">M1</text>

                <!-- A5 Edgware Road / Cricklewood Broadway -->
                <line x1="90" y1="260" x2="150" y2="150" stroke="#1F5BFF" stroke-width="2" opacity="0.8" />
                <line x1="150" y1="150" x2="200" y2="60" stroke="#1F5BFF" stroke-width="2" opacity="0.8" />
                <text x="80" y="240" font-family="sans-serif" font-size="7" fill="#1F5BFF" font-weight="bold">A5 / EDGWARE RD</text>

                <!-- A41 Hendon Way -->
                <path d="M 210 260 L 150 150 L 180 40" fill="none" stroke="#64748B" stroke-width="2" opacity="0.6" />
                <text x="180" y="240" font-family="sans-serif" font-size="7" fill="#64748B" font-weight="bold">A41</text>

                <!-- Nearby Landmarks Pins -->
                <!-- Hampstead / Heath -->
                <circle cx="195" cy="140" r="4" fill="#5A8F62" />
                <text x="202" y="143" font-family="sans-serif" font-size="8" fill="#1F2937" font-weight="bold" class="dark:fill-white">Hampstead</text>

                <!-- Kilburn -->
                <circle cx="135" cy="180" r="3" fill="#64748B" />
                <text x="95" y="183" font-family="sans-serif" font-size="7" fill="#1F2937" font-weight="bold" class="dark:fill-white">Kilburn</text>

                <!-- Hendon -->
                <circle cx="160" cy="100" r="3" fill="#64748B" />
                <text x="168" y="103" font-family="sans-serif" font-size="7" fill="#1F2937" font-weight="bold" class="dark:fill-white">Hendon</text>

                <!-- Mill Hill -->
                <circle cx="140" cy="65" r="3" fill="#64748B" />
                <text x="146" y="68" font-family="sans-serif" font-size="7" fill="#1F2937" font-weight="bold" class="dark:fill-white">Mill Hill</text>

                <!-- Maida Vale / Paddington -->
                <circle cx="165" cy="220" r="3" fill="#64748B" />
                <text x="172" y="223" font-family="sans-serif" font-size="7" fill="#1F2937" font-weight="bold" class="dark:fill-white">Maida Vale</text>

                <!-- CRICKLEWOOD BASE (Center Pin) -->
                <g transform="translate(150, 150)">
                  <circle cx="0" cy="0" r="12" fill="#1F5BFF" fill-opacity="0.2" class="animate-ping" />
                  <circle cx="0" cy="0" r="6" fill="#1F5BFF" />
                  <circle cx="0" cy="0" r="2.5" fill="#FFFFFF" />
                  
                  <!-- Label Badge -->
                  <rect x="-48" y="-24" width="96" height="16" rx="4" fill="#0F1E3D" />
                  <text x="0" y="-13" font-family="sans-serif" font-size="7" font-weight="900" fill="#FFFFFF" text-anchor="middle">CRICKLEWOOD NW2</text>
                  <!-- Pointer Triangle -->
                  <polygon points="-4,-8 4,-8 0,-4" fill="#0F1E3D" />
                </g>
              </svg>

              <!-- Safe, Static Fallback / Click to Load note -->
              <div class="absolute bottom-2 inset-x-2 text-center text-[10px] text-surface-500 font-medium bg-white/70 dark:bg-navy/80 py-1 rounded-md backdrop-blur-xs">
                Cricklewood Base • Rapid Dispatch Across NW Postcodes
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>
</section>
