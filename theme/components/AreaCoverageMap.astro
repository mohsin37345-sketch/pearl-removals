---
interface PinArea {
  name: string;
  left: string;
  top: string;
}

interface ChipArea {
  name: string;
  url: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  pinnedAreas?: PinArea[];
  chipAreas?: ChipArea[];
}

const defaultPins: PinArea[] = [
  { name: "Harrow", left: "14%", top: "22%" },
  { name: "Barnet", left: "60%", top: "16%" },
  { name: "Hendon", left: "70%", top: "46%" },
  { name: "Wembley", left: "10%", top: "58%" },
  { name: "Kilburn", left: "55%", top: "74%" },
  { name: "Ealing", left: "22%", top: "80%" }
];

const defaultChips: ChipArea[] = [
  { name: "Cricklewood (Hub NW2)", url: "/areas/cricklewood/" },
  { name: "Hampstead (NW3)", url: "/areas/hampstead/" },
  { name: "Belsize Park (NW3)", url: "/areas/belsize-park/" },
  { name: "West Hampstead (NW6)", url: "/areas/west-hampstead/" },
  { name: "Kilburn (NW6)", url: "/areas/kilburn/" },
  { name: "Hendon (NW4)", url: "/areas/hendon/" },
  { name: "Golders Green (NW11)", url: "/areas/golders-green/" },
  { name: "Mill Hill (NW7)", url: "/areas/mill-hill/" },
  { name: "St John's Wood (NW8)", url: "/areas/st-johns-wood/" },
  { name: "Maida Vale (W9)", url: "/areas/maida-vale/" },
  { name: "Harrow (HA1)", url: "/areas/harrow/" },
  { name: "Wembley (HA9)", url: "/areas/wembley/" },
  { name: "Barnet (EN5)", url: "/areas/barnet/" },
  { name: "Ealing (W5)", url: "/areas/ealing/" },
  { name: "Chiswick (W4)", url: "/areas/chiswick/" },
  { name: "Kensington (W8)", url: "/areas/kensington/" },
  { name: "Chelsea (SW3)", url: "/areas/chelsea/" },
  { name: "Camden Town (NW1)", url: "/areas/camden-town/" },
  { name: "Highgate (N6)", url: "/areas/highgate/" },
  { name: "Muswell Hill (N10)", url: "/areas/muswell-hill/" },
  { name: "Edgware (HA8)", url: "/areas/edgware-and-burnt-oak/" },
  { name: "Stanmore (HA7)", url: "/areas/stanmore/" },
  { name: "Pinner (HA5)", url: "/areas/pinner/" },
  { name: "Finchley (N3)", url: "/areas/finchley/" }
];

const {
  eyebrow = "Local Coverage • Cricklewood NW2 Base",
  title = "Areas We Cover Across North West London & Beyond",
  description = "Operating from our central transport hub at Cricklewood NW2, Pearl Removals delivers white-glove house, flat, and commercial moves across Camden, Brent, Barnet, Westminster, and the wider capital. Daily handling of CPZ parking suspensions and building porter access.",
  pinnedAreas = defaultPins,
  chipAreas = defaultChips
} = Astro.props;
---

<section class="section" id="areas">
  <div class="container areas">
    <div class="areas__map reveal" aria-hidden="true">
      <span class="areas__ring areas__ring--3"></span>
      <span class="areas__ring areas__ring--2"></span>
      <span class="areas__ring areas__ring--1"></span>
      <span class="areas__pin">
        <svg><use href="#i-pin-solid"/></svg>
      </span>
      <span class="areas__label" style="left:50%;top:50%;translate:-50% -180%;background:var(--ink);color:#fff;font-weight:800;border:1px solid var(--accent);white-space:nowrap;padding:4px 8px;border-radius:6px;font-size:11px;z-index:4;">
        CRICKLEWOOD NW2 (BASE)
      </span>
      {pinnedAreas.map((pin) => (
        <span class="areas__label" style={`left:${pin.left};top:${pin.top}`}>{pin.name}</span>
      ))}
    </div>
    <div class="reveal">
      <span class="eyebrow">{eyebrow}</span>
      <div class="section-head" style="margin-bottom:0">
        <h2>{title}</h2>
        <p>{description}</p>
      </div>
      <form class="postcode-check" id="postcodeForm">
        <input type="text" placeholder="Enter your postcode, e.g. HA1 or NW3" aria-label="Your postcode" required />
        <button class="btn btn--sm" type="submit">Check area</button>
      </form>
      <div class="postcode-check__result" id="postcodeResult" aria-live="polite"></div>
      <div class="chips">
        {chipAreas.map((chip) => (
          <a class="chip" href={chip.url}>
            <svg><use href="#i-pin"/></svg>{chip.name}
          </a>
        ))}
        <a class="chip" href="/areas/" style="background: var(--accent); color: #fff; border-color: var(--accent); font-weight: 700;">
          <svg style="color: #fff;"><use href="#i-arrow"/></svg>View all 50+ areas
        </a>
      </div>
    </div>
  </div>
</section>
