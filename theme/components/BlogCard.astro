---
import { formatDate } from 'theme/utils/formatDate';
import Icon from './Icon.astro';

interface Props {
  title: string;
  slug: string;
  description: string;
  date: Date | string;
  category: string;
  readTime?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title,
  slug,
  description,
  date,
  category,
  readTime = "4 min read",
  image = "/images/blog-default.jpg",
  imageAlt = "Pearl Removals Moving Guide"
} = Astro.props;
---

<article class="glass-panel rounded-3xl overflow-hidden group hover:-translate-y-1 hover:shadow-xl transition-all duration-200 flex flex-col justify-between">
  <div>
    <!-- 16:9 Image Container -->
    <div class="relative aspect-video w-full overflow-hidden bg-surface-200 dark:bg-navy">
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent z-10"></div>
      <span class="absolute top-3 left-3 z-20 px-3 py-1 rounded-full text-[11px] font-bold bg-white/90 dark:bg-navy/90 text-royal backdrop-blur-sm">
        {category}
      </span>
      <div class="w-full h-full flex items-center justify-center text-surface-400 group-hover:scale-105 transition-transform duration-300">
        <Icon name="truck" class="w-12 h-12 opacity-30 text-royal" />
      </div>
    </div>

    <!-- Body -->
    <div class="p-6">
      <div class="flex items-center gap-3 text-xs text-surface-400 mb-2">
        <time datetime={new Date(date).toISOString().split('T')[0]}>
          {formatDate(date)}
        </time>
        <span>•</span>
        <span>{readTime}</span>
      </div>

      <h3 class="font-bold text-lg text-navy dark:text-pearl tracking-tight group-hover:text-royal transition-colors mb-2 line-clamp-2">
        <a href={`/blog/${slug}/`} class="focus:outline-none focus:underline">
          {title}
        </a>
      </h3>

      <p class="text-xs sm:text-sm text-surface-600 dark:text-surface-300 leading-relaxed line-clamp-3">
        {description}
      </p>
    </div>
  </div>

  <div class="px-6 pb-6 pt-2">
    <a
      href={`/blog/${slug}/`}
      class="text-xs font-bold text-royal dark:text-royal-light flex items-center gap-1.5 group-hover:translate-x-1 transition-transform"
    >
      <span>Read Full Guide</span>
      <Icon name="arrow-right" class="w-3.5 h-3.5" />
    </a>
  </div>
</article>
