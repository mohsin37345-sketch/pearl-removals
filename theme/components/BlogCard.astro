---
import { formatDate, formatDateIso } from 'theme/utils/formatDate';

interface Props {
  title: string;
  slug: string;
  description: string;
  date: Date | string;
  category: string;
  readTime?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title,
  slug,
  description,
  date,
  category,
  readTime = "4 min read"
} = Astro.props;

const isoDate = formatDateIso(date) || new Date().toISOString().split('T')[0];
---

<article style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--shadow-sm); transition: transform .2s, box-shadow .2s;">
  <div style="padding: 24px;">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 14px;">
      <span class="pill" style="font-size: 11px; padding: 4px 10px; background: var(--sky); color: var(--sky-strong); font-weight: 700;">
        {category}
      </span>
      <div style="font-size: 12px; color: var(--muted); display: flex; align-items: center; gap: 6px;">
        <time datetime={isoDate}>{formatDate(date)}</time>
        <span>•</span>
        <span>{readTime}</span>
      </div>
    </div>

    <h3 style="font-size: 18px; font-weight: 700; color: var(--ink); margin-bottom: 10px; line-height: 1.35;">
      <a href={`/blog/${slug}/`} style="color: inherit; text-decoration: none;">
        {title}
      </a>
    </h3>

    <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
      {description}
    </p>
  </div>

  <div style="padding: 16px 24px; border-top: 1px solid var(--line); background: var(--pearl);">
    <a
      href={`/blog/${slug}/`}
      class="btn btn--ghost btn--sm"
      style="padding: 0; background: none; border: none; font-weight: 700; font-size: 13px; color: var(--accent);"
    >
      Read full guide <svg class="arrow"><use href="#i-arrow"/></svg>
    </a>
  </div>
</article>
