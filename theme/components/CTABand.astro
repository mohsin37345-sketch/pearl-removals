---
import { siteConfig } from 'src/data/site';

interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  areaName?: string;
  primaryCtaText?: string;
  primaryCtaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
  marginTop?: boolean;
}

const {
  title,
  subtitle,
  description,
  areaName,
  primaryCtaText = "Get my free quote",
  primaryCtaLink = "/get-a-quote/",
  secondaryCtaText = siteConfig.phone,
  secondaryCtaLink = `tel:${siteConfig.phoneE164}`,
  marginTop = true
} = Astro.props;

const effectiveTitle = title || (areaName ? `Moving to or from ${areaName}?` : "Ready to move? Let's get you a price.");
const effectiveDesc = subtitle || description || "Free, fixed quotes in 60 seconds. No obligation and no hidden fees — just a smoother move day.";
---

<section class="container" style={marginTop ? "margin-top: var(--section-y);" : ""}>
  <div class="cta-band reveal">
    <div>
      <h2>{effectiveTitle}</h2>
      <p>{effectiveDesc}</p>
    </div>
    <div class="cta-band__actions">
      <a href={primaryCtaLink} class="btn btn--light">
        {primaryCtaText} <svg class="arrow"><use href="#i-arrow"/></svg>
      </a>
      <a href={secondaryCtaLink} class="btn btn--outline-light">
        <svg><use href="#i-phone"/></svg> {secondaryCtaText}
      </a>
    </div>
  </div>
</section>
