---
interface ComparisonRow {
  feature: string;
  pearl: boolean | string;
  standard: boolean | string;
}

const rows: ComparisonRow[] = [
  {
    feature: "Written Fixed-Price Quotation (No Hidden Day-Of Surprises)",
    pearl: true,
    standard: "Rarely (Often variable hourly meter)"
  },
  {
    feature: "Goods In Transit Insurance (£50,000 Level Included)",
    pearl: true,
    standard: "Limited or customer risk"
  },
  {
    feature: "£5,000,000 Public Liability Insurance",
    pearl: true,
    standard: false
  },
  {
    feature: "Padded Transit Blankets, Sofa & Mattress Covers Standard",
    pearl: true,
    standard: false
  },
  {
    feature: "Camden, Brent & Barnet CPZ Parking Suspension Guidance",
    pearl: true,
    standard: false
  },
  {
    feature: "Uniformed, Experienced Moving Crew",
    pearl: true,
    standard: "Variable / Casual"
  },
  {
    feature: "Full Furniture Dismantling & Reassembly Service",
    pearl: true,
    standard: "Extra / DIY"
  },
  {
    feature: "Completion Day Key Delay Grace Window",
    pearl: true,
    standard: "Heavy punitive hourly charges"
  }
];
---

<div style="overflow-x: auto; margin-top: 32px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); box-shadow: var(--shadow-sm);">
  <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14.5px;">
    <thead>
      <tr style="border-bottom: 1px solid var(--line); background: var(--pearl);">
        <th scope="col" style="padding: 18px 24px; font-weight: 700; color: var(--ink); width: 50%;">Standard Moving Feature</th>
        <th scope="col" style="padding: 18px 24px; font-weight: 800; color: var(--ink); text-align: center; background: rgba(255, 106, 43, 0.08); width: 25%;">
          <div style="font-size: 15px; letter-spacing: -0.01em;">PEARL REMOVALS</div>
          <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent); margin-top: 2px;">Premium Standard</div>
        </th>
        <th scope="col" style="padding: 18px 24px; font-weight: 600; color: var(--muted); text-align: center; width: 25%;">
          <div style="font-size: 14px;">Casual Van Driver</div>
          <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin-top: 2px;">Unregulated</div>
        </th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr style="border-bottom: 1px solid var(--line);">
          <td style="padding: 16px 24px; font-weight: 600; color: var(--ink);">
            {row.feature}
          </td>
          
          <!-- Pearl Removals Value -->
          <td style="padding: 16px 24px; text-align: center; background: rgba(255, 106, 43, 0.04);">
            {typeof row.pearl === 'boolean' ? (
              row.pearl ? (
                <span class="icon-tile" style="width: 28px; height: 28px; border-radius: 50%; background: #e6f9ee; color: var(--mint); display: inline-flex; align-items: center; justify-content: center; margin: 0 auto;">
                  <svg style="width: 16px; height: 16px;"><use href="#i-check"/></svg>
                </span>
              ) : (
                <span class="icon-tile" style="width: 28px; height: 28px; border-radius: 50%; background: #fee2e2; color: #dc2626; display: inline-flex; align-items: center; justify-content: center; margin: 0 auto;">
                  <svg style="width: 16px; height: 16px;"><use href="#i-x"/></svg>
                </span>
              )
            ) : (
              <strong style="color: var(--ink); font-size: 13.5px;">{row.pearl}</strong>
            )}
          </td>

          <!-- Standard Competitor Value -->
          <td style="padding: 16px 24px; text-align: center; font-size: 13px; color: var(--muted);">
            {typeof row.standard === 'boolean' ? (
              row.standard ? (
                <span class="icon-tile" style="width: 26px; height: 26px; border-radius: 50%; background: #e2e8f0; color: #475569; display: inline-flex; align-items: center; justify-content: center; margin: 0 auto;">
                  <svg style="width: 14px; height: 14px;"><use href="#i-check"/></svg>
                </span>
              ) : (
                <span class="icon-tile" style="width: 26px; height: 26px; border-radius: 50%; background: #fee2e2; color: #ef4444; display: inline-flex; align-items: center; justify-content: center; margin: 0 auto;">
                  <svg style="width: 14px; height: 14px;"><use href="#i-x"/></svg>
                </span>
              )
            ) : (
              <span>{row.standard}</span>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
