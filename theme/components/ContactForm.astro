---
import { siteConfig } from 'src/data/site';

const accessKey = import.meta.env.WEB3FORMS_ACCESS_KEY || 'YOUR_ACCESS_KEY_HERE';
---

<div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); padding: clamp(24px, 4vw, 40px); box-shadow: var(--shadow-md); max-width: 600px; margin-inline: auto;">
  <form id="contact-form" novalidate style="display: flex; flex-direction: column; gap: 16px;">
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="Contact Enquiry - Pearl Removals Website" />
    <input type="hidden" name="from_name" value="Pearl Removals Website Contact" />
    <!-- Honeypot -->
    <input type="checkbox" name="botcheck" class="visually-hidden" style="display:none;" />

    <div>
      <label for="contact-name" style="display: block; font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">
        Your Name *
      </label>
      <input
        type="text"
        id="contact-name"
        name="name"
        placeholder="e.g. John Smith"
        required
        style="width: 100%; height: 50px; padding: 0 16px; border-radius: 12px; border: 1.5px solid var(--line); background: var(--surface); font-size: 15px;"
      />
    </div>

    <div>
      <label for="contact-email" style="display: block; font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">
        Email Address *
      </label>
      <input
        type="email"
        id="contact-email"
        name="email"
        placeholder="e.g. john@example.co.uk"
        required
        style="width: 100%; height: 50px; padding: 0 16px; border-radius: 12px; border: 1.5px solid var(--line); background: var(--surface); font-size: 15px;"
      />
    </div>

    <div>
      <label for="contact-phone" style="display: block; font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">
        Phone Number
      </label>
      <input
        type="tel"
        id="contact-phone"
        name="phone"
        placeholder="e.g. 020 3151 8452"
        style="width: 100%; height: 50px; padding: 0 16px; border-radius: 12px; border: 1.5px solid var(--line); background: var(--surface); font-size: 15px;"
      />
    </div>

    <div>
      <label for="contact-message" style="display: block; font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">
        Your Message / Move Details *
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="4"
        placeholder="Tell us about your move, addresses, dates, or specific questions..."
        required
        style="width: 100%; padding: 14px 16px; border-radius: 12px; border: 1.5px solid var(--line); background: var(--surface); font-size: 15px; font-family: inherit; resize: vertical;"
      ></textarea>
    </div>

    <!-- Status message feedback area -->
    <div id="contact-status" style="display: none; padding: 12px 16px; border-radius: 10px; font-size: 14px; font-weight: 500;" role="alert"></div>

    <button
      type="submit"
      id="contact-submit-btn"
      class="btn btn--accent btn--block"
    >
      <span>Send Message</span>
      <svg class="arrow"><use href="#i-arrow"/></svg>
    </button>
  </form>

  <div style="margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--line); text-align: center; font-size: 14px; color: var(--muted);">
    Prefer direct email? Reach our team directly at: 
    <a href={`mailto:${siteConfig.email}`} style="color: var(--accent); font-weight: 600; margin-left: 4px;">
      {siteConfig.email}
    </a>
  </div>
</div>

<script is:inline>
  (function() {
    const form = document.getElementById('contact-form');
    const statusBox = document.getElementById('contact-status');
    const submitBtn = document.getElementById('contact-submit-btn');

    if (!form || !statusBox || !submitBtn) return;

    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerText = 'Sending enquiry, please wait...';
      statusBox.style.display = 'block';
      statusBox.style.background = 'var(--accent-soft)';
      statusBox.style.color = 'var(--accent-dark)';
      statusBox.textContent = 'Sending enquiry, please wait...';

      const formData = new FormData(form);
      const json = JSON.stringify(Object.fromEntries(formData));

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: json
        });

        const result = await response.json();

        if (response.status === 200 && result.success) {
          statusBox.style.background = '#e9f8f0';
          statusBox.style.color = 'var(--mint)';
          statusBox.textContent = 'Thank you! Your enquiry has been received. Redirecting...';
          setTimeout(() => {
            window.location.href = '/thank-you/';
          }, 1200);
        } else {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Send Message';
          statusBox.style.background = '#ffebee';
          statusBox.style.color = '#c62828';
          statusBox.textContent = result.message || 'Sorry, there was an issue submitting your form. Please email us directly.';
        }
      } catch (err) {
        submitBtn.disabled = false;
        submitBtn.innerText = 'Send Message';
        statusBox.style.background = '#fff8e1';
        statusBox.style.color = '#f57f17';
        statusBox.textContent = 'Network connection error. Please call us directly or email us.';
      }
    });
  })();
</script>
