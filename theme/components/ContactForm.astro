---
import { siteConfig } from 'src/data/site';
import Icon from './Icon.astro';

const accessKey = import.meta.env.WEB3FORMS_ACCESS_KEY || 'YOUR_ACCESS_KEY_HERE';
---

<div class="glass-panel p-6 sm:p-8 rounded-3xl shadow-xl max-w-xl mx-auto w-full border border-white/80 dark:border-white/10">
  <form id="contact-form" class="space-y-4" novalidate>
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="Contact Enquiry - Pearl Removals Website" />
    <input type="hidden" name="from_name" value="Pearl Removals Website Contact" />
    <!-- Honeypot -->
    <input type="checkbox" name="botcheck" class="hidden" style="display:none;" />

    <div>
      <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-navy dark:text-pearl mb-1.5">
        Your Name *
      </label>
      <input
        type="text"
        id="contact-name"
        name="name"
        placeholder="e.g. John Smith"
        required
        class="w-full px-4 py-3 rounded-2xl bg-white/70 dark:bg-white/10 border border-surface-200 dark:border-white/10 text-sm text-navy dark:text-pearl placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-royal"
      />
    </div>

    <div>
      <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-navy dark:text-pearl mb-1.5">
        Email Address *
      </label>
      <input
        type="email"
        id="contact-email"
        name="email"
        placeholder="e.g. john@example.co.uk"
        required
        class="w-full px-4 py-3 rounded-2xl bg-white/70 dark:bg-white/10 border border-surface-200 dark:border-white/10 text-sm text-navy dark:text-pearl placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-royal"
      />
    </div>

    <div>
      <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-navy dark:text-pearl mb-1.5">
        Your Message / Details *
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="4"
        placeholder="Tell us about your move, addresses, dates, or specific questions..."
        required
        class="w-full px-4 py-3 rounded-2xl bg-white/70 dark:bg-white/10 border border-surface-200 dark:border-white/10 text-sm text-navy dark:text-pearl placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-royal resize-y"
      ></textarea>
    </div>

    <!-- Status message feedback area -->
    <div id="contact-status" class="hidden p-3 rounded-xl text-xs font-semibold" role="alert"></div>

    <button
      type="submit"
      id="contact-submit-btn"
      class="w-full py-3.5 px-6 rounded-full bg-royal hover:bg-royal-hover text-white font-bold text-sm tracking-wide shadow-md shadow-royal/20 transition-all flex items-center justify-center gap-2 active:scale-[0.99] disabled:opacity-50 disabled:cursor-not-allowed"
    >
      <span>Send Message</span>
      <Icon name="arrow-right" class="w-4 h-4" />
    </button>
  </form>

  <!-- Fallback direct mailto link per spec -->
  <div class="mt-6 pt-4 border-t border-surface-200 dark:border-white/10 text-center">
    <p class="text-xs text-surface-500">
      Prefer direct email? Reach our desk directly at: 
      <a href={`mailto:${siteConfig.email}`} class="text-royal font-bold hover:underline block sm:inline mt-0.5 sm:mt-0">
        {siteConfig.email}
      </a>
    </p>
  </div>
</div>

<script is:inline>
  // Contact Form Async Handler with 4 distinct states
  (function() {
    const form = document.getElementById('contact-form');
    const statusBox = document.getElementById('contact-status');
    const submitBtn = document.getElementById('contact-submit-btn');

    if (!form || !statusBox || !submitBtn) return;

    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      // State 1: Sending
      submitBtn.disabled = true;
      submitBtn.innerText = 'Sending enquiry, please wait...';
      statusBox.className = 'p-3 rounded-xl text-xs font-semibold bg-blue-50 text-blue-800 dark:bg-blue-900/30 dark:text-blue-200 block';
      statusBox.textContent = 'Sending enquiry, please wait...';

      const formData = new FormData(form);
      const json = JSON.stringify(Object.fromEntries(formData));

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: json
        });

        const result = await response.json();

        if (response.status === 200 && result.success) {
          // State 2: Success
          statusBox.className = 'p-3 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-200 block';
          statusBox.textContent = 'Thank you! Your enquiry has been received. Redirecting to confirmation page...';
          setTimeout(() => {
            window.location.href = '/thank-you/';
          }, 1200);
        } else {
          // State 3: API Error
          submitBtn.disabled = false;
          submitBtn.innerText = 'Send Message';
          statusBox.className = 'p-3 rounded-xl text-xs font-semibold bg-rose-50 text-rose-800 dark:bg-rose-900/30 dark:text-rose-200 block';
          statusBox.textContent = result.message || 'Sorry, there was an issue submitting your form. Please email us directly at info@pearlremovals.co.uk.';
        }
      } catch (err) {
        // State 4: Network Error
        submitBtn.disabled = false;
        submitBtn.innerText = 'Send Message';
        statusBox.className = 'p-3 rounded-xl text-xs font-semibold bg-amber-50 text-amber-800 dark:bg-amber-900/30 dark:text-amber-200 block';
        statusBox.textContent = 'Network connection error. Please call us directly or message us on WhatsApp.';
      }
    });
  })();
</script>
