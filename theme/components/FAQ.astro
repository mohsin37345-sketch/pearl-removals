---
import Icon from './Icon.astro';

interface FaqItem {
  question: string;
  answer: string;
  display?: boolean;
}

interface Props {
  title?: string;
  subtitle?: string;
  items: FaqItem[];
  class?: string;
}

const {
  title = "Frequently Asked Questions",
  subtitle = "Clear, honest answers to common queries regarding house moves in North West London.",
  items = [],
  class: className = ""
} = Astro.props;

// Filter out any items with display === false
const visibleFaqs = items.filter((f) => f.display !== false);
---

{visibleFaqs.length > 0 && (
  <section class={`py-12 lg:py-16 ${className}`} aria-labelledby="faq-section-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-bold uppercase tracking-widest text-royal mb-2 block">Clear Answers</span>
        <h2 id="faq-section-heading" class="text-3xl sm:text-4xl font-black text-navy dark:text-pearl tracking-tight">
          {title}
        </h2>
        {subtitle && (
          <p class="text-sm sm:text-base text-surface-600 dark:text-surface-400 mt-2">
            {subtitle}
          </p>
        )}
      </div>

      <div class="space-y-4">
        {visibleFaqs.map((faq, idx) => (
          <details class="group glass-panel rounded-2xl overflow-hidden transition-all duration-200 open:bg-white/90 dark:open:bg-navy/90">
            <summary class="list-none flex items-center justify-between p-5 cursor-pointer text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-royal rounded-2xl select-none">
              <span class="font-bold text-sm sm:text-base text-navy dark:text-pearl group-hover:text-royal transition-colors pr-4">
                {faq.question}
              </span>
              <span class="w-8 h-8 rounded-full bg-surface-100 dark:bg-white/10 flex items-center justify-center text-royal flex-shrink-0 transition-transform duration-200 group-open:rotate-180">
                <Icon name="chevron-down" class="w-4 h-4" />
              </span>
            </summary>

            <div class="px-5 pb-5 pt-1 text-sm text-surface-600 dark:text-surface-300 leading-relaxed border-t border-surface-200/40 dark:border-white/5">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
