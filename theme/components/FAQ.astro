---
import { siteConfig } from 'src/data/site';

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  contactTitle?: string;
  contactText?: string;
  items?: FAQItem[];
}

const defaultFaqs: FAQItem[] = [
  {
    question: "How much does a house removal cost?",
    answer: "Most local 1–3 bedroom moves cost between £299 and £899. We give you a fixed, all-inclusive price up front based on volume, distance and access — so the price never changes on the day."
  },
  {
    question: "How far in advance should I book?",
    answer: "2–3 weeks is ideal, especially for Fridays and month-ends. We often have last-minute availability too — call us and we'll do our best."
  },
  {
    question: "Are my belongings insured?",
    answer: "Yes. Every move includes goods-in-transit cover up to £50,000 and public liability insurance as standard."
  },
  {
    question: "Do you provide boxes and packing materials?",
    answer: "We do. Choose a full packing service, or we can deliver boxes, tape and bubble wrap ahead of your move day."
  },
  {
    question: "Do you dismantle and reassemble furniture?",
    answer: "Yes — beds, wardrobes, tables and more are dismantled, wrapped and reassembled at your new home at no extra cost on our House Move plan."
  }
];

const {
  eyebrow = "FAQs",
  title = "Questions? We've got answers.",
  contactTitle = "Still unsure?",
  contactText = "Speak to a real person — usually answered in under 30 seconds.",
  items = defaultFaqs
} = Astro.props;

const faqList = items && items.length > 0 ? items : defaultFaqs;
---

<section class="section" id="faq">
  <div class="container faq">
    <div class="faq__aside reveal">
      <span class="eyebrow">{eyebrow}</span>
      <div class="section-head" style="margin-bottom:0">
        <h2>{title}</h2>
      </div>
      <div class="faq__contact">
        <h4>{contactTitle}</h4>
        <p>{contactText}</p>
        <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 16px;">
          <a href={`tel:${siteConfig.phoneE164}`} class="btn btn--accent btn--sm">
            <svg><use href="#i-phone"/></svg> {siteConfig.phone}
          </a>
          <a href="/faqs/" class="btn btn--ghost btn--sm">
            View all moving FAQs <svg class="arrow"><use href="#i-arrow"/></svg>
          </a>
        </div>
      </div>
    </div>
    <div class="accordion reveal">
      {faqList.map((faq, idx) => (
        <details open={idx === 0}>
          <summary>
            {faq.question}
            <span class="accordion__icon"><svg><use href="#i-plus"/></svg></span>
          </summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
