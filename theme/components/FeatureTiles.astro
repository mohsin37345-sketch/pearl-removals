---
import Icon from './Icon.astro';

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const features = [
  {
    title: "Local & Long Distance",
    desc: "NW London to UK-wide",
    icon: "home"
  },
  {
    title: "Safe & Secure Handling",
    desc: "Blankets & covers standard",
    icon: "box"
  },
  {
    title: "Fully Insured Removals",
    desc: "£50k GIT / £5M Liability",
    icon: "shield-check"
  },
  {
    title: "Experienced Team",
    desc: "Trained, punctual movers",
    icon: "users"
  }
];
---

<div class={`grid grid-cols-2 sm:grid-cols-4 gap-3 ${className}`}>
  {features.map((item) => (
    <div class="glass-pill p-3.5 rounded-2xl flex flex-col items-center sm:items-start text-center sm:text-left hover:scale-[1.02] transition-transform">
      <div class="w-8 h-8 rounded-xl bg-royal/10 dark:bg-royal/20 flex items-center justify-center text-royal dark:text-royal-light mb-2">
        <Icon name={item.icon} class="w-4 h-4" />
      </div>
      <h3 class="font-bold text-xs text-navy dark:text-pearl tracking-tight leading-snug">
        {item.title}
      </h3>
      <p class="text-[11px] text-surface-500 dark:text-surface-400 mt-0.5 hidden sm:block">
        {item.desc}
      </p>
    </div>
  ))}
</div>
