---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const features = [
  {
    title: "Local & Long Distance",
    desc: "NW London to UK-wide",
    icon: "home"
  },
  {
    title: "Safe & Secure Handling",
    desc: "Blankets & covers standard",
    icon: "box"
  },
  {
    title: "Fully Insured Removals",
    desc: "£50k GIT / £5M Liability",
    icon: "shield"
  },
  {
    title: "Experienced Team",
    desc: "Trained, punctual movers",
    icon: "users"
  }
];
---

<div class={`grid grid-cols-2 sm:grid-cols-4 gap-3 ${className}`}>
  {features.map((item) => (
    <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); padding: 16px; display: flex; flex-direction: column; gap: 8px;">
      <span class="icon-tile" style="width: 36px; height: 36px; border-radius: 10px;">
        <svg style="width: 18px; height: 18px;"><use href={`#i-${item.icon}`}/></svg>
      </span>
      <h3 style="font-family: var(--font-display); font-size: 14px; font-weight: 700; color: var(--ink); margin: 0;">
        {item.title}
      </h3>
      <p style="font-size: 12px; color: var(--muted); margin: 0;">
        {item.desc}
      </p>
    </div>
  ))}
</div>
