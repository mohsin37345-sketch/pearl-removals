---
import { siteConfig } from 'src/data/site';
import BlogCard from './BlogCard.astro';

interface Props {
  posts?: any[];
}

const { posts = [] } = Astro.props;
---

<section class="section section--white" id="blog" aria-labelledby="featured-posts-heading">
  <div class="container">
    <div class="section-head section-head--split reveal">
      <div>
        <span class="eyebrow">Knowledge &amp; Moving Tips</span>
        <h2 id="featured-posts-heading">North West London Moving Advice</h2>
        <p>Essential guides on council parking suspensions, completion day schedules, and packing advice.</p>
      </div>
      <a href="/blog/" class="btn btn--ghost">
        View all articles <svg class="arrow"><use href="#i-arrow"/></svg>
      </a>
    </div>

    {posts && posts.length > 0 ? (
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
        {posts.slice(0, 3).map((post) => (
          <BlogCard
            title={post.data.title}
            slug={post.data.slug || post.id}
            description={post.data.description}
            date={post.data.date}
            category={post.data.category}
            readTime={post.data.readTime}
          />
        ))}
      </div>
    ) : (
      <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); padding: clamp(32px, 6vw, 48px); text-align: center; max-width: 640px; margin: 0 auto; box-shadow: var(--shadow-sm);">
        <span class="icon-tile" style="width: 52px; height: 52px; border-radius: 14px; background: var(--accent-soft); color: var(--accent); margin: 0 auto 16px;">
          <svg style="width: 24px; height: 24px;"><use href="#i-home"/></svg>
        </span>
        <h3 style="font-size: 20px; font-weight: 700; color: var(--ink); margin-bottom: 8px;">
          Expert Moving Guides
        </h3>
        <p style="font-size: 14.5px; color: var(--muted); margin-bottom: 24px; line-height: 1.6;">
          Browse our expert articles for tips on moving home across Camden, Barnet, Brent, and Westminster.
        </p>
        <a href="/blog/" class="btn btn--accent btn--sm">
          Visit Moving Blog <svg class="arrow"><use href="#i-arrow"/></svg>
        </a>
      </div>
    )}
  </div>
</section>
