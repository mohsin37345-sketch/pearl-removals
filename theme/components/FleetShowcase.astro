---
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
}

const {
  eyebrow = "EQUIPMENT & CAPABILITIES",
  title = "Real Moves. Real Fleet. Dedicated Crews.",
  subtitle = "We don't broker your move or dispatch unvetted freelancers. Operating from our Cricklewood NW2 depot, our purpose-equipped Luton box vans, tail-lift trucks, and secure storage hubs handle every relocation with white-glove diligence."
} = Astro.props;
---

<section class="section section--fleet" aria-labelledby="fleet-showcase-heading">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="eyebrow">{eyebrow}</span>
      <h2 id="fleet-showcase-heading">{title}</h2>
      <p>{subtitle}</p>
    </div>

    <div class="fleet-grid">
      <!-- Card 1: Commercial & Specialist Moves with Tail-Lift -->
      <div class="fleet-card reveal">
        <div class="fleet-card__media">
          <img
            src="/images/commercial-office-equipment-removals.webp"
            alt="Pearl Removals commercial tail-lift truck loaded with flight cases and equipment in London"
            width="448"
            height="558"
            loading="lazy"
          />
          <div class="fleet-card__overlay"></div>
          <div class="fleet-card__pill">
            <span class="fleet-card__dot"></span>
            <span>500kg Hydraulic Tail-Lift</span>
          </div>
        </div>

        <div class="fleet-card__content">
          <div class="fleet-card__header">
            <span class="fleet-card__category">COMMERCIAL &amp; OFFICE LOGISTICS</span>
            <h3 class="fleet-card__title">Specialist Equipment &amp; Tail-Lift Transport</h3>
          </div>
          <p class="fleet-card__text">
            Heavy flight cases, IT server cabinets, commercial showroom displays, and bulky office furniture loaded effortlessly using hydraulic tail-lifts and non-slip safety ramps.
          </p>
          <div class="fleet-card__features">
            <span class="pill-chip"><svg><use href="#i-check"/></svg>Heavy Equipment Ready</span>
            <span class="pill-chip"><svg><use href="#i-check"/></svg>DBS-Checked Movers</span>
            <span class="pill-chip"><svg><use href="#i-check"/></svg>£50k GIT Cover</span>
          </div>
          <div class="fleet-card__action">
            <a href="/removals/office-removals/" class="btn btn--outline btn--sm">
              Explore office moves <svg class="arrow"><use href="#i-arrow"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Card 2: Modern Fleet & Cricklewood Depot Hub -->
      <div class="fleet-card reveal">
        <div class="fleet-card__media">
          <img
            src="/images/secure-storage-removals-fleet-london.webp"
            alt="Pearl Removals moving van fleet inside logistics and storage depot"
            width="499"
            height="634"
            loading="lazy"
          />
          <div class="fleet-card__overlay"></div>
          <div class="fleet-card__pill">
            <span class="live-dot"></span>
            <span>Cricklewood NW2 Base · 7 Days</span>
          </div>
        </div>

        <div class="fleet-card__content">
          <div class="fleet-card__header">
            <span class="fleet-card__category">LONDON-WIDE LOGISTICS &amp; STORAGE</span>
            <h3 class="fleet-card__title">Low-Loader Lutons &amp; Secure Storage</h3>
          </div>
          <p class="fleet-card__text">
            Clean, carpeted and strapped Luton box vans paired with 24/7 CCTV container storage in North West London. Flexible weekly and monthly options for chain delays or phased moves.
          </p>
          <div class="fleet-card__features">
            <span class="pill-chip"><svg><use href="#i-check"/></svg>Low-Loader Ramps</span>
            <span class="pill-chip"><svg><use href="#i-check"/></svg>24/7 CCTV Storage</span>
            <span class="pill-chip"><svg><use href="#i-check"/></svg>Camden &amp; Brent CPZ</span>
          </div>
          <div class="fleet-card__action">
            <a href="/removals/storage/" class="btn btn--outline btn--sm">
              Explore secure storage <svg class="arrow"><use href="#i-arrow"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section--fleet {
    padding-block: clamp(56px, 8vw, 96px);
    background: var(--pearl);
  }

  .fleet-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-top: clamp(32px, 5vw, 48px);
  }

  @media (max-width: 860px) {
    .fleet-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .fleet-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .fleet-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .fleet-card__media {
    position: relative;
    width: 100%;
    height: 320px;
    overflow: hidden;
    background: var(--ink);
  }

  @media (max-width: 640px) {
    .fleet-card__media {
      height: 240px;
    }
  }

  .fleet-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .fleet-card:hover .fleet-card__media img {
    transform: scale(1.03);
  }

  .fleet-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 26, 46, 0.1) 0%, rgba(11, 26, 46, 0.6) 100%);
    pointer-events: none;
  }

  .fleet-card__pill {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(11, 26, 46, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #ffffff;
    padding: 7px 16px;
    border-radius: var(--r-pill);
    font-size: 13px;
    font-weight: 700;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    letter-spacing: -0.01em;
  }

  .fleet-card__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .fleet-card__content {
    padding: clamp(24px, 4vw, 32px);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .fleet-card__category {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 8px;
  }

  .fleet-card__title {
    font-size: clamp(20px, 2.5vw, 24px);
    font-weight: 800;
    color: var(--ink);
    line-height: 1.25;
    margin-bottom: 12px;
  }

  .fleet-card__text {
    font-size: 14.5px;
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 20px;
  }

  .fleet-card__features {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  .pill-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink);
    background: var(--pearl);
    border: 1px solid var(--line);
    padding: 4px 12px;
    border-radius: var(--r-pill);
  }

  .pill-chip svg {
    width: 14px;
    height: 14px;
    color: var(--mint);
  }

  .fleet-card__action {
    margin-top: auto;
  }
</style>

