---
import { siteConfig } from 'src/data/site';
import Logo from './Logo.astro';
---

<!-- FOOTER -->
<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo variant="footer" size="md" />
        <p class="footer__about">Premium house and flat removals based at our Cricklewood NW2 hub. Fully insured, transparent fixed rates, and careful white-glove moves across London and nationwide.</p>
        <div class="footer__socials">
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg><use href="#i-fb"/></svg></a>
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg><use href="#i-ig"/></svg></a>
          <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" aria-label="TikTok"><svg><use href="#i-tt"/></svg></a>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><svg><use href="#i-in"/></svg></a>
        </div>
      </div>

      <div>
        <h5>Services</h5>
        <ul class="footer__links">
          <li><a href="/removals/house-removals/">House Removals</a></li>
          <li><a href="/removals/flat-removals/">Flat Removals</a></li>
          <li><a href="/removals/office-removals/">Office Moves</a></li>
          <li><a href="/removals/packing-services/">Packing Service</a></li>
          <li><a href="/removals/storage/">Secure Storage</a></li>
          <li><a href="/removals/man-and-van/">Man &amp; Van</a></li>
          <li><a href="/removals/piano-removals/">Piano Removals</a></li>
          <li><a href="/removals/">All Services &rarr;</a></li>
        </ul>
      </div>

      <div>
        <h5>Coverage Areas</h5>
        <ul class="footer__links">
          <li><a href="/areas/cricklewood/">Cricklewood (Hub NW2)</a></li>
          <li><a href="/areas/hampstead/">Hampstead (NW3)</a></li>
          <li><a href="/areas/belsize-park/">Belsize Park (NW3)</a></li>
          <li><a href="/areas/west-hampstead/">West Hampstead (NW6)</a></li>
          <li><a href="/areas/kilburn/">Kilburn (NW6)</a></li>
          <li><a href="/areas/hendon/">Hendon (NW4)</a></li>
          <li><a href="/areas/golders-green/">Golders Green (NW11)</a></li>
          <li><a href="/areas/harrow/">Harrow (HA1)</a></li>
          <li><a href="/areas/wembley/">Wembley (HA9)</a></li>
          <li><a href="/areas/">Explore All 50+ Areas &rarr;</a></li>
        </ul>
      </div>

      <div>
        <h5>Company</h5>
        <ul class="footer__links">
          <li><a href="/about-us/">About us</a></li>
          <li><a href="/how-it-works/">How it works</a></li>
          <li><a href="/prices/">Pricing Guide</a></li>
          <li><a href="/reviews/">Customer Reviews</a></li>
          <li><a href="/faqs/">FAQs</a></li>
          <li><a href="/blog/two-week-moving-checklist/">Moving Checklist</a></li>
          <li><a href="/contact-us/">Contact Us</a></li>
          <li><a href="/get-a-quote/">Get a Quote</a></li>
        </ul>
      </div>

      <div class="footer__news">
        <h5>Get in touch</h5>
        <div class="footer__contact">
          <a href={`tel:${siteConfig.phoneE164}`}><svg><use href="#i-phone"/></svg><span><strong>{siteConfig.phone}</strong>Mon–Sun, 7am–9pm</span></a>
          <a href={`mailto:${siteConfig.email}`}><svg><use href="#i-mail"/></svg><span><strong>{siteConfig.email}</strong>Fast reply within 1 hour</span></a>
          <div><svg><use href="#i-pin"/></svg><span><strong>Cricklewood, London NW2</strong>Serving all London &amp; UK-wide</span></div>
        </div>
        <form class="newsletter" onsubmit="event.preventDefault(); this.querySelector('input').value=''; this.querySelector('button').textContent='Sent ✓';">
          <input type="email" placeholder="Email for moving tips" aria-label="Email address" required />
          <button class="btn btn--accent" type="submit">Join</button>
        </form>
        <div class="footer__badges">
          <span><svg><use href="#i-shield"/></svg>£50k GIT Insured</span>
          <span><svg><use href="#i-users"/></svg>DBS checked team</span>
        </div>
      </div>
    </div>
  </div>

  <div class="footer__wordmark" aria-hidden="true">PEARL</div>

  <div class="footer__bottom">
    <div class="container" style="display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap">
      <span>© <span id="year">2026</span> {siteConfig.legalName} (Base: Cricklewood NW2). All rights reserved.</span>
      <div class="footer__legal">
        <a href="/privacy-policy/">Privacy</a>
        <a href="/terms-and-conditions/">Terms</a>
        <a href="/terms-of-business/">Terms of Business</a>
        <a href="/complaints-procedure/">Complaints</a>
        <a href="/sitemap/">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
