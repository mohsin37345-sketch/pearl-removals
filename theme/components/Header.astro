<!-- Topbar Announcement Slider Script -->
<script is:inline>
  (function () {
    function initTopbarSlider() {
      const track = document.getElementById('topbarTrack');
      if (!track) return;
      const slides = Array.from(track.querySelectorAll('.topbar__slide'));
      if (slides.length <= 1) return;

      let current = 0;
      let timer = null;
      const intervalMs = 3500; // rotate every 3.5s

      function showSlide(nextIndex, direction = 1) {
        if (nextIndex === current) return;
        const prevSlide = slides[current];
        const nextSlide = slides[nextIndex];

        // Reset any other slides to ready position
        slides.forEach((s, idx) => {
          if (idx !== current && idx !== nextIndex) {
            s.classList.remove('is-active', 'is-prev');
            s.style.transform = direction > 0 ? 'translateY(100%)' : 'translateY(-100%)';
            s.style.opacity = '0';
          }
        });

        // Current slide slides out
        prevSlide.classList.remove('is-active');
        prevSlide.classList.add('is-prev');
        prevSlide.style.transform = direction > 0 ? 'translateY(-100%)' : 'translateY(100%)';
        prevSlide.style.opacity = '0';

        // Next slide slides in
        nextSlide.classList.remove('is-prev');
        nextSlide.classList.add('is-active');
        nextSlide.style.transform = 'translateY(0)';
        nextSlide.style.opacity = '1';

        current = nextIndex;
      }

      function next() {
        const nextIdx = (current + 1) % slides.length;
        showSlide(nextIdx, 1);
      }

      function prev() {
        const prevIdx = (current - 1 + slides.length) % slides.length;
        showSlide(prevIdx, -1);
      }

      function start() {
        stop();
        timer = setInterval(next, intervalMs);
      }

      function stop() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      start();

      // Controls
      const prevBtn = document.getElementById('topbarPrev');
      const nextBtn = document.getElementById('topbarNext');
      if (prevBtn) {
        prevBtn.onclick = (e) => {
          e.preventDefault();
          prev();
          start();
        };
      }
      if (nextBtn) {
        nextBtn.onclick = (e) => {
          e.preventDefault();
          next();
          start();
        };
      }

      // Pause on hover
      const slider = document.getElementById('topbarSlider');
      if (slider) {
        slider.onmouseenter = stop;
        slider.onmouseleave = start;

        // Mobile touch swipe support
        let touchStartX = 0;
        slider.addEventListener('touchstart', (e) => {
          stop();
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        slider.addEventListener('touchend', (e) => {
          const touchEndX = e.changedTouches[0].screenX;
          if (touchStartX - touchEndX > 35) {
            next();
          } else if (touchEndX - touchStartX > 35) {
            prev();
          }
          start();
        }, { passive: true });
      }

      // Pause when tab is hidden to save resources
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else start();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTopbarSlider);
    } else {
      initTopbarSlider();
    }
  })();
</script>
