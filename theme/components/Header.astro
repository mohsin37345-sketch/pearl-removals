---
import { siteConfig } from 'src/data/site';
import navData from 'src/data/navigation.json';
import { getPublishedAreas } from 'theme/utils/published';
import Icon from './Icon.astro';

const publishedAreas = await getPublishedAreas();
const currentPath = Astro.url.pathname;
---

<header class="sticky top-4 z-50 w-full px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto transition-all duration-300" id="site-header">
  <nav 
    class="glass-nav rounded-full px-4 py-2.5 sm:px-6 sm:py-3 flex items-center justify-between gap-4 transition-all duration-200"
    aria-label="Main Navigation"
  >
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-royal rounded-full pr-2" aria-label="Pearl Removals Home">
      <div class="relative w-9 h-9 rounded-full bg-gradient-to-tr from-royal to-royal-light flex items-center justify-center text-white shadow-sm shadow-royal/20 transition-transform group-hover:scale-105">
        <!-- Pearl Circle with House Motif -->
        <span class="absolute inset-0.5 rounded-full border border-white/40"></span>
        <Icon name="home" class="w-4 h-4 text-white relative z-10" />
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold text-base sm:text-lg tracking-tight text-navy dark:text-pearl leading-none">
          PEARL <span class="text-royal font-semibold text-xs sm:text-sm tracking-widest uppercase block sm:inline">REMOVALS</span>
        </span>
      </div>
    </a>

    <!-- Desktop Center Nav Items -->
    <ul class="hidden lg:flex items-center gap-1 xl:gap-2">
      {navData.header.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        
        if (item.label === 'Services') {
          return (
            <li class="relative group">
              <a
                href={item.href}
                class={`px-3.5 py-2 rounded-full text-sm font-medium transition-colors flex items-center gap-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-royal ${
                  isActive ? 'text-royal font-semibold' : 'text-navy/80 hover:text-royal dark:text-pearl/80 dark:hover:text-white'
                }`}
              >
                {item.label}
                <Icon name="chevron-down" class="w-3.5 h-3.5 transition-transform group-hover:rotate-180 opacity-70" />
              </a>

              <!-- Mega Menu Dropdown -->
              <div class="absolute left-1/2 -translate-x-1/2 top-full pt-3 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 w-[580px]">
                <div class="glass-panel p-5 bg-white/95 dark:bg-navy/95 rounded-2xl shadow-2xl border border-white/60 dark:border-white/10 grid grid-cols-2 gap-6">
                  {item.groups?.map((group) => (
                    <div>
                      <h4 class="text-xs font-bold uppercase tracking-wider text-royal dark:text-royal-light mb-3 pb-1 border-b border-surface-200 dark:border-surface-700">
                        {group.title}
                      </h4>
                      <ul class="space-y-1.5">
                        {group.items.map((sub) => (
                          <li>
                            <a
                              href={sub.href}
                              class="block p-2 rounded-xl hover:bg-surface-100/80 dark:hover:bg-white/5 transition-colors group/sub"
                            >
                              <div class="font-medium text-sm text-navy dark:text-pearl group-hover/sub:text-royal">
                                {sub.label}
                              </div>
                              <p class="text-xs text-surface-500 dark:text-surface-400 line-clamp-1">
                                {sub.desc}
                              </p>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </li>
          );
        }

        if (item.label === 'Areas We Cover') {
          return (
            <li class="relative group">
              <a
                href={item.href}
                class={`px-3.5 py-2 rounded-full text-sm font-medium transition-colors flex items-center gap-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-royal ${
                  isActive ? 'text-royal font-semibold' : 'text-navy/80 hover:text-royal dark:text-pearl/80 dark:hover:text-white'
                }`}
              >
                {item.label}
                <Icon name="chevron-down" class="w-3.5 h-3.5 transition-transform group-hover:rotate-180 opacity-70" />
              </a>

              <!-- Areas Mega Menu -->
              <div class="absolute left-1/2 -translate-x-1/2 top-full pt-3 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 w-[420px]">
                <div class="glass-panel p-5 bg-white/95 dark:bg-navy/95 rounded-2xl shadow-2xl border border-white/60 dark:border-white/10">
                  <div class="flex items-center justify-between pb-2 mb-3 border-b border-surface-200 dark:border-surface-700">
                    <span class="text-xs font-bold uppercase tracking-wider text-royal">Coverage Hub</span>
                    <a href="/areas/" class="text-xs font-semibold text-royal hover:underline flex items-center gap-1">
                      View all areas <Icon name="arrow-right" class="w-3 h-3" />
                    </a>
                  </div>

                  {publishedAreas.length > 0 ? (
                    <div class="grid grid-cols-2 gap-2 max-h-64 overflow-y-auto pr-1">
                      {publishedAreas.map((area) => (
                        <a
                          href={`/areas/${area.slug}/`}
                          class="p-2 rounded-lg text-xs font-medium text-navy dark:text-pearl hover:bg-surface-100/80 dark:hover:bg-white/5 hover:text-royal transition-colors flex items-center justify-between"
                        >
                          <span>{area.name}</span>
                          {area.premium && <span class="text-gold text-[10px]">★</span>}
                        </a>
                      ))}
                    </div>
                  ) : (
                    <div class="p-3 text-center text-xs text-surface-500">
                      <p class="font-medium text-navy dark:text-pearl mb-1">Serving North West London</p>
                      <p>Centred on our Cricklewood NW2 base. Area landing pages coming online shortly.</p>
                      <a href="/areas/" class="inline-block mt-3 px-3 py-1.5 bg-royal text-white rounded-full text-xs font-semibold">
                        View Coverage Area
                      </a>
                    </div>
                  )}
                </div>
              </div>
            </li>
          );
        }

        return (
          <li>
            <a
              href={item.href}
              class={`px-3.5 py-2 rounded-full text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-royal ${
                isActive ? 'text-royal font-semibold' : 'text-navy/80 hover:text-royal dark:text-pearl/80 dark:hover:text-white'
              }`}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Header Actions (Call & Quote CTA + Dark Toggle) -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Dark Mode Switcher -->
      <button
        id="theme-toggle"
        type="button"
        class="w-9 h-9 rounded-full flex items-center justify-center text-navy/70 dark:text-pearl/80 hover:bg-white/40 dark:hover:bg-white/10 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-royal"
        aria-label="Toggle colour scheme"
      >
        <span class="dark:hidden"><Icon name="moon" class="w-4 h-4" /></span>
        <span class="hidden dark:inline"><Icon name="sun" class="w-4 h-4 text-gold" /></span>
      </button>

      <!-- Click to Call Phone CTA (Visible across all breakpoints per spec) -->
      <a
        href={`tel:${siteConfig.phoneE164}`}
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs md:text-sm font-bold text-navy dark:text-pearl hover:text-royal dark:hover:text-royal-light transition-colors"
        aria-label={`Call Pearl Removals on ${siteConfig.phone}`}
      >
        <Icon name="phone" class="w-4 h-4 text-royal" />
        <span class="font-bold tracking-tight">{siteConfig.phone}</span>
      </a>

      <!-- Primary CTA Button -->
      <a
        href="/get-a-quote/"
        class="inline-flex items-center justify-center px-4 py-2 sm:px-5 sm:py-2.5 rounded-full bg-royal text-white text-xs sm:text-sm font-semibold tracking-wide hover:bg-royal-hover active:scale-[0.98] transition-all shadow-md shadow-royal/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-royal focus-visible:ring-offset-2"
      >
        <span>Get a Free Quote</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-nav-toggle"
        type="button"
        class="lg:hidden w-9 h-9 rounded-full flex items-center justify-center text-navy dark:text-pearl hover:bg-white/40 dark:hover:bg-white/10 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-royal"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
      >
        <span id="menu-icon-open"><Icon name="receipt" class="w-5 h-5 rotate-90" /></span>
        <span id="menu-icon-close" class="hidden"><Icon name="x" class="w-5 h-5" /></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Navigation Drawer / Panel -->
  <div
    id="mobile-nav-panel"
    class="fixed inset-x-4 top-20 z-50 p-6 glass-panel bg-white/95 dark:bg-navy/95 border border-white/60 dark:border-white/10 shadow-2xl rounded-3xl hidden transition-all duration-300"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile Navigation Menu"
  >
    <div class="flex flex-col gap-4 max-h-[80vh] overflow-y-auto">
      <div class="flex items-center justify-between pb-3 border-b border-surface-200 dark:border-surface-700">
        <span class="font-bold text-navy dark:text-pearl">Menu</span>
        <button id="mobile-nav-close" type="button" class="p-1 rounded-full text-surface-500 hover:text-navy dark:hover:text-white" aria-label="Close menu">
          <Icon name="x" class="w-5 h-5" />
        </button>
      </div>

      <ul class="flex flex-col gap-2">
        <li>
          <a href="/" class="block py-2 text-base font-semibold text-navy dark:text-pearl hover:text-royal mobile-link">Home</a>
        </li>
        <li>
          <a href="/removals/" class="block py-2 text-base font-semibold text-navy dark:text-pearl hover:text-royal mobile-link">Services</a>
          <ul class="pl-4 space-y-1 text-sm text-surface-600 dark:text-surface-400">
            <li><a href="/removals/house-removals/" class="block py-1 hover:text-royal mobile-link">House Removals</a></li>
            <li><a href="/removals/flat-removals/" class="block py-1 hover:text-royal mobile-link">Flat Removals</a></li>
            <li><a href="/removals/man-and-van/" class="block py-1 hover:text-royal mobile-link">Man and Van</a></li>
            <li><a href="/removals/office-removals/" class="block py-1 hover:text-royal mobile-link">Office Removals</a></li>
            <li><a href="/removals/packing-services/" class="block py-1 hover:text-royal mobile-link">Packing Services</a></li>
            <li><a href="/removals/storage/" class="block py-1 hover:text-royal mobile-link">Storage</a></li>
          </ul>
        </li>
        <li>
          <a href="/areas/" class="block py-2 text-base font-semibold text-navy dark:text-pearl hover:text-royal mobile-link">Areas We Cover</a>
        </li>
        <li>
          <a href="/prices/" class="block py-2 text-base font-semibold text-navy dark:text-pearl hover:text-royal mobile-link">Pricing</a>
        </li>
        <li>
          <a href="/reviews/" class="block py-2 text-base font-semibold text-navy dark:text-pearl hover:text-royal mobile-link">Reviews</a>
        </li>
        <li>
          <a href="/how-it-works/" class="block py-2 text-base font-semibold text-navy dark:text-pearl hover:text-royal mobile-link">How It Works</a>
        </li>
        <li>
          <a href="/moving-cost-calculator/" class="block py-2 text-base font-semibold text-navy dark:text-pearl hover:text-royal mobile-link">Cost Calculator</a>
        </li>
        <li>
          <a href="/contact-us/" class="block py-2 text-base font-semibold text-navy dark:text-pearl hover:text-royal mobile-link">Contact</a>
        </li>
      </ul>

      <div class="pt-4 border-t border-surface-200 dark:border-surface-700 flex flex-col gap-3">
        <a
          href={`tel:${siteConfig.phoneE164}`}
          class="flex items-center justify-center gap-2 py-3 rounded-full bg-surface-100 dark:bg-white/10 text-navy dark:text-pearl font-bold text-sm"
        >
          <Icon name="phone" class="w-4 h-4 text-royal" />
          Call {siteConfig.phone}
        </a>
        <a
          href="/get-a-quote/"
          class="flex items-center justify-center py-3 rounded-full bg-royal text-white font-bold text-sm tracking-wide shadow-md shadow-royal/20"
        >
          Get a Free Quote →
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  // Mobile Nav Toggle Logic with Focus Trap and Scroll Lock
  (function() {
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const closeBtn = document.getElementById('mobile-nav-close');
    const panel = document.getElementById('mobile-nav-panel');
    const openIcon = document.getElementById('menu-icon-open');
    const closeIcon = document.getElementById('menu-icon-close');
    const links = document.querySelectorAll('.mobile-link');
    const themeBtn = document.getElementById('theme-toggle');

    function toggleMenu(open) {
      const isExpanded = open !== undefined ? open : toggleBtn.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;

      toggleBtn.setAttribute('aria-expanded', String(nextState));
      panel.setAttribute('aria-hidden', String(!nextState));

      if (nextState) {
        panel.classList.remove('hidden');
        openIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      } else {
        panel.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    if (toggleBtn && panel) {
      toggleBtn.addEventListener('click', () => toggleMenu());
      if (closeBtn) closeBtn.addEventListener('click', () => toggleMenu(false));

      // Close on link click
      links.forEach(l => l.addEventListener('click', () => toggleMenu(false)));

      // Close on Escape key
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
          toggleMenu(false);
          toggleBtn.focus();
        }
      });
    }

    // Theme Toggle Handler
    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (_) {}
      });
    }
  })();
</script>
