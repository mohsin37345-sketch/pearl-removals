        </div>
        <div class="topbar__slide" data-index="2">
          <svg class="topbar__icon"><use href="#i-clock"/></svg>
          <span>Mon–Sun · 7am–9pm</span>
        </div>
        <div class="topbar__slide" data-index="3">
          <a class="topbar__link" href="/reviews/">
            <span class="stars">
              <svg><use href="#i-star"/></svg>
              <svg><use href="#i-star"/></svg>
              <svg><use href="#i-star"/></svg>
              <svg><use href="#i-star"/></svg>
              <svg><use href="#i-star"/></svg>
            </span>
            <span>4.9 from 380+ reviews</span>
