---
import { siteConfig } from 'src/data/site';
import Icon from './Icon.astro';
import SkylineSvg from './SkylineSvg.astro';
import FeatureTiles from './FeatureTiles.astro';

interface Props {
  variant?: 'home' | 'service' | 'area' | 'micro' | 'region' | 'blog' | 'legal' | 'simple';
  title?: string;
  highlightText?: string;
  eyebrow?: string;
  subtitle?: string;
  badges?: string[];
  priceFrom?: number;
  priceUnit?: string;
  heroImage?: string;
  heroImageAlt?: string;
  hasVerifiedReviews?: boolean;
}

const {
  variant = 'simple',
  title = "House Removals in North West London",
  highlightText = "North West London",
  eyebrow = "MOVING HOME?",
  subtitle = "From the first box to the final key, Pearl Removals makes your move smooth, safe and stress-free.",
  badges = [],
  priceFrom,
  priceUnit,
  heroImage = "/images/hero-pearl-removals-van.jpg",
  heroImageAlt = "Pearl Removals team with Luton van in North West London",
  hasVerifiedReviews = false
} = Astro.props;
---

{variant === 'home' && (
  <section class="relative pt-6 pb-12 lg:pt-10 lg:pb-16 overflow-hidden">
    <!-- Subtle Background Gradient Glow -->
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-royal/5 via-transparent to-transparent pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        
        <!-- Left Side: Large Frosted Glass Card -->
        <div class="lg:col-span-7 glass-panel p-6 sm:p-8 lg:p-10 relative">
          
          <!-- Location Pill + Tagline -->
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <span class="glass-pill px-3 py-1 rounded-full text-xs font-bold text-royal flex items-center gap-1.5 shadow-sm">
              <Icon name="map-pin" class="w-3.5 h-3.5" />
              North West London
            </span>
            <span class="text-xs font-semibold text-surface-500 dark:text-surface-400 tracking-wide">
              Local | Reliable | Professional
            </span>
          </div>

          <!-- Eyebrow -->
          <div class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-royal dark:text-royal-light mb-2">
            {eyebrow}
          </div>

          <!-- Headline H1 -->
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-navy dark:text-pearl tracking-tight leading-[1.15] mb-4">
            House Removals in <span class="text-royal">{highlightText}</span>
          </h1>

          <!-- Subtext -->
          <p class="text-base sm:text-lg text-surface-600 dark:text-surface-300 font-normal leading-relaxed mb-6 max-w-xl">
            {subtitle}
          </p>

          <!-- Dual CTAs -->
          <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-8">
            <a
              href="/get-a-quote/"
              class="px-6 py-3.5 rounded-full bg-royal text-white font-bold text-sm tracking-wide hover:bg-royal-hover active:scale-[0.98] transition-all shadow-lg shadow-royal/25 focus:outline-none focus-visible:ring-2 focus-visible:ring-royal"
            >
              Get a Free Quote →
            </a>
            <a
              href={`tel:${siteConfig.phoneE164}`}
              class="glass-pill px-5 py-3.5 rounded-full text-navy dark:text-pearl font-bold text-sm hover:bg-white/90 dark:hover:bg-white/15 transition-all flex items-center gap-2"
            >
              <Icon name="phone" class="w-4 h-4 text-royal" />
              Call Us Today
            </a>
          </div>

          <!-- 4 Feature Tiles -->
          <FeatureTiles class="mb-6" />

          <!-- Bottom Glass Trust Strip -->
          <div class="glass-pill p-3 sm:p-4 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4 border border-white/60 dark:border-white/10">
            <div class="flex items-center gap-3">
              {hasVerifiedReviews ? (
                <div class="flex text-gold">
                  {[...Array(5)].map(() => (
                    <Icon name="star" class="w-4 h-4" />
                  ))}
                </div>
              ) : (
                <div class="w-7 h-7 rounded-full bg-royal/10 flex items-center justify-center text-royal">
                  <Icon name="award" class="w-4 h-4" />
                </div>
              )}
              <span class="text-xs font-bold text-navy dark:text-pearl tracking-tight">
                Trusted by Homes Across North West London
              </span>
            </div>

            <!-- Divider -->
            <div class="hidden sm:block h-6 w-px bg-surface-300 dark:bg-white/20"></div>

            <!-- Skyline SVG -->
            <div class="flex items-center">
              <SkylineSvg width={140} height={28} />
            </div>
          </div>
        </div>

        <!-- Right Side: LCP-Optimized Visual Graphic / Hero Image -->
        <div class="lg:col-span-5 relative">
          <div class="glass-panel p-3 overflow-hidden rounded-3xl relative shadow-2xl">
            <!-- London Streetscape Representation -->
            <div class="relative aspect-[4/3] rounded-2xl overflow-hidden bg-gradient-to-tr from-surface-100 to-surface-200 dark:from-navy-dark dark:to-navy flex items-center justify-center">
              <!-- Illustrated Van & House Visual -->
              <svg viewBox="0 0 400 300" class="w-full h-full object-cover" xmlns="http://www.w3.org/2000/svg" aria-label="Pearl Removals Luton Van parked outside a London Victorian home">
                <!-- Sky -->
                <rect width="400" height="300" fill="#E8F1FC" class="dark:fill-[#0F1E3D]" />
                <!-- Sun / Glow -->
                <circle cx="340" cy="60" r="40" fill="#FFF2D6" opacity="0.6" />
                
                <!-- London Red Brick House Facade -->
                <rect x="20" y="50" width="160" height="190" fill="#C25946" rx="2" />
                <!-- Brick Lines -->
                <line x1="20" y1="90" x2="180" y2="90" stroke="#9A3C2B" stroke-width="1.5" />
                <line x1="20" y1="130" x2="180" y2="130" stroke="#9A3C2B" stroke-width="1.5" />
                <line x1="20" y1="170" x2="180" y2="170" stroke="#9A3C2B" stroke-width="1.5" />
                <!-- Windows -->
                <rect x="40" y="70" width="40" height="50" fill="#FFF" rx="2" stroke="#E2E8F0" stroke-width="2" />
                <rect x="110" y="70" width="40" height="50" fill="#FFF" rx="2" stroke="#E2E8F0" stroke-width="2" />
                <rect x="40" y="140" width="40" height="50" fill="#FFF" rx="2" stroke="#E2E8F0" stroke-width="2" />
                <!-- Front Door with Fanlight -->
                <rect x="110" y="150" width="40" height="90" fill="#0F1E3D" rx="2" />
                <circle cx="120" cy="195" r="2" fill="#F5B82E" />

                <!-- Tree Foliage -->
                <circle cx="190" cy="110" r="35" fill="#5A8F62" opacity="0.9" />
                <circle cx="210" cy="80" r="30" fill="#487850" opacity="0.9" />

                <!-- Pavement & Kerb -->
                <rect x="0" y="240" width="400" height="60" fill="#D8DDE4" class="dark:fill-[#1A263D]" />
                <line x1="0" y1="240" x2="400" y2="240" stroke="#B0B9C6" stroke-width="3" />

                <!-- Pearl Removals Luton Van -->
                <g transform="translate(180, 130)">
                  <!-- Van Body / Luton Box -->
                  <rect x="0" y="10" width="130" height="90" rx="4" fill="#FFFFFF" stroke="#CBD5E1" stroke-width="2" />
                  <!-- Cab -->
                  <path d="M130 40 L170 40 L190 70 L190 100 L130 100 Z" fill="#FFFFFF" stroke="#CBD5E1" stroke-width="2" />
                  <!-- Windscreen -->
                  <path d="M135 45 L165 45 L180 68 L135 68 Z" fill="#87CEEB" />
                  <!-- Wheels -->
                  <circle cx="40" cy="102" r="14" fill="#1F2937" />
                  <circle cx="40" cy="102" r="6" fill="#D1D5DB" />
                  <circle cx="160" cy="102" r="14" fill="#1F2937" />
                  <circle cx="160" cy="102" r="6" fill="#D1D5DB" />
                  <!-- Branded Side Decal -->
                  <rect x="15" y="28" width="100" height="34" rx="6" fill="#0F1E3D" />
                  <text x="65" y="45" font-family="sans-serif" font-weight="900" font-size="10" fill="#FFFFFF" text-anchor="middle">PEARL REMOVALS</text>
                  <text x="65" y="56" font-family="sans-serif" font-weight="600" font-size="6" fill="#1F5BFF" text-anchor="middle">NORTH WEST LONDON</text>
                </g>

                <!-- Stacked Removal Boxes on Pavement -->
                <rect x="145" y="200" width="26" height="24" fill="#D4A373" stroke="#B08968" stroke-width="1.5" rx="1" />
                <line x1="145" y1="212" x2="171" y2="212" stroke="#7F5539" stroke-width="1" />
                <rect x="150" y="178" width="22" height="22" fill="#E6BA8B" stroke="#B08968" stroke-width="1.5" rx="1" />
                <line x1="150" y1="189" x2="172" y2="189" stroke="#7F5539" stroke-width="1" />
              </svg>
            </div>

            <!-- Floating Badge Overlay -->
            <div class="absolute bottom-6 left-6 right-6 glass-pill p-3 rounded-2xl flex items-center justify-between shadow-lg">
              <div class="flex items-center gap-2.5">
                <div class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-xs font-bold text-navy dark:text-pearl">Live Booking Availability</span>
              </div>
              <span class="text-xs font-extrabold text-royal">7 Days / Week</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
)}

{variant !== 'home' && (
  <section class="relative pt-8 pb-10 lg:pt-12 lg:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-panel p-6 sm:p-10 lg:p-12">
        <div class="max-w-3xl">
          {eyebrow && (
            <div class="text-xs font-extrabold uppercase tracking-widest text-royal dark:text-royal-light mb-2">
              {eyebrow}
            </div>
          )}

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-navy dark:text-pearl tracking-tight leading-tight mb-4">
            {title}
          </h1>

          {subtitle && (
            <p class="text-base sm:text-lg text-surface-600 dark:text-surface-300 font-normal leading-relaxed mb-6">
              {subtitle}
            </p>
          )}

          <!-- Badges / Tags -->
          {badges && badges.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-6">
              {badges.map((b) => (
                <span class="glass-pill px-3 py-1 rounded-full text-xs font-bold text-navy dark:text-pearl">
                  {b}
                </span>
              ))}
            </div>
          )}

          <!-- Price Tag If Available -->
          {priceFrom && (
            <div class="inline-flex items-baseline gap-1.5 px-4 py-2 rounded-xl bg-royal/10 text-royal dark:text-royal-light font-extrabold text-lg mb-6">
              <span class="text-xs font-semibold uppercase tracking-wider text-surface-500">From</span>
              <span>£{priceFrom}</span>
              {priceUnit && <span class="text-xs font-normal text-surface-500">/ {priceUnit}</span>}
            </div>
          )}

          <!-- Action CTAs -->
          <div class="flex flex-wrap items-center gap-3">
            <a
              href="/get-a-quote/"
              class="px-6 py-3 rounded-full bg-royal text-white font-bold text-sm hover:bg-royal-hover active:scale-[0.98] transition-all shadow-md shadow-royal/20"
            >
              Get a Free Quote →
            </a>
            <a
              href={`tel:${siteConfig.phoneE164}`}
              class="glass-pill px-5 py-3 rounded-full text-navy dark:text-pearl font-bold text-sm hover:bg-white/80 transition-all flex items-center gap-2"
            >
              <Icon name="phone" class="w-4 h-4 text-royal" />
              Call {siteConfig.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
)}
