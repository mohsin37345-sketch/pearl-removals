---
import { siteConfig } from 'src/data/site';

interface Props {
  title?: string;
  highlightText?: string;
  lead?: string;
  subtitle?: string;
  eyebrow?: string;
  badges?: Array<string | { text: string; icon?: string; liveDot?: boolean; desktopOnly?: boolean }>;
  photoUrl?: string;
  photoAlt?: string;
  showQuoteForm?: boolean;
  defaultFromPostcode?: string;
  defaultToPostcode?: string;
  defaultMoveType?: 'house' | 'flat' | 'office';
  primaryCtaText?: string;
  primaryCtaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
  variant?: string;
  hasVerifiedReviews?: boolean;
  priceFrom?: number;
  priceUnit?: string;
}

const {
  title,
  highlightText,
  lead,
  subtitle,
  eyebrow,
  badges,
  photoUrl = '/images/house-removals-north-west-london.webp',
  photoAlt = 'Pearl Removals Luton van parked outside residential home in North West London',
  showQuoteForm = true,
  defaultFromPostcode = '',
  defaultToPostcode = '',
  defaultMoveType = 'house',
  primaryCtaText = 'Get my free quote',
  primaryCtaLink = '#quote',
  secondaryCtaText,
  secondaryCtaLink,
  priceFrom,
  priceUnit = 'fixed'
} = Astro.props;

const phoneText = secondaryCtaText || siteConfig.phone;
const phoneLink = secondaryCtaLink || `tel:${siteConfig.phoneE164}`;
const effectiveLead = lead || subtitle || "Friendly, fully insured movers who pack, lift and deliver everything with care — at a fixed price that never changes on the day.";
const accessKey = import.meta.env.WEB3FORMS_ACCESS_KEY || 'YOUR_ACCESS_KEY_HERE';
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__content reveal">
      {eyebrow && (
        <div style="margin-bottom: 12px;">
          <span class="eyebrow">{eyebrow}</span>
        </div>
      )}

      <div class="hero__badges">
        {badges && badges.length > 0 ? (
          badges.map((b) => {
            const isObj = typeof b === 'object';
            const text = isObj ? b.text : b;
            const isDesktopOnly =
              (isObj && b.desktopOnly) ||
              text.includes('GIT Cover') ||
              text.includes('CPZ Support');

            return (
              <span class={`pill ${isDesktopOnly ? 'pill--desktop-only' : ''}`}>
                {isObj && b.liveDot ? (
                  <span class="live-dot" style="margin-left:6px"></span>
                ) : (
                  <span class="pill__dot"><svg><use href={`#i-${(isObj && b.icon) || 'pin'}`}/></svg></span>
                )}
                {text}
              </span>
            );
          })
        ) : (
          <>
            <span class="pill"><span class="pill__dot"><svg><use href="#i-pin"/></svg></span>North West London &amp; beyond</span>
            <span class="pill"><span class="live-dot" style="margin-left:6px"></span>Available this weekend</span>
          </>
        )}
      </div>

      <h1 class="hero__title">
        {title ? (
          highlightText && title.includes(highlightText) ? (
            (() => {
              const parts = title.split(highlightText);
              return (
                <>
                  {parts[0]}
                  <span class="mark">
                    {highlightText}
                    <svg viewBox="0 0 200 20" preserveAspectRatio="none"><path d="M3 15 C 50 4, 140 2, 197 12" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg>
                  </span>
                  {parts.slice(1).join(highlightText)}
                </>
              );
            })()
          ) : (
            title
          )
        ) : (
          <>
            House Removals in
            <span class="mark">
              North West London
              <svg viewBox="0 0 200 20" preserveAspectRatio="none"><path d="M3 15 C 50 4, 140 2, 197 12" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg>
            </span>
          </>
        )}
      </h1>

      <p class="hero__lead">
        {effectiveLead}
      </p>

      {priceFrom && (
        <div style="margin-top: 14px; font-size: 15px; color: var(--muted)">
          Starting from <b style="color: var(--ink); font-size: 20px; font-family: var(--font-display)">£{priceFrom}</b> ({priceUnit})
        </div>
      )}

      <div class="hero__ctas">
        <a href={primaryCtaLink} class="btn btn--accent">
          {primaryCtaText} <svg class="arrow"><use href="#i-arrow"/></svg>
        </a>
        <a href={phoneLink} class="btn btn--ghost">
          <svg><use href="#i-phone"/></svg> {phoneText}
        </a>
      </div>

      <div class="hero__proof">
        <div class="avatars">
          <span style="background:#ff6a2b">S</span>
          <span style="background:#2f6bff">J</span>
          <span style="background:#18b26b">A</span>
          <span style="background:#0b1a2e">+</span>
        </div>
        <p><strong>2,400+ happy moves</strong><br />across London since 2016</p>
        <span class="hero__proof-divider"></span>
        <div class="google-score">
          <b>4.9</b>
          <div>
            <span class="stars"><svg><use href="#i-star"/></svg><svg><use href="#i-star"/></svg><svg><use href="#i-star"/></svg><svg><use href="#i-star"/></svg><svg><use href="#i-star"/></svg></span>
            <p style="font-size:13px;color:var(--muted)">380+ Google reviews</p>
          </div>
        </div>
      </div>

      <!-- 4 Trust Feature Tiles (From Old Template & Brand Guarantees) -->
      <div class="hero__features">
        <div class="hero__feature">
          <svg><use href="#i-home"/></svg>
          <div><strong>Local &amp; Long Distance</strong><span>NW London to UK-wide</span></div>
        </div>
        <div class="hero__feature">
          <svg><use href="#i-box"/></svg>
          <div><strong>Safe &amp; Secure Handling</strong><span>Blankets &amp; covers standard</span></div>
        </div>
        <div class="hero__feature">
          <svg><use href="#i-shield"/></svg>
          <div><strong>Fully Insured Removals</strong><span>£50k GIT / £5M Liability</span></div>
        </div>
        <div class="hero__feature">
          <svg><use href="#i-users"/></svg>
          <div><strong>Experienced Team</strong><span>Trained, punctual movers</span></div>
        </div>
      </div>
    </div>

    <div class="hero__visual reveal" id="quote">
      <div class="photo hero__photo">
        <img src={photoUrl} alt={photoAlt} width="768" height="1024" loading="eager" fetchpriority="high" />
        <div class="hero__photo-tag">
          <span class="live-dot"></span>
          <span>North West London Fleet · Cricklewood NW2</span>
        </div>
      </div>

      <div class="float-chip float-chip--a">
        <span class="icon-tile"><svg><use href="#i-shield"/></svg></span>
        <div><strong>£50k insured</strong><span>Goods in transit cover</span></div>
      </div>
      <div class="float-chip float-chip--b">
        <span class="icon-tile"><svg><use href="#i-check-circle"/></svg></span>
        <div><strong>Move booked!</strong><span>Harrow → Ealing · Sat</span></div>
      </div>

      {showQuoteForm && (
        <div class="hero-form-card">
          <div class="hero-form-card__accent"></div>

          <div class="hero-form-card__header">
            <div class="hero-form-card__icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <h3 class="hero-form-card__title">Request a Quick Call Back</h3>
              <p class="hero-form-card__subtitle">We'll get back to you within 15 minutes</p>
            </div>
          </div>

          <form class="quick-cta-form" id="heroCallbackForm" action="https://api.web3forms.com/submit" method="POST">
            <input type="hidden" name="access_key" value={accessKey} />
            <input type="hidden" name="subject" value="New Call Back Request - Pearl Removals Website" />
            <input type="hidden" name="from_name" value="Pearl Removals Website" />
            <input type="checkbox" name="botcheck" style="display:none;" />

            <!-- Service Selection -->
            <div class="hero-form-field">
              <div class="hero-form-field__icon">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
              </div>
              <select name="service" class="hero-form-input hero-form-select" required aria-label="Select Service Needed">
                <option value="" disabled selected>Select Service Required</option>
                <option value="House removals">House Removals (1–5+ Beds)</option>
                <option value="Flat removals">Flat / Apartment Removals</option>
                <option value="Office removals">Office &amp; Commercial Moves</option>
                <option value="Man and van">Man &amp; Van Transport</option>
                <option value="Secure storage">Secure Storage Solutions</option>
                <option value="Packing services">Professional Packing Service</option>
                <option value="Piano delivery">Piano &amp; Specialist Moves</option>
              </select>
              <div class="hero-form-field__arrow">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </div>
            </div>

            <!-- Name -->
            <div class="hero-form-field">
              <div class="hero-form-field__icon">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
              <input type="text" name="name" class="hero-form-input" placeholder="Your Name" required aria-label="Your Name" />
            </div>

            <!-- Email & Phone Row -->
            <div class="hero-form-row">
              <div class="hero-form-field">
                <div class="hero-form-field__icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </div>
                <input type="email" name="email" class="hero-form-input" placeholder="Email Address" required aria-label="Email Address" />
              </div>
              <div class="hero-form-field">
                <div class="hero-form-field__icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <input type="tel" name="phone" class="hero-form-input" placeholder="Phone Number" required aria-label="Phone Number" />
              </div>
            </div>

            <!-- Button -->
            <button type="submit" class="hero-form-btn">
              <span>Get Started</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>

            <!-- Footer -->
            <p class="hero-form-card__footer">
              <span>🔒 Your information is secure &amp; never shared</span>
            </p>
          </form>
        </div>
      )}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const ctaForm = document.getElementById('heroCallbackForm');
    if (!ctaForm) return;

    const WEB3FORMS_URL = 'https://api.web3forms.com/submit';
    const MAKE_WEBHOOK = 'https://hook.eu1.make.com/838q63uv1gxtcvj5jypyqr9rjiadx36b';

    ctaForm.addEventListener('submit', function (e) {
      e.preventDefault();

      const btn = ctaForm.querySelector('button[type="submit"]');
      const origHTML = btn ? btn.innerHTML : '';
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span>Sending…</span>';
      }

      const formData = new FormData(ctaForm);

      const emailPromise = fetch(WEB3FORMS_URL, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      }).then(res => res.json()).then(data => {
        if (!data || !data.success) throw new Error((data && data.message) || 'Web3Forms error');
        return data;
      });

      const makePayload = {
        _subject: formData.get('subject'),
        Service: formData.get('service') || 'Call back request',
        fullName: formData.get('name'),
        email: formData.get('email'),
        phone: formData.get('phone'),
        _inventoryText: ''
      };

      const makePromise = formData.get('botcheck') ? Promise.reject(new Error('Honeypot filled')) : fetch(MAKE_WEBHOOK, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(makePayload)
      }).then(res => {
        if (!res.ok) throw new Error('Make.com network error');
      });

      Promise.allSettled([emailPromise, makePromise]).then(results => {
        const failed = results.filter(r => r.status === 'rejected');
        if (failed.length === results.length) {
          showFormToast(false, 'Submission failed. Please call us directly on 020 3151 8452.');
        } else {
          showFormToast(true, "Thank you! We'll call you back within 15 minutes.");
          ctaForm.reset();
        }
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = origHTML;
        }
      });
    });

    function showFormToast(success, message) {
      const old = document.getElementById('formToast');
      if (old) old.remove();

      const toast = document.createElement('div');
      toast.id = 'formToast';
      toast.className = 'form-toast ' + (success ? 'form-toast--success' : 'form-toast--error');

      const bodyText = message || (success ? "Thank you! We'll call you back within 15 minutes." : "Please try again or call us at 020 3151 8452.");
      const titleText = success ? "Request Received!" : "Something went wrong";

      toast.innerHTML =
        '<div class="form-toast__icon">' + (success ? '✅' : '⚠️') + '</div>' +
        '<div class="form-toast__content">' +
        '<strong>' + titleText + '</strong>' +
        '<p>' + bodyText + '</p>' +
        '</div>' +
        '<button type="button" class="form-toast__close" onclick="this.parentElement.remove()" aria-label="Close">✕</button>';

      document.body.appendChild(toast);

      requestAnimationFrame(() => toast.classList.add('form-toast--visible'));

      setTimeout(() => {
        if (toast.parentElement) {
          toast.classList.remove('form-toast--visible');
          setTimeout(() => { if (toast.parentElement) toast.remove(); }, 400);
        }
      }, 8000);
    }
  })();
</script>
