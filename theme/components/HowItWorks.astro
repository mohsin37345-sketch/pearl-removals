---
interface StepItem {
  icon?: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  description?: string;
  steps?: StepItem[];
  marginTop?: boolean;
}

const defaultSteps: StepItem[] = [
  {
    icon: "clipboard",
    title: "1. Free Survey & Fixed Quote",
    description: "Fill in our 60-second form or book a quick WhatsApp video survey. You get a guaranteed fixed price in writing."
  },
  {
    icon: "truck",
    title: "2. CPZ & Parking Guidance",
    description: "We guide you on parking bay suspensions across Camden, Brent, Barnet & Westminster to ensure seamless van access."
  },
  {
    icon: "box",
    title: "3. Quilted Protection & Loading",
    description: "Our uniformed team protects floors, wraps furniture in padded blankets, and loads with £50k transit cover."
  },
  {
    icon: "key",
    title: "4. Key Handover & Settle In",
    description: "We accommodate property chain key delays, place boxes into their respective rooms, and reassemble your beds."
  }
];

const {
  eyebrow = "How it works",
  title = "Booked in minutes. Moved without the stress.",
  subtitle,
  description,
  steps = defaultSteps,
  marginTop = true
} = Astro.props;

const effectiveDesc = subtitle || description || "A calm, structured 4-step moving process designed specifically for London property moves.";
---

<section class="section section--dark" id="how" style={marginTop ? "margin-top:var(--section-y)" : ""}>
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      <p>{effectiveDesc}</p>
    </div>
    <div class="steps">
      {steps.map((step) => (
        <div class="step reveal">
          <div class="step__num">
            <svg><use href={`#i-${step.icon || 'box'}`}/></svg>
          </div>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </div>
      ))}
    </div>

    <div style="display: flex; justify-content: center; gap: 16px; margin-top: 40px; flex-wrap: wrap;">
      <a href="/how-it-works/" class="btn btn--outline-light btn--sm">
        Explore full moving day protocol <svg class="arrow"><use href="#i-arrow"/></svg>
      </a>
      <a href="/get-a-quote/" class="btn btn--accent btn--sm">
        Get your free quote <svg class="arrow"><use href="#i-arrow"/></svg>
      </a>
    </div>
  </div>
</section>
