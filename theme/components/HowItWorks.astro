---
import Icon from './Icon.astro';

interface Step {
  step: number;
  title: string;
  description: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  steps?: Step[];
}

const defaultSteps: Step[] = [
  {
    step: 1,
    title: "Request a Quote",
    description: "Submit our simple online form or give us a call. We review your postcodes, move dates, and initial inventory details."
  },
  {
    step: 2,
    title: "Free Video or Home Survey",
    description: "We conduct a thorough 15-minute video walk-through or on-site survey to assess access, volume, stairs, and parking needs."
  },
  {
    step: 3,
    title: "We Pack & Move",
    description: "Our uniformed team arrives on schedule with quilted blankets, crates, and protective covers to load and transport safely."
  },
  {
    step: 4,
    title: "Settle In With Peace of Mind",
    description: "We place all furniture and labelled boxes into their designated rooms at your new home so you can unwind."
  }
];

const {
  title = "How It Works",
  subtitle = "A straightforward, stress-free four-stage moving journey from start to finish.",
  steps = defaultSteps
} = Astro.props;
---

<section class="py-12 lg:py-16 relative" aria-labelledby="how-it-works-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-royal mb-2 block">Step-by-Step Clarity</span>
      <h2 id="how-it-works-heading" class="text-3xl sm:text-4xl font-black text-navy dark:text-pearl tracking-tight">
        {title}
      </h2>
      <p class="text-sm sm:text-base text-surface-600 dark:text-surface-400 mt-2">
        {subtitle}
      </p>
    </div>

    <!-- 4 Numbered Steps -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
      {steps.map((item, idx) => (
        <div class="glass-panel p-6 rounded-3xl relative flex flex-col justify-between hover:-translate-y-1 transition-transform">
          <div>
            <!-- Step Number Badge -->
            <div class="w-10 h-10 rounded-2xl bg-royal text-white font-extrabold text-sm flex items-center justify-center shadow-md shadow-royal/30 mb-4">
              0{item.step}
            </div>

            <h3 class="font-bold text-base text-navy dark:text-pearl mb-2">
              {item.title}
            </h3>

            <p class="text-xs sm:text-sm text-surface-600 dark:text-surface-400 leading-relaxed">
              {item.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-surface-200/60 dark:border-white/10 flex items-center gap-1.5 text-xs font-semibold text-royal">
            <Icon name="check" class="w-3.5 h-3.5" />
            <span>Guaranteed care</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Slot for extra context or CTA -->
    <slot />
  </div>
</section>
