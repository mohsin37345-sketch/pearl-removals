---
interface Props {
  name: string;
  slug: string;
  postcodes: string[];
  boroughs?: string[];
  distanceMiles: number;
  premium?: boolean;
  microCount?: number;
}

const {
  name,
  slug,
  postcodes = [],
  boroughs = [],
  distanceMiles,
  premium = false,
  microCount = 0
} = Astro.props;

const isHub = slug === 'cricklewood' || name.toLowerCase().includes('cricklewood');
---

<a
  href={`/areas/${slug}/`}
  class={`location-card ${isHub ? 'location-card--hub' : ''} ${premium ? 'location-card--premium' : ''}`}
>
  <!-- Card Header -->
  <div class="location-card__top">
    <div class="location-card__title-wrap">
      <span class="location-card__icon">
        <svg><use href="#i-pin"/></svg>
        {isHub && <span class="hub-pulse"></span>}
      </span>
      <div>
        <h3 class="location-card__name">{name}</h3>
        {boroughs && boroughs.length > 0 ? (
          <span class="location-card__borough">{boroughs.join(' / ')}</span>
        ) : (
          <span class="location-card__borough">North West London</span>
        )}
      </div>
    </div>

    {isHub ? (
      <span class="tag-hub">
        <span class="live-dot-sm"></span> HQ Hub
      </span>
    ) : premium ? (
      <span class="tag-premium">
        <svg width="11" height="11"><use href="#i-star"/></svg> Prime Care
      </span>
    ) : null}
  </div>

  <!-- Meta row: Postcodes & Distance -->
  <div class="location-card__meta">
    <div class="location-card__postcodes">
      {postcodes.map((pc) => (
        <span class="postcode-badge">{pc}</span>
      ))}
    </div>
    <span class="location-card__distance">
      <svg><use href="#i-truck"/></svg>
      {distanceMiles === 0 ? 'NW2 Operations Base' : `~${distanceMiles} ${distanceMiles === 1 ? 'mile' : 'miles'} from NW2`}
    </span>
  </div>

  <!-- Card Footer -->
  <div class="location-card__foot">
    <span class="location-card__subtext">
      {microCount > 0 ? (
        <span><strong>{microCount}</strong> micro areas &amp; street guides</span>
      ) : (
        <span>Full house &amp; flat removals</span>
      )}
    </span>
    <span class="location-card__cta">
      <span>Explore</span>
      <span class="cta-circle">
        <svg class="arrow"><use href="#i-arrow"/></svg>
      </span>
    </span>
  </div>
</a>
