---
import Icon from './Icon.astro';

interface Props {
  name: string;
  slug: string;
  postcodes: string[];
  boroughs?: string[];
  distanceMiles: number;
  premium?: boolean;
  microCount?: number;
}

const {
  name,
  slug,
  postcodes = [],
  boroughs = [],
  distanceMiles,
  premium = false,
  microCount = 0
} = Astro.props;
---

<a
  href={`/areas/${slug}/`}
  class="glass-panel p-5 rounded-2xl block group hover:-translate-y-1 hover:shadow-xl transition-all duration-200 border border-white/60 dark:border-white/10"
>
  <div class="flex items-start justify-between gap-2 mb-2">
    <div class="flex items-center gap-1.5 font-extrabold text-base text-navy dark:text-pearl group-hover:text-royal transition-colors">
      <Icon name="map-pin" class="w-4 h-4 text-royal flex-shrink-0" />
      <span>{name}</span>
    </div>

    {premium && (
      <span class="inline-flex items-center gap-1 text-[11px] font-bold text-gold bg-amber-50 dark:bg-amber-950/40 px-2 py-0.5 rounded-full border border-amber-200 dark:border-amber-800">
        ★ Premium
      </span>
    )}
  </div>

  <div class="flex flex-wrap items-center gap-1.5 text-xs text-surface-500 mb-3">
    <span class="font-bold text-navy/80 dark:text-pearl/80">{postcodes.join(', ')}</span>
    <span>•</span>
    <span>~{distanceMiles} {distanceMiles === 1 ? 'mile' : 'miles'} from NW2</span>
  </div>

  {boroughs.length > 0 && (
    <div class="text-[11px] text-surface-400 mb-3">
      Borough: {boroughs.join(' / ')}
    </div>
  )}

  <div class="flex items-center justify-between pt-3 border-t border-surface-200/50 dark:border-white/5 text-xs font-semibold text-royal">
    <span>{microCount > 0 ? `${microCount} micro areas` : 'Explore removals'}</span>
    <Icon name="arrow-right" class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
  </div>
</a>
