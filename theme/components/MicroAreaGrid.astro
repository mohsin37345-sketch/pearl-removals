---
interface MicroArea {
  name: string;
  slug: string;
  premium?: boolean;
}

interface Props {
  parentSlug: string;
  parentName: string;
  micros?: MicroArea[];
}

const { parentSlug, parentName, micros = [] } = Astro.props;
---

{micros && micros.length > 0 && (
  <section class="my-10" aria-labelledby="micro-areas-heading">
    <div style="margin-bottom: 20px;">
      <span class="eyebrow">Local Micro-Districts</span>
      <h3 id="micro-areas-heading" style="font-size: clamp(20px, 3vw, 28px); margin-top: 8px;">
        Neighbourhoods &amp; Micro Areas We Serve in {parentName}
      </h3>
      <p style="color: var(--muted); font-size: 15px; margin-top: 6px;">
        Dedicated local removals and moving teams across every corner of {parentName}.
      </p>
    </div>

    <div class="chips" style="margin-top: 16px;">
      {micros.map((micro) => (
        <a
          href={`/areas/${parentSlug}/${micro.slug}/`}
          class="chip"
        >
          <svg><use href="#i-pin"/></svg>
          <span>{micro.name}</span>
          {micro.premium && <span style="color: var(--star); margin-left: 4px;">★</span>}
        </a>
      ))}
    </div>
  </section>
)}
