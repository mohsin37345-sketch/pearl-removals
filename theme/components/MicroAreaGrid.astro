---
import Icon from './Icon.astro';

interface MicroArea {
  name: string;
  slug: string;
  premium?: boolean;
}

interface Props {
  parentSlug: string;
  parentName: string;
  micros?: MicroArea[];
}

const { parentSlug, parentName, micros = [] } = Astro.props;
---

{micros && micros.length > 0 && (
  <section class="my-10" aria-labelledby="micro-areas-heading">
    <div class="mb-6">
      <span class="text-xs font-bold uppercase tracking-widest text-royal block mb-1">Local Micro-Districts</span>
      <h3 id="micro-areas-heading" class="text-xl sm:text-2xl font-black text-navy dark:text-pearl tracking-tight">
        Neighbourhoods & Micro Areas We Serve in {parentName}
      </h3>
      <p class="text-xs sm:text-sm text-surface-600 dark:text-surface-400 mt-1">
        Dedicated local removals and moving teams across every corner of {parentName}.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
      {micros.map((micro) => (
        <a
          href={`/areas/${parentSlug}/${micro.slug}/`}
          class="glass-pill p-3.5 rounded-2xl flex items-center justify-between text-xs font-semibold text-navy dark:text-pearl hover:text-royal hover:scale-105 transition-all group"
        >
          <div class="flex items-center gap-1.5 truncate">
            <Icon name="map-pin" class="w-3.5 h-3.5 text-royal flex-shrink-0" />
            <span class="truncate">{micro.name}</span>
          </div>
          {micro.premium && <span class="text-gold text-xs flex-shrink-0">★</span>}
        </a>
      ))}
    </div>
  </section>
)}
