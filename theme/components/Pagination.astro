---
import Icon from './Icon.astro';

interface Props {
  currentPage: number;
  lastPage: number;
  total: number;
  pageSize: number;
  basePath?: string;
}

const {
  currentPage,
  lastPage,
  total,
  pageSize = 12,
  basePath = "/blog"
} = Astro.props;

const startItem = total === 0 ? 0 : (currentPage - 1) * pageSize + 1;
const endItem = Math.min(currentPage * pageSize, total);

const hasPrev = currentPage > 1;
const hasNext = currentPage < lastPage;

const prevUrl = currentPage === 2 ? `${basePath}/` : `${basePath}/${currentPage - 1}/`;
const nextUrl = `${basePath}/${currentPage + 1}/`;
---

{total > 0 && (
  <nav aria-label="Pagination" class="py-8 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-surface-200 dark:border-white/10 my-8">
    <!-- Results Meta Text -->
    <div class="text-xs text-surface-500 font-medium">
      Showing <span class="font-bold text-navy dark:text-pearl">{startItem}–{endItem}</span> of <span class="font-bold text-navy dark:text-pearl">{total}</span> articles
    </div>

    <!-- Navigation Controls -->
    <div class="flex items-center gap-2">
      <!-- Previous -->
      {hasPrev ? (
        <a
          href={prevUrl}
          rel="prev"
          class="px-4 py-2 rounded-xl glass-pill text-xs font-bold text-navy dark:text-pearl hover:bg-royal hover:text-white transition-all flex items-center gap-1"
        >
          <Icon name="chevron-right" class="w-3.5 h-3.5 rotate-180" />
          <span>Previous</span>
        </a>
      ) : (
        <span
          class="px-4 py-2 rounded-xl glass-pill text-xs font-bold text-surface-400 opacity-50 cursor-not-allowed flex items-center gap-1"
          aria-disabled="true"
        >
          <Icon name="chevron-right" class="w-3.5 h-3.5 rotate-180" />
          <span>Previous</span>
        </span>
      )}

      <!-- Current / Total Indicator -->
      <span class="px-3 py-2 text-xs font-bold text-navy dark:text-pearl">
        Page {currentPage} of {lastPage}
      </span>

      <!-- Next -->
      {hasNext ? (
        <a
          href={nextUrl}
          rel="next"
          class="px-4 py-2 rounded-xl glass-pill text-xs font-bold text-navy dark:text-pearl hover:bg-royal hover:text-white transition-all flex items-center gap-1"
        >
          <span>Next</span>
          <Icon name="chevron-right" class="w-3.5 h-3.5" />
        </a>
      ) : (
        <span
          class="px-4 py-2 rounded-xl glass-pill text-xs font-bold text-surface-400 opacity-50 cursor-not-allowed flex items-center gap-1"
          aria-disabled="true"
        >
          <span>Next</span>
          <Icon name="chevron-right" class="w-3.5 h-3.5" />
        </span>
      )}
    </div>
  </nav>
)}
