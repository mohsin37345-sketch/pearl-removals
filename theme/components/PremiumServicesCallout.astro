---
interface Props {
  areaName?: string;
}

const { areaName } = Astro.props;
---

<div style="background: var(--ink); color: #fff; border-radius: var(--r-xl); padding: clamp(28px, 5vw, 44px); margin-block: 36px; box-shadow: var(--shadow-lg);">
  <div style="display: flex; flex-direction: column; gap: 20px;">
    <div style="max-width: 720px;">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
        <span class="eyebrow" style="color: var(--accent);">White-Glove &amp; Specialist Relocation</span>
        <span style="color: var(--star); font-size: 13px;">★★★★★</span>
      </div>
      
      <h3 style="font-size: clamp(22px, 3.2vw, 30px); margin: 0; color: #fff;">
        Premium Relocation Services {areaName ? `in ${areaName}` : 'for Discerning Homes'}
      </h3>

      <p style="font-size: 15px; color: rgba(255,255,255,0.78); line-height: 1.6; margin-top: 12px;">
        For period townhouses, mansion apartments, and substantial residences, we provide bespoke packing, antique crating, grand piano relocations, wardrobe boxes, and dedicated building porter coordination.
      </p>

      <div class="chips" style="margin-top: 18px;">
        <span class="pill" style="background: rgba(255,255,255,0.08); border-color: var(--line-dark); color: #fff;">Full Export Packing</span>
        <span class="pill" style="background: rgba(255,255,255,0.08); border-color: var(--line-dark); color: #fff;">Fine Art &amp; Piano Handling</span>
        <span class="pill" style="background: rgba(255,255,255,0.08); border-color: var(--line-dark); color: #fff;">Mansion Porter Liaison</span>
        <span class="pill" style="background: rgba(255,255,255,0.08); border-color: var(--line-dark); color: #fff;">Secure Container Storage</span>
      </div>
    </div>

    <div>
      <a
        href="/get-a-quote/"
        class="btn btn--accent"
      >
        Enquire About White-Glove Move <svg class="arrow"><use href="#i-arrow"/></svg>
      </a>
    </div>
  </div>
</div>
