---
import Icon from './Icon.astro';

interface Props {
  areaName?: string;
}

const { areaName } = Astro.props;
---

<div class="glass-panel p-6 sm:p-8 rounded-3xl border border-royal/30 bg-gradient-to-br from-white/90 via-royal/5 to-white/90 dark:from-navy dark:via-royal/10 dark:to-navy shadow-xl my-8">
  <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
    <div class="max-w-2xl space-y-2">
      <div class="flex items-center gap-2">
        <span class="text-xs font-extrabold uppercase tracking-widest text-royal dark:text-royal-light">White-Glove & Specialist Relocation</span>
        <span class="text-gold text-xs">★★★★★</span>
      </div>
      
      <h3 class="text-xl sm:text-2xl font-black text-navy dark:text-pearl tracking-tight">
        Premium Relocation Services {areaName ? `in ${areaName}` : 'for Discerning Homes'}
      </h3>

      <p class="text-sm text-surface-600 dark:text-surface-300 leading-relaxed">
        For period townhouses, mansion apartments, and substantial residences, we provide bespoke packing, antique crating, grand piano relocations, wardrobe boxes, and dedicated building porter coordination.
      </p>

      <div class="flex flex-wrap gap-2 pt-2">
        <span class="glass-pill px-3 py-1 rounded-full text-xs font-semibold text-navy dark:text-pearl">Full Export Packing</span>
        <span class="glass-pill px-3 py-1 rounded-full text-xs font-semibold text-navy dark:text-pearl">Fine Art & Piano Handling</span>
        <span class="glass-pill px-3 py-1 rounded-full text-xs font-semibold text-navy dark:text-pearl">Mansion Porter Liaison</span>
        <span class="glass-pill px-3 py-1 rounded-full text-xs font-semibold text-navy dark:text-pearl">Secure Container Storage</span>
      </div>
    </div>

    <div class="flex-shrink-0">
      <a
        href="/get-a-quote/"
        class="inline-flex items-center justify-center px-6 py-3.5 rounded-full bg-navy dark:bg-royal text-white font-bold text-sm tracking-wide hover:bg-navy-light dark:hover:bg-royal-hover transition-colors shadow-lg shadow-navy/20"
      >
        Enquire About White-Glove Move →
      </a>
    </div>
  </div>
</div>
