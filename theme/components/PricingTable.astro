---
interface PlanItem {
  name: string;
  price: string;
  unit?: string;
  description: string;
  features: string[];
  ctaText: string;
  ctaLink: string;
  popular?: boolean;
  flagText?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  description?: string;
  plans?: PlanItem[];
  footerNote?: string;
  footerLinkText?: string;
  footerLinkUrl?: string;
}

const defaultPlans: PlanItem[] = [
  {
    name: "Man & Van",
    price: "£45",
    unit: " /hour",
    description: "Single items, students and small flat moves.",
    features: [
      "1–2 movers + Luton van",
      "Padded transit blankets & straps",
      "2-hour transparent minimum",
      "Goods in transit cover included"
    ],
    ctaText: "Book Man & Van",
    ctaLink: "/get-a-quote/"
  },
  {
    name: "Flat / House Move",
    price: "£299",
    unit: " from",
    description: "1–3 bedroom homes, fully managed relocation.",
    features: [
      "2–3 movers + 3.5t Luton box van",
      "Full furniture wrapping & floor protection",
      "Dismantling & reassembly included",
      "Written fixed-price guarantee"
    ],
    ctaText: "Get my fixed price",
    ctaLink: "/get-a-quote/",
    popular: true,
    flagText: "Most popular"
  },
  {
    name: "Full Pack & Move",
    price: "£699",
    unit: " from",
    description: "Larger homes with complete packing service.",
    features: [
      "Everything in House Move",
      "All boxes, bubble wrap & tape included",
      "Professional packing the day prior",
      "Wardrobe boxes for hanging clothes"
    ],
    ctaText: "Book Full Service",
    ctaLink: "/get-a-quote/"
  }
];

const {
  eyebrow = "Simple pricing",
  title = "Transparent prices. No hidden fees.",
  subtitle,
  description,
  plans = defaultPlans,
  footerNote = "Looking for detailed room breakdowns?",
  footerLinkText = "View our full Pricing Guide & Rates",
  footerLinkUrl = "/prices/"
} = Astro.props;

const effectiveDesc = subtitle || description || "Typical rates for local London moves. Your exact fixed price is calculated with zero hidden extras.";
---

<section class="section section--white" id="pricing">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      <p>{effectiveDesc}</p>
    </div>
    <div class="pricing">
      {plans.map((plan) => (
        <div class={`plan ${plan.popular ? 'plan--popular' : ''} reveal`}>
          {plan.flagText && <span class="plan__flag">{plan.flagText}</span>}
          <span class="plan__name">{plan.name}</span>
          <div class="plan__price">
            {plan.price}
            {plan.unit && <small>{plan.unit}</small>}
          </div>
          <p class="plan__desc">{plan.description}</p>
          <ul class="plan__list">
            {plan.features.map((f) => (
              <li><svg><use href="#i-check-circle"/></svg>{f}</li>
            ))}
          </ul>
          <a
            href={plan.ctaLink}
            class={`btn ${plan.popular ? 'btn--accent' : 'btn--ghost'} btn--block`}
          >
            {plan.ctaText} {plan.popular && <svg class="arrow"><use href="#i-arrow"/></svg>}
          </a>
        </div>
      ))}
    </div>
    {footerNote && (
      <p class="pricing-note">
        {footerNote} <a href={footerLinkUrl}>{footerLinkText}</a> · <a href="/removals/long-distance-removals/">Long-distance UK moves &rarr;</a>
      </p>
    )}
  </div>
</section>
