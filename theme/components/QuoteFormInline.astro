---
interface Props {
  buttonText?: string;
  defaultPostcode?: string;
}

const { buttonText = "Get Free Quote", defaultPostcode = "" } = Astro.props;
---

<form
  action="/get-a-quote/"
  method="GET"
  style="display: flex; gap: 10px; flex-wrap: wrap; background: var(--surface); padding: 8px; border: 1px solid var(--line); border-radius: var(--r-pill); max-width: 520px;"
>
  <div style="flex: 1; min-width: 140px; position: relative;">
    <input
      type="text"
      name="from_postcode"
      value={defaultPostcode}
      placeholder="Moving from (e.g. NW2)"
      required
      style="width: 100%; border: 0; background: none; padding: 10px 16px; font-size: 15px; outline: none;"
    />
  </div>

  <button
    type="submit"
    class="btn btn--accent btn--sm"
  >
    {buttonText} <svg class="arrow"><use href="#i-arrow"/></svg>
  </button>
</form>
