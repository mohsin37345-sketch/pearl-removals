---
interface Props {
  title?: string;
  subtitle?: string;
  defaultFromPostcode?: string;
}

const {
  title = "Get Your Free Moving Quote",
  subtitle = "Accurate, upfront fixed-price quotations tailored to your exact property volume and London location.",
  defaultFromPostcode = ""
} = Astro.props;

const accessKey = import.meta.env.WEB3FORMS_ACCESS_KEY || 'YOUR_ACCESS_KEY_HERE';
---

<section class="section" id="quote-section" aria-labelledby="quote-card-heading">
  <div class="container" style="max-width: 800px;">
    <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); padding: clamp(28px, 5vw, 48px); box-shadow: var(--shadow-md);">
      
      <div class="section-head section-head--center" style="margin-bottom: 28px;">
        <span class="eyebrow">Fast No-Obligation Estimate</span>
        <h2 id="quote-card-heading" style="font-size: clamp(26px, 3.5vw, 36px);">{title}</h2>
        <p style="font-size: 15px;">{subtitle}</p>
      </div>

      <form action="/get-a-quote/" method="GET" class="quote-form-styled" id="page-quote-form">
        <input type="hidden" name="access_key" value={accessKey} />
        
        <div class="segmented" role="radiogroup" aria-label="Move type">
          <label><input type="radio" name="move_type" value="house" checked /><span>House</span></label>
          <label><input type="radio" name="move_type" value="flat" /><span>Flat</span></label>
          <label><input type="radio" name="move_type" value="office" /><span>Office</span></label>
        </div>

        <div class="route-line" style="margin-top: 14px;">
          <div class="field">
            <svg><use href="#i-pin"/></svg>
            <input type="text" name="from_postcode" value={defaultFromPostcode} placeholder="Moving from (postcode)" aria-label="Moving from postcode" required />
          </div>
          <div class="field">
            <svg><use href="#i-flag"/></svg>
            <input type="text" name="to_postcode" placeholder="Moving to (postcode)" aria-label="Moving to postcode" required />
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <svg><use href="#i-home"/></svg>
            <select name="property_size" aria-label="Property size">
              <option value="1bed">1 bedroom</option>
              <option value="2bed" selected>2 bedrooms</option>
              <option value="3bed">3 bedrooms</option>
              <option value="4bed+">4+ bedrooms</option>
            </select>
          </div>
          <div class="field">
            <svg><use href="#i-calendar"/></svg>
            <input type="date" name="moving_date" aria-label="Moving date" />
          </div>
        </div>

        <div class="field" style="margin-top: 10px;">
          <svg><use href="#i-phone"/></svg>
          <input type="tel" name="phone" placeholder="Phone number (for your quote text)" aria-label="Phone number" required />
        </div>

        <button type="submit" class="btn btn--accent btn--block" style="margin-top: 18px;">
          Get My Fixed Price Quote <svg class="arrow"><use href="#i-arrow"/></svg>
        </button>

        <div class="quote-card__foot" style="margin-top: 16px;">
          <span><svg><use href="#i-check"/></svg>Free</span>
          <span><svg><use href="#i-check"/></svg>No obligation</span>
          <span><svg><use href="#i-check"/></svg>No spam</span>
        </div>
      </form>
    </div>
  </div>
</section>
