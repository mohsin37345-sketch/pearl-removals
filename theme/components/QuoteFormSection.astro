---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  subtitle?: string;
  defaultFromPostcode?: string;
}

const {
  title = "Get Your Free Moving Quote",
  subtitle = "Accurate, upfront fixed-price quotations tailored to your exact property volume and London location.",
  defaultFromPostcode = ""
} = Astro.props;
---

<section class="py-12 lg:py-16 relative" id="quote-section" aria-labelledby="quote-card-heading">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="glass-panel p-6 sm:p-10 lg:p-12 rounded-3xl shadow-2xl border border-white/80 dark:border-white/10 relative overflow-hidden">
      
      <!-- Top iridescent glow line -->
      <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-transparent via-royal to-transparent"></div>

      <div class="text-center max-w-xl mx-auto mb-8 sm:mb-10">
        <span class="text-xs font-bold uppercase tracking-widest text-royal mb-2 block">Fast No-Obligation Estimate</span>
        <h2 id="quote-card-heading" class="text-2xl sm:text-3xl lg:text-4xl font-black text-navy dark:text-pearl tracking-tight">
          {title}
        </h2>
        <p class="text-xs sm:text-sm text-surface-600 dark:text-surface-400 mt-2">
          {subtitle}
        </p>
      </div>

      <form action="/get-a-quote/" method="GET" class="space-y-4 sm:space-y-5" id="home-quote-form">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Full Name -->
          <div>
            <label for="hq-name" class="block text-xs font-bold uppercase tracking-wider text-navy dark:text-pearl mb-1.5">
              Full Name *
            </label>
            <input
              type="text"
              id="hq-name"
              name="name"
              placeholder="e.g. Sarah Jenkins"
              required
              class="w-full px-4 py-3 rounded-2xl bg-white/70 dark:bg-white/10 border border-surface-200 dark:border-white/10 text-sm text-navy dark:text-pearl placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-royal transition-all"
            />
          </div>

          <!-- Phone -->
          <div>
            <label for="hq-phone" class="block text-xs font-bold uppercase tracking-wider text-navy dark:text-pearl mb-1.5">
              Phone Number *
            </label>
            <input
              type="tel"
              id="hq-phone"
              name="phone"
              placeholder="e.g. 020 8452 7700"
              required
              pattern="^(((\+44\s?\d{4}|\(?0\d{4}\)?)\s?\d{3}\s?\d{3})|((\+44\s?\d{3}|\(?0\d{3}\)?)\s?\d{3}\s?\d{4})|((\+44\s?\d{2}|\(?0\d{2}\)?)\s?\d{4}\s?\d{4}))(\s?\#(\d{4}|\d{3}))?$"
              class="w-full px-4 py-3 rounded-2xl bg-white/70 dark:bg-white/10 border border-surface-200 dark:border-white/10 text-sm text-navy dark:text-pearl placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-royal transition-all"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <!-- Email -->
          <div class="sm:col-span-3">
            <label for="hq-email" class="block text-xs font-bold uppercase tracking-wider text-navy dark:text-pearl mb-1.5">
              Email Address *
            </label>
            <input
              type="email"
              id="hq-email"
              name="email"
              placeholder="e.g. sarah@example.co.uk"
              required
              class="w-full px-4 py-3 rounded-2xl bg-white/70 dark:bg-white/10 border border-surface-200 dark:border-white/10 text-sm text-navy dark:text-pearl placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-royal transition-all"
            />
          </div>

          <!-- Moving From Postcode -->
          <div>
            <label for="hq-from" class="block text-xs font-bold uppercase tracking-wider text-navy dark:text-pearl mb-1.5">
              Moving From (Postcode) *
            </label>
            <input
              type="text"
              id="hq-from"
              name="from_postcode"
              value={defaultFromPostcode}
              placeholder="e.g. NW2 3ED"
              required
              class="w-full px-4 py-3 rounded-2xl bg-white/70 dark:bg-white/10 border border-surface-200 dark:border-white/10 text-sm text-navy dark:text-pearl placeholder-surface-400 uppercase focus:outline-none focus:ring-2 focus:ring-royal transition-all"
            />
          </div>

          <!-- Moving To Postcode -->
          <div>
            <label for="hq-to" class="block text-xs font-bold uppercase tracking-wider text-navy dark:text-pearl mb-1.5">
              Moving To (Postcode) *
            </label>
            <input
              type="text"
              id="hq-to"
              name="to_postcode"
              placeholder="e.g. NW3 1AA"
              required
              class="w-full px-4 py-3 rounded-2xl bg-white/70 dark:bg-white/10 border border-surface-200 dark:border-white/10 text-sm text-navy dark:text-pearl placeholder-surface-400 uppercase focus:outline-none focus:ring-2 focus:ring-royal transition-all"
            />
          </div>

          <!-- Moving Date -->
          <div>
            <label for="hq-date" class="block text-xs font-bold uppercase tracking-wider text-navy dark:text-pearl mb-1.5">
              Approx Move Date
            </label>
            <input
              type="date"
              id="hq-date"
              name="move_date"
              class="w-full px-4 py-3 rounded-2xl bg-white/70 dark:bg-white/10 border border-surface-200 dark:border-white/10 text-sm text-navy dark:text-pearl placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-royal transition-all"
            />
          </div>
        </div>

        <!-- Property Size Dropdown -->
        <div>
          <label for="hq-size" class="block text-xs font-bold uppercase tracking-wider text-navy dark:text-pearl mb-1.5">
            Property Size *
          </label>
          <select
            id="hq-size"
            name="property_size"
            required
            class="w-full px-4 py-3 rounded-2xl bg-white/70 dark:bg-navy border border-surface-200 dark:border-white/10 text-sm text-navy dark:text-pearl focus:outline-none focus:ring-2 focus:ring-royal transition-all"
          >
            <option value="" disabled selected>Select property size...</option>
            <option value="studio">Studio Flat / Room Only</option>
            <option value="1bed">1 Bedroom Flat / Small House</option>
            <option value="2bed">2 Bedroom Flat / House</option>
            <option value="3bed">3 Bedroom House / Flat</option>
            <option value="4bed">4 Bedroom House</option>
            <option value="5bed+">5+ Bedroom Large Residence</option>
            <option value="office">Office / Commercial Space</option>
            <option value="single">Single Large Item / Piano Move</option>
          </select>
        </div>

        <!-- Submit Button -->
        <div class="pt-2">
          <button
            type="submit"
            class="w-full py-4 px-6 rounded-full bg-royal hover:bg-royal-hover text-white font-extrabold text-base tracking-wide shadow-xl shadow-royal/30 active:scale-[0.99] transition-all flex items-center justify-center gap-2"
          >
            <span>Get My Free Quote</span>
            <Icon name="arrow-right" class="w-5 h-5" />
          </button>
        </div>

        <p class="text-[11px] text-center text-surface-500 dark:text-surface-400 leading-normal">
          We treat your data with confidentiality according to our <a href="/privacy-policy/" class="underline hover:text-royal">Privacy Policy</a>. No spam, ever.
        </p>
      </form>
    </div>
  </div>
</section>
