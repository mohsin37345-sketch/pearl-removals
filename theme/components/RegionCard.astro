---
import Icon from './Icon.astro';

interface Props {
  name: string;
  slug: string;
  intro: string;
  areaCount: number;
}

const { name, slug, intro, areaCount } = Astro.props;
---

<a
  href={`/areas/${slug}/`}
  class="glass-panel p-6 sm:p-8 rounded-3xl block group hover:-translate-y-1 hover:shadow-xl transition-all duration-200 border border-white/60 dark:border-white/10"
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <div class="w-12 h-12 rounded-2xl bg-royal/10 dark:bg-royal/20 flex items-center justify-center text-royal dark:text-royal-light group-hover:scale-110 transition-transform">
      <Icon name="map-pin" class="w-6 h-6" />
    </div>
    <span class="text-xs font-bold bg-royal/10 text-royal px-3 py-1 rounded-full">
      {areaCount} {areaCount === 1 ? 'Area' : 'Areas'}
    </span>
  </div>

  <h3 class="text-xl font-bold text-navy dark:text-pearl tracking-tight group-hover:text-royal transition-colors mb-2">
    {name}
  </h3>

  <p class="text-xs sm:text-sm text-surface-600 dark:text-surface-400 leading-relaxed mb-6">
    {intro}
  </p>

  <div class="flex items-center text-xs font-bold text-royal gap-1 group-hover:translate-x-1 transition-transform">
    <span>View Regional Removals Hub</span>
    <Icon name="arrow-right" class="w-3.5 h-3.5" />
  </div>
</a>
