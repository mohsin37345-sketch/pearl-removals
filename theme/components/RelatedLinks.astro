---
interface LinkItem {
  title: string;
  url: string;
  badge?: string;
}

interface Props {
  heading?: string;
  links: LinkItem[];
  class?: string;
}

const { heading = "Related Services & Areas", links = [], class: className = "" } = Astro.props;

// Filter out empty links or duplicates
const uniqueLinks = Array.from(new Map(links.map((l) => [l.url, l])).values());
---

{uniqueLinks.length > 0 && (
  <section class={`my-8 ${className}`} aria-label={heading}>
    <h3 style="font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 12px;">
      {heading}
    </h3>
    <div class="chips" style="margin-top: 8px;">
      {uniqueLinks.map((link) => (
        <a
          href={link.url}
          class="chip"
        >
          <span>{link.title}</span>
          {link.badge && <span style="color: var(--star); margin-left: 4px;">{link.badge}</span>}
          <svg class="arrow" style="width: 14px; height: 14px; margin-left: 4px;"><use href="#i-arrow"/></svg>
        </a>
      ))}
    </div>
  </section>
)}
