---
import Icon from './Icon.astro';

interface LinkItem {
  title: string;
  url: string;
  badge?: string;
}

interface Props {
  heading?: string;
  links: LinkItem[];
  class?: string;
}

const { heading = "Related Services & Areas", links = [], class: className = "" } = Astro.props;

// Filter out empty links or duplicates
const uniqueLinks = Array.from(new Map(links.map((l) => [l.url, l])).values());
---

{uniqueLinks.length > 0 && (
  <section class={`my-8 ${className}`} aria-label={heading}>
    <h3 class="text-xs font-bold uppercase tracking-wider text-surface-500 mb-3">
      {heading}
    </h3>
    <div class="flex flex-wrap gap-2">
      {uniqueLinks.map((link) => (
        <a
          href={link.url}
          class="glass-pill px-3.5 py-1.5 rounded-full text-xs font-medium text-navy dark:text-pearl hover:text-royal hover:bg-white/90 dark:hover:bg-white/10 transition-colors flex items-center gap-1.5"
        >
          <span>{link.title}</span>
          {link.badge && <span class="text-gold text-[10px]">{link.badge}</span>}
          <Icon name="arrow-right" class="w-3 h-3 text-royal opacity-70" />
        </a>
      ))}
    </div>
  </section>
)}
