---
import Icon from './Icon.astro';

interface Props {
  title: string;
  slug: string;
  summary: string;
  icon: string;
  priceFrom?: number;
  priceUnit?: string;
  isSpecialist?: boolean;
}

const {
  title,
  slug,
  summary,
  icon,
  priceFrom,
  priceUnit = "move",
  isSpecialist = false
} = Astro.props;
---

<a
  href={`/removals/${slug}/`}
  class={`glass-panel group block transition-all duration-200 hover:-translate-y-1 hover:shadow-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-royal ${
    isSpecialist ? 'p-4 rounded-2xl' : 'p-6 rounded-3xl'
  }`}
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <div class={`rounded-2xl bg-royal/10 dark:bg-royal/20 flex items-center justify-center text-royal dark:text-royal-light transition-transform group-hover:scale-110 ${
      isSpecialist ? 'w-10 h-10' : 'w-12 h-12'
    }`}>
      <Icon name={icon} class={isSpecialist ? 'w-5 h-5' : 'w-6 h-6'} />
    </div>

    {priceFrom && (
      <span class="text-xs font-bold text-royal dark:text-royal-light bg-royal/5 dark:bg-white/5 px-2.5 py-1 rounded-full">
        From £{priceFrom}
      </span>
    )}
  </div>

  <h3 class={`font-bold text-navy dark:text-pearl tracking-tight group-hover:text-royal transition-colors ${
    isSpecialist ? 'text-sm' : 'text-lg mb-1.5'
  }`}>
    {title}
  </h3>

  <p class={`text-surface-600 dark:text-surface-400 font-normal leading-relaxed ${
    isSpecialist ? 'text-xs line-clamp-2' : 'text-sm'
  }`}>
    {summary}
  </p>

  <div class="mt-4 flex items-center text-xs font-bold text-royal dark:text-royal-light gap-1 group-hover:translate-x-1 transition-transform">
    <span>Learn more</span>
    <Icon name="arrow-right" class="w-3.5 h-3.5" />
  </div>
</a>
