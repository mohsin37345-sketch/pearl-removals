---
// Interaction script for Pearl Removals matching design-template/script.js
---
<script is:inline>
(function () {
  function init() {
    // 1. Sticky header shadow
    const header = document.getElementById('header');
    if (header) {
      const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 10);
      onScroll();
      window.removeEventListener('scroll', onScroll);
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    // 2. Desktop dropdowns (click/tap support; hover handled in CSS)
    document.querySelectorAll('.nav__item > button').forEach((btn) => {
      btn.onclick = (e) => {
        e.stopPropagation();
        const item = btn.parentElement;
        const open = !item.classList.contains('is-open');
        document.querySelectorAll('.nav__item.is-open').forEach((i) => {
          i.classList.remove('is-open');
          i.firstElementChild?.setAttribute('aria-expanded', 'false');
        });
        item.classList.toggle('is-open', open);
        btn.setAttribute('aria-expanded', String(open));
      };
    });
    document.onclick = (e) => {
      if (!e.target.closest('.nav__item')) {
        document.querySelectorAll('.nav__item.is-open').forEach((i) => {
          i.classList.remove('is-open');
          i.firstElementChild?.setAttribute('aria-expanded', 'false');
        });
      }
    };

    // 3. Mobile drawer
    const drawer = document.getElementById('drawer');
    const burger = document.getElementById('burger');
    if (drawer && burger) {
      const setDrawer = (open) => {
        drawer.classList.toggle('is-open', open);
        drawer.setAttribute('aria-hidden', String(!open));
        burger.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
      };
      burger.onclick = () => setDrawer(!drawer.classList.contains('is-open'));
      drawer.querySelectorAll('[data-close], .drawer__nav a, .drawer__cta a').forEach((el) => {
        el.onclick = () => setDrawer(false);
      });
      document.onkeydown = (e) => {
        if (e.key === 'Escape') setDrawer(false);
      };
    }

    // 4. Hide broken/missing photos so the branded gradient shows instead
    document.querySelectorAll('.photo img').forEach((img) => {
      const mark = () => img.setAttribute('data-missing', '');
      if (img.complete && img.naturalWidth === 0) mark();
      img.addEventListener('error', mark);
    });

    // 5. Reveal on scroll
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) {
            en.target.classList.add('is-visible');
            io.unobserve(en.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // 6. Count-up stats
      const countIO = new IntersectionObserver((entries) => {
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          const el = en.target, end = parseFloat(el.dataset.count), dec = +el.dataset.decimals || 0, t0 = performance.now();
          const tick = (t) => {
            const p = Math.min((t - t0) / 1400, 1), v = end * (1 - Math.pow(1 - p, 3));
            el.textContent = v.toLocaleString('en-GB', { minimumFractionDigits: dec, maximumFractionDigits: dec });
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
          countIO.unobserve(el);
        });
      }, { threshold: 0.5 });
      document.querySelectorAll('[data-count]').forEach((el) => countIO.observe(el));
    } else {
      document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
    }

    // 7. Quote form: min date = today, web3forms submission / success state
    const dateInput = document.querySelector('#quoteForm input[type="date"]');
    if (dateInput) dateInput.min = new Date().toISOString().split('T')[0];

    const quoteForm = document.getElementById('quoteForm');
    if (quoteForm) {
      quoteForm.onsubmit = async (e) => {
        e.preventDefault();
        const btn = quoteForm.querySelector('button[type="submit"]');
        btn.textContent = 'Submitting...';
        btn.disabled = true;

        const formData = new FormData(quoteForm);
        const dataObj = Object.fromEntries(formData.entries());

        // Connect to existing Web3Forms / email endpoint
        try {
          const accessKey = quoteForm.querySelector('input[name="access_key"]')?.value || 'YOUR_ACCESS_KEY_HERE';
          await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
              access_key: accessKey,
              subject: 'Instant Quote Request - Pearl Removals',
              from_name: 'Pearl Removals Website',
              ...dataObj
            })
          });
        } catch (_) {}

        btn.textContent = "Thanks! We'll text your price shortly ✓";
      };
    }

    // 8. Postcode checker
    const covered = ['NW', 'HA', 'W', 'WD', 'EN', 'UB', 'N'];
    const pcForm = document.getElementById('postcodeForm');
    const pcResult = document.getElementById('postcodeResult');
    if (pcForm && pcResult) {
      pcForm.onsubmit = (e) => {
        e.preventDefault();
        const val = pcForm.querySelector('input').value.trim().toUpperCase();
        const area = (val.match(/^[A-Z]{1,2}/) || [''])[0];
        if (!area) {
          pcResult.style.color = 'var(--muted)';
          pcResult.textContent = 'Please enter a postcode.';
          return;
        }
        const ok = covered.includes(area);
        pcResult.style.color = ok ? 'var(--mint)' : 'var(--accent-dark)';
        pcResult.textContent = ok
          ? `✓ Great news — we cover ${val}. Same-week slots available.`
          : `We can still help with moves from ${val} — call us for a quote.`;
      };
    }

    // 9. Year in footer
    const y = document.getElementById('year');
    if (y) y.textContent = new Date().getFullYear();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

