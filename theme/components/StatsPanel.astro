---
import { siteConfig } from 'src/data/site';
import Icon from './Icon.astro';

const hasStats = siteConfig.stats && siteConfig.stats.length > 0;
---

<section class="py-12 lg:py-16" aria-labelledby="why-choose-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="glass-panel p-8 sm:p-12 lg:p-16 border border-white/80 dark:border-white/10 shadow-xl">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-royal mb-2 block">Our Standard of Service</span>
        <h2 id="why-choose-heading" class="text-3xl sm:text-4xl font-black text-navy dark:text-pearl tracking-tight">
          Why Choose Pearl Removals
        </h2>
        <p class="text-sm sm:text-base text-surface-600 dark:text-surface-400 mt-2">
          A dedicated removals team focused on punctuality, polite communication, and pristine handling of every possession.
        </p>
      </div>

      {hasStats ? (
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
          {siteConfig.stats.map((stat) => (
            <div class="glass-pill p-6 rounded-2xl">
              <div class="text-3xl sm:text-4xl font-black text-royal dark:text-royal-light mb-1">
                {stat.value}
              </div>
              <div class="text-xs sm:text-sm font-semibold text-navy dark:text-pearl">
                {stat.label}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {siteConfig.trustPromises.map((promise) => (
            <div class="glass-pill p-6 rounded-2xl flex flex-col items-center sm:items-start text-center sm:text-left hover:-translate-y-1 transition-transform">
              <div class="w-12 h-12 rounded-2xl bg-royal/10 dark:bg-royal/20 flex items-center justify-center text-royal dark:text-royal-light mb-4">
                <Icon name={promise.icon} class="w-6 h-6" />
              </div>
              <h3 class="font-bold text-base text-navy dark:text-pearl mb-2">
                {promise.title}
              </h3>
              <p class="text-xs sm:text-sm text-surface-600 dark:text-surface-400 leading-relaxed">
                {promise.description}
              </p>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
