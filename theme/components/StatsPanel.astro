---
interface StatItem {
  count: number | string;
  decimals?: number;
  prefix?: string;
  suffix?: string;
  label: string;
}

interface Props {
  stats?: StatItem[];
}

const defaultStats: StatItem[] = [
  { count: 2400, suffix: "+", label: "Moves completed" },
  { count: 4.9, decimals: 1, suffix: "★", label: "Average rating" },
  { count: 98, suffix: "%", label: "On-time arrival" },
  { count: 0, prefix: "£", label: "Hidden fees. Ever." }
];

const { stats = defaultStats } = Astro.props;
---

<div class="container" style="margin-top: clamp(40px, 6vw, 64px)">
  <div class="stats reveal">
    {stats.map((item) => (
      <div class="stat">
        <b>
          {item.prefix || ''}
          <span data-count={item.count} data-decimals={item.decimals || 0}>0</span>
          {item.suffix ? <em>{item.suffix}</em> : ''}
        </b>
        <span>{item.label}</span>
      </div>
    ))}
  </div>
</div>
