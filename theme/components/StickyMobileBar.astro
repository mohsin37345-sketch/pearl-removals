---
import { siteConfig } from 'src/data/site';

interface Props {
  areaName?: string;
  serviceTitle?: string;
}

const { areaName, serviceTitle } = Astro.props;
---

<!-- Sticky call/quote bar (mobile only) -->
<div class="mobile-bar">
  <a href={`tel:${siteConfig.phoneE164}`} class="btn btn--outline-light">
    <svg><use href="#i-phone"/></svg> Call
  </a>
  <a href="/get-a-quote/" class="btn btn--accent">
    Free quote
  </a>
</div>
