---
interface ReviewItem {
  quote: string;
  name: string;
  details: string;
  initials: string;
  avatarBg?: string;
  big?: boolean;
}

interface Props {
  eyebrow?: string;
  title?: string;
  googleReviewsLink?: string;
  reviews?: any[];
}

const defaultReviews: ReviewItem[] = [
  {
    big: true,
    initials: "SK",
    name: "Sarah K.",
    details: "Harrow → Pinner · 3-bed house",
    quote: "Honestly the easiest move we've ever had. The team turned up early, wrapped every piece of furniture and had our 3-bed done by lunchtime. Not a single scratch."
  },
  {
    initials: "JM",
    avatarBg: "#2f6bff",
    name: "James M.",
    details: "Kilburn · 2-bed flat",
    quote: "Fixed price meant zero stress. Fourth-floor flat with no lift and they didn't complain once."
  },
  {
    initials: "AR",
    avatarBg: "#18b26b",
    name: "Aisha R.",
    details: "Wembley · Office move",
    quote: "Moved our whole office over a weekend. Monday morning, everything was set up and working."
  },
  {
    initials: "TP",
    avatarBg: "#0b1a2e",
    name: "Tom P.",
    details: "Hendon · 1-bed flat",
    quote: "Booked on Thursday, moved on Saturday. Friendly, quick and great communication throughout."
  },
  {
    initials: "LN",
    avatarBg: "#e4521a",
    name: "Lucy N.",
    details: "Ealing · 4-bed house",
    quote: "The packing service was worth every penny. Everything labelled by room — unpacking was a breeze."
  }
];

const {
  eyebrow = "Reviews",
  title = "380+ five-star moves and counting.",
  googleReviewsLink = "/reviews/",
  reviews = []
} = Astro.props;

// Use passed reviews if provided, otherwise default to template reviews
const displayReviews: ReviewItem[] = reviews && reviews.length > 0
  ? reviews.map((r, i) => ({
      big: i === 0,
      initials: r.author?.slice(0, 2).toUpperCase() || r.name?.slice(0, 2).toUpperCase() || "PR",
      avatarBg: i % 4 === 1 ? "#2f6bff" : i % 4 === 2 ? "#18b26b" : i % 4 === 3 ? "#0b1a2e" : "#e4521a",
      name: r.author || r.name || "Customer",
      details: r.location ? `${r.location} · Verified Move` : "London · Verified Move",
      quote: r.reviewBody || r.quote || ""
    }))
  : defaultReviews;
---

<section class="section section--white" id="reviews">
  <div class="container">
    <div class="section-head section-head--split reveal">
      <div>
        <span class="eyebrow">{eyebrow}</span>
        <h2>{title}</h2>
      </div>
      <a href={googleReviewsLink} class="btn btn--ghost">
        See all Google reviews <svg class="arrow"><use href="#i-arrow"/></svg>
      </a>
    </div>

    <div class="reviews">
      {displayReviews.map((rev) => (
        <article class={`review ${rev.big ? 'review--big' : ''} reveal`}>
          <span class="stars">
            <svg><use href="#i-star"/></svg>
            <svg><use href="#i-star"/></svg>
            <svg><use href="#i-star"/></svg>
            <svg><use href="#i-star"/></svg>
            <svg><use href="#i-star"/></svg>
          </span>
          {rev.big && <div class="review__quote-mark">“</div>}
          <blockquote>{rev.quote}</blockquote>
          <div class="review__who">
            <span
              class="review__avatar"
              style={rev.avatarBg ? `background:${rev.avatarBg}` : ''}
            >
              {rev.initials}
            </span>
            <div>
              <strong>{rev.name}</strong>
              <span>{rev.details}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
