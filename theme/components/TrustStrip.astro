---
interface Props {
  label?: string;
  variant?: string;
}

const {
  label = "Trusted & verified"
} = Astro.props;
---

<div class="trust">
  <div class="container">
    <span class="trust__label">{label}</span>
    <div class="trust__logos">
      <!-- 1. Google 4.9 Reviews -->
      <a href="/reviews/" class="trust__logo trust__logo--google" title="Google 4.9 Star Rating">
        <svg class="trust__icon-brand"><use href="#i-google"/></svg>
        <span class="trust__brand-text">Google</span>
        <span class="trust__stars">
          <svg><use href="#i-star"/></svg>
          <svg><use href="#i-star"/></svg>
          <svg><use href="#i-star"/></svg>
          <svg><use href="#i-star"/></svg>
          <svg><use href="#i-star"/></svg>
        </span>
        <span class="trust__score">4.9</span>
      </a>

      <!-- 2. Trustpilot -->
      <a href="/reviews/" class="trust__logo trust__logo--trustpilot" title="Trustpilot Verified Reviews">
        <svg class="trust__icon-brand"><use href="#i-trustpilot"/></svg>
        <span class="trust__brand-text">Trustpilot</span>
        <span class="trust__badge-pill">5★</span>
      </a>

      <!-- 3. Fully Insured -->
      <span class="trust__logo trust__logo--shield">
        <svg><use href="#i-shield"/></svg>
        <span>£50k GIT Insured</span>
      </span>

      <!-- 4. DBS Checked -->
      <span class="trust__logo trust__logo--dbs">
        <svg><use href="#i-users"/></svg>
        <span>DBS Checked</span>
      </span>

      <!-- 5. Trading Standards -->
      <span class="trust__logo trust__logo--standard">
        <svg><use href="#i-check-circle"/></svg>
        <span>Trading Standards</span>
      </span>
    </div>
  </div>
</div>

<style>
  .trust__logos {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3.5vw, 42px);
    flex-wrap: wrap;
  }

  .trust__logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15.5px;
    color: var(--text);
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .trust__logo:hover {
    transform: translateY(-1px);
  }

  .trust__icon-brand {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  .trust__brand-text {
    font-weight: 700;
    color: var(--ink);
  }

  .trust__stars {
    display: inline-flex;
    gap: 2px;
    color: #ffb703;
  }

  .trust__stars svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  .trust__score {
    font-size: 13.5px;
    font-weight: 800;
    color: var(--ink);
    background: rgba(11, 26, 46, 0.06);
    padding: 2px 7px;
    border-radius: 6px;
  }

  .trust__badge-pill {
    font-size: 11px;
    font-weight: 800;
    background: #00B67A;
    color: #fff;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .trust__logo svg:not(.trust__icon-brand) {
    width: 19px;
    height: 19px;
    color: var(--accent);
  }

  .trust__logo--shield svg {
    color: #2f6bff;
  }

  .trust__logo--dbs svg {
    color: #18b26b;
  }

  .trust__logo--standard svg {
    color: #18b26b;
  }
</style>
