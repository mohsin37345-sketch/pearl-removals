---
import { siteConfig } from 'src/data/site';
import Icon from './Icon.astro';

interface Props {
  variant?: 'compact' | 'full' | 'hero-strip';
  hasVerifiedReviews?: boolean;
}

const { variant = 'full', hasVerifiedReviews = false } = Astro.props;
---

{variant === 'full' && (
  <section class="w-full py-4 px-4 border-y border-surface-200/80 dark:border-white/10 bg-white/40 dark:bg-navy/40 backdrop-blur-sm" aria-label="Trust Promises">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-xs md:text-sm font-medium text-navy/90 dark:text-pearl/90">
      {siteConfig.claims.map((claim) => (
        <div class="flex items-center gap-2">
          <Icon name="check" class="w-4 h-4 text-royal font-bold" />
          <span>{claim}</span>
        </div>
      ))}
    </div>
  </section>
)}

{variant === 'compact' && (
  <div class="flex flex-wrap items-center gap-3 text-xs text-navy/80 dark:text-pearl/80">
    <div class="flex items-center gap-1.5 font-medium">
      <Icon name="shield-check" class="w-4 h-4 text-royal" />
      <span>£50k GIT & £5M Public Liability</span>
    </div>
    <span class="text-surface-300">•</span>
    <div class="flex items-center gap-1.5 font-medium">
      <Icon name="check" class="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
      <span>No Hidden Fees</span>
    </div>
    <span class="text-surface-300">•</span>
    <div class="flex items-center gap-1.5 font-medium">
      <Icon name="map-pin" class="w-4 h-4 text-royal" />
      <span>Cricklewood NW2 Base</span>
    </div>
  </div>
)}
