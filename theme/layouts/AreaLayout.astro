---
import BaseLayout from './BaseLayout.astro';
import Hero from 'theme/components/Hero.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import MicroAreaGrid from 'theme/components/MicroAreaGrid.astro';
import PremiumServicesCallout from 'theme/components/PremiumServicesCallout.astro';
import FAQ from 'theme/components/FAQ.astro';
import CTABand from 'theme/components/CTABand.astro';
import QuoteFormSection from 'theme/components/QuoteFormSection.astro';
import RelatedLinks from 'theme/components/RelatedLinks.astro';
import Icon from 'theme/components/Icon.astro';

interface Props {
  area: {
    name: string;
    slug: string;
    region: string;
    regionName?: string;
    phase: 1 | 2 | 3;
    premium: boolean;
    boroughs: string[];
    postcodes: string[];
    distanceMiles: number;
    metaTitle: string;
    metaDescription: string;
    intro: string;
    localKnowledge: string;
    propertyTypes: string;
    parkingAndAccess: string;
    transportLinks?: string;
    travelInfo?: string;
    nearbyAreas?: Array<{ name: string; slug: string }>;
    servicesOffered?: string[];
    localFaqs?: Array<{ question: string; answer: string; display?: boolean }>;
    testimonial?: { name: string; quote: string; rating?: number };
    micros?: Array<{ name: string; slug: string; premium?: boolean }>;
  };
}

const { area } = Astro.props;

const breadcrumbs = [
  { name: 'Areas', url: '/areas/' },
  { name: area.regionName || 'North West London', url: `/areas/${area.region}/` },
  { name: area.name, url: `/areas/${area.slug}/` }
];

const nearbyLinks = (area.nearbyAreas || []).map((a) => ({
  title: `Removals in ${a.name}`,
  url: `/areas/${a.slug}/`
}));

const serviceLinks = [
  { title: `House Removals ${area.name}`, url: `/removals/house-removals/${area.slug}/` },
  { title: `Man and Van ${area.name}`, url: `/removals/man-and-van/${area.slug}/` },
  { title: `Flat Removals ${area.name}`, url: `/removals/flat-removals/` },
  { title: `Packing Services ${area.name}`, url: `/removals/packing-services/` },
  { title: `Storage Solutions ${area.name}`, url: `/removals/storage/` }
];
---

<BaseLayout
  title={area.metaTitle}
  description={area.metaDescription}
  canonicalUrl={`https://www.pearlremovals.co.uk/areas/${area.slug}/`}
  schemaType="area"
  areaData={area}
  breadcrumbs={breadcrumbs}
  faqs={area.localFaqs || []}
>
  <!-- Area Hero Section -->
  <Hero
    variant="area"
    title={`Removals in ${area.name}`}
    highlightText={area.name}
    subtitle={`Professional, insured residential removals and man & van services across ${area.postcodes.join(', ')}.`}
    eyebrow={`LOCAL LONDON REMOVALS • ~${area.distanceMiles} MILES FROM OUR CRICKLEWOOD BASE`}
    badges={[...area.postcodes, ...area.boroughs.map(b => `London Borough of ${b}`)]}
    defaultFromPostcode={area.postcodes[0] || 'NW2'}
  />

  <TrustStrip />

  <Breadcrumbs items={breadcrumbs} />

  <!-- Main Area Content Container -->
  <article class="container" style="padding-block: 40px; display: flex; flex-direction: column; gap: 40px;">
    
    <!-- Intro & Local Knowledge -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8 space-y-6 text-sm sm:text-base leading-relaxed" style="color: var(--text);">
        
        <!-- Area Intro -->
        <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); padding: clamp(24px, 4vw, 36px); box-shadow: var(--shadow-sm);">
          <h2 style="font-size: clamp(22px, 3vw, 28px); margin-bottom: 14px; color: var(--ink);">
            Trusted Removals in {area.name} ({area.postcodes.join(', ')})
          </h2>
          <p style="color: var(--muted); line-height: 1.65; margin: 0;">
            {area.intro}
          </p>
        </div>

        <!-- Local Knowledge Section -->
        <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); padding: clamp(24px, 4vw, 36px); box-shadow: var(--shadow-sm);">
          <h3 style="font-size: 20px; font-weight: 700; color: var(--ink); margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
            <svg style="width: 20px; height: 20px; color: var(--accent);"><use href="#i-pin"/></svg>
            <span>Local Access &amp; Geography in {area.name}</span>
          </h3>
          <p style="color: var(--muted); line-height: 1.65; margin: 0;">
            {area.localKnowledge}
          </p>
        </div>

        <!-- Property Types & Access / CPZ notes -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-6">
          <div style="background: var(--pearl); border: 1px solid var(--line); border-radius: var(--r-md); padding: 20px;">
            <h4 style="font-size: 16px; font-weight: 700; color: var(--ink); margin-bottom: 8px; display: flex; align-items: center; gap: 8px;">
              <svg style="width: 18px; height: 18px; color: var(--accent);"><use href="#i-home"/></svg>
              <span>Property Architecture</span>
            </h4>
            <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">
              {area.propertyTypes}
            </p>
          </div>

          <div style="background: var(--pearl); border: 1px solid var(--line); border-radius: var(--r-md); padding: 20px;">
            <h4 style="font-size: 16px; font-weight: 700; color: var(--ink); margin-bottom: 8px; display: flex; align-items: center; gap: 8px;">
              <svg style="width: 18px; height: 18px; color: var(--accent);"><use href="#i-truck"/></svg>
              <span>Parking &amp; CPZ Regulations</span>
            </h4>
            <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">
              {area.parkingAndAccess}
            </p>
          </div>
        </div>

        <!-- Travel & Transport Info -->
        {area.travelInfo && (
          <div style="font-size: 14px; color: var(--muted); padding-top: 8px;">
            <strong style="color: var(--ink);">Logistics &amp; Connectivity:</strong> {area.travelInfo}
          </div>
        )}

        <slot />
      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-4">
        <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); padding: 24px; position: sticky; top: calc(var(--header-h) + 24px); box-shadow: var(--shadow-sm);">
          <h3 style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 16px;">
            {area.name} Quick Facts
          </h3>

          <ul style="display: grid; gap: 10px; font-size: 14px; margin-bottom: 20px;">
            <li style="display: flex; justify-content: space-between; padding-bottom: 8px; border-bottom: 1px solid var(--line);">
              <span style="color: var(--muted);">Postcode Districts:</span>
              <strong style="color: var(--ink);">{area.postcodes.join(', ')}</strong>
            </li>
            <li style="display: flex; justify-content: space-between; padding-bottom: 8px; border-bottom: 1px solid var(--line);">
              <span style="color: var(--muted);">Local Authority:</span>
              <strong style="color: var(--ink);">{area.boroughs.join(' / ')}</strong>
            </li>
            <li style="display: flex; justify-content: space-between; padding-bottom: 8px; border-bottom: 1px solid var(--line);">
              <span style="color: var(--muted);">Distance to Base:</span>
              <strong style="color: var(--ink);">~{area.distanceMiles} miles</strong>
            </li>
            <li style="display: flex; justify-content: space-between; padding-bottom: 8px; border-bottom: 1px solid var(--line);">
              <span style="color: var(--muted);">Insurance:</span>
              <strong style="color: var(--ink);">£50k GIT / £5M PL</strong>
            </li>
          </ul>

          <div>
            <a
              href="/get-a-quote/"
              class="btn btn--accent btn--block btn--sm"
            >
              Get a Quote for {area.name} <svg class="arrow"><use href="#i-arrow"/></svg>
            </a>
          </div>
        </div>
      </aside>
    </div>

    <!-- Micro Areas Grid (hides automatically if empty) -->
    {area.micros && area.micros.length > 0 && (
      <MicroAreaGrid parentSlug={area.slug} parentName={area.name} micros={area.micros} />
    )}

    <!-- Premium Services Block (Mandatory on premium areas per spec!) -->
    {area.premium && (
      <PremiumServicesCallout areaName={area.name} />
    )}

    <!-- Services Offered in This Area -->
    <RelatedLinks
      heading={`Removals Services in ${area.name}`}
      links={serviceLinks}
    />

    <!-- Nearby Areas Internal Links -->
    {nearbyLinks.length > 0 && (
      <RelatedLinks
        heading={`Nearby Areas We Cover Around ${area.name}`}
        links={nearbyLinks}
      />
    )}

    <!-- Local FAQs -->
    {area.localFaqs && area.localFaqs.length > 0 && (
      <FAQ items={area.localFaqs} title={`Removals in ${area.name} FAQs`} />
    )}

    <!-- CTA Band -->
    <CTABand
      title={`Moving to or from ${area.name}?`}
      description="Book your North West London house move with Pearl Removals. Free, transparent quotes in 60 seconds."
    />

    <!-- Inline Form -->
    <QuoteFormSection
      title={`Get a Free Moving Quote for ${area.name}`}
      defaultFromPostcode={area.postcodes[0] || 'NW2'}
    />

  </article>
</BaseLayout>
