---
import 'src/styles/global.css';
import ConsentInit from 'theme/components/ConsentInit.astro';
import SEOHead from 'theme/components/SEOHead.astro';
import SchemaOrg from 'theme/components/SchemaOrg.astro';
import SvgSprite from 'theme/components/SvgSprite.astro';
import Header from 'theme/components/Header.astro';
import Footer from 'theme/components/Footer.astro';
import StickyMobileBar from 'theme/components/StickyMobileBar.astro';
import SiteScripts from 'theme/components/SiteScripts.astro';
import LazyScripts from 'theme/components/LazyScripts.astro';
import { getPublishedAreas } from 'theme/utils/published';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  noindex?: boolean;
  schemaType?: 'home' | 'service' | 'area' | 'micro' | 'region' | 'service-area' | 'about' | 'contact' | 'blog' | 'post' | 'page';
  breadcrumbs?: Array<{ name: string; url: string }>;
  faqs?: Array<{ question: string; answer: string; display?: boolean }>;
  serviceData?: any;
  areaData?: any;
  verifiedReviews?: any[];
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
  showStickyBar?: boolean;
}

const {
  title,
  description,
  canonicalUrl,
  noindex = false,
  schemaType = 'page',
  breadcrumbs = [],
  faqs = [],
  serviceData,
  areaData,
  verifiedReviews = [],
  ogType = 'website',
  ogImage,
  ogImageAlt,
  publishedTime,
  modifiedTime,
  showStickyBar = true
} = Astro.props;

const publishedAreas = await getPublishedAreas();
---

<!DOCTYPE html>
<html lang="en-GB" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    
    <!-- 1. Consent Mode v2 -->
    <ConsentInit />

    <!-- 2. Meta, Canonical, Robots, Open Graph & Fonts -->
    <SEOHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      noindex={noindex}
      ogType={ogType}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />

    <!-- 3. Centralised Schema Graph -->
    <SchemaOrg
      type={schemaType}
      title={title}
      description={description}
      breadcrumbs={breadcrumbs}
      faqs={faqs}
      serviceData={serviceData}
      areaData={areaData}
      publishedAreas={publishedAreas}
      verifiedReviews={verifiedReviews}
    />
  </head>

  <body>
    <!-- SVG Icon Sprite -->
    <SvgSprite />

    <!-- Accessible Skip to Content Link -->
    <a href="#main-content" class="visually-hidden">
      Skip to main content
    </a>

    <!-- Global Header (Top bar + Sticky Menu + Mega Dropdowns + Mobile Drawer) -->
    <Header />

    <!-- Main Landmark -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />

    <!-- Mobile Sticky Call & Quote Bar -->
    {showStickyBar && (
      <StickyMobileBar 
        areaName={areaData?.name} 
        serviceTitle={serviceData?.title} 
      />
    )}

    <!-- Global Core Interactions (from design-template/script.js) -->
    <SiteScripts />

    <!-- Interaction-Gated Third-Party Scripts -->
    <LazyScripts />
  </body>
</html>
