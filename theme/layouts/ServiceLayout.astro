---
import BaseLayout from './BaseLayout.astro';
import Hero from 'theme/components/Hero.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import HowItWorks from 'theme/components/HowItWorks.astro';
import FAQ from 'theme/components/FAQ.astro';
import CTABand from 'theme/components/CTABand.astro';
import QuoteFormSection from 'theme/components/QuoteFormSection.astro';
import PremiumServicesCallout from 'theme/components/PremiumServicesCallout.astro';
import RelatedLinks from 'theme/components/RelatedLinks.astro';

interface Props {
  service: {
    title: string;
    slug: string;
    metaTitle: string;
    metaDescription: string;
    heroHeading: string;
    heroSubheading: string;
    icon: string;
    summary: string;
    benefits?: string[];
    process?: Array<{ step: number; title: string; description: string }>;
    whatsIncluded?: string[];
    whatsNotIncluded?: string[];
    priceFrom?: number;
    priceUnit?: string;
    priceNotes?: string;
    faqs?: Array<{ question: string; answer: string; display?: boolean }>;
    relatedServices?: string[];
    premiumAngle?: string;
  };
}

const { service } = Astro.props;

const breadcrumbs = [
  { name: 'Services', url: '/removals/' },
  { name: service.title, url: `/removals/${service.slug}/` }
];

const topAreaLinks = [
  { title: 'Removals Cricklewood NW2', url: '/areas/cricklewood/' },
  { title: 'Removals Hampstead NW3', url: '/areas/hampstead/', badge: '★' },
  { title: 'Removals Kilburn NW6', url: '/areas/kilburn/' },
  { title: 'Removals Hendon NW4', url: '/areas/hendon/' },
  { title: 'Removals Mill Hill NW7', url: '/areas/mill-hill/', badge: '★' },
  { title: 'Removals St John\'s Wood NW8', url: '/areas/st-johns-wood/', badge: '★' },
  { title: 'Removals Maida Vale W9', url: '/areas/maida-vale/', badge: '★' },
  { title: 'Removals West Hampstead NW6', url: '/areas/west-hampstead/' }
];
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  canonicalUrl={`https://www.pearlremovals.co.uk/removals/${service.slug}/`}
  schemaType="service"
  serviceData={service}
  breadcrumbs={breadcrumbs}
  faqs={service.faqs || []}
>
  <!-- Hero Section -->
  <Hero
    variant="service"
    title={service.heroHeading}
    subtitle={service.heroSubheading}
    eyebrow="PEARL REMOVALS • CORE SERVICE"
    priceFrom={service.priceFrom}
    priceUnit={service.priceUnit}
  />

  <TrustStrip />

  <Breadcrumbs items={breadcrumbs} />

  <!-- Main Content Structure -->
  <article class="container" style="padding-block: 40px; display: flex; flex-direction: column; gap: 40px;">
    
    <!-- Introduction & Benefits -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8 space-y-6 text-sm sm:text-base leading-relaxed" style="color: var(--text);">
        <slot />

        {service.benefits && service.benefits.length > 0 && (
          <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); padding: clamp(24px, 4vw, 36px); box-shadow: var(--shadow-sm); margin-top: 24px;">
            <h3 style="font-size: 20px; font-weight: 700; color: var(--ink); margin-bottom: 16px;">
              Key Benefits of Choosing Pearl Removals for {service.title}
            </h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {service.benefits.map((b) => (
                <li style="display: flex; align-items: flex-start; gap: 10px; font-size: 14px; color: var(--text);">
                  <svg style="width: 18px; height: 18px; color: var(--mint); flex-shrink: 0; margin-top: 2px;"><use href="#i-check-circle"/></svg>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <!-- Sidebar Quick Info -->
      <aside class="lg:col-span-4">
        <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); padding: 24px; position: sticky; top: calc(var(--header-h) + 24px); box-shadow: var(--shadow-sm);">
          <h3 style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 16px;">
            Service Highlights
          </h3>

          <div style="display: grid; gap: 12px; font-size: 14px;">
            <div style="display: flex; align-items: center; gap: 10px;">
              <span class="icon-tile" style="width: 32px; height: 32px; border-radius: 8px;"><svg style="width: 16px; height: 16px;"><use href="#i-shield"/></svg></span>
              <span>£50,000 Goods in Transit Cover</span>
            </div>
            <div style="display: flex; align-items: center; gap: 10px;">
              <span class="icon-tile" style="width: 32px; height: 32px; border-radius: 8px;"><svg style="width: 16px; height: 16px;"><use href="#i-shield"/></svg></span>
              <span>£5,000,000 Public Liability</span>
            </div>
            <div style="display: flex; align-items: center; gap: 10px;">
              <span class="icon-tile" style="width: 32px; height: 32px; border-radius: 8px;"><svg style="width: 16px; height: 16px;"><use href="#i-pin"/></svg></span>
              <span>Cricklewood NW2 Base</span>
            </div>
            <div style="display: flex; align-items: center; gap: 10px;">
              <span class="icon-tile" style="width: 32px; height: 32px; border-radius: 8px;"><svg style="width: 16px; height: 16px;"><use href="#i-clock"/></svg></span>
              <span>7 Days a Week Availability</span>
            </div>
          </div>

          {service.priceNotes && (
            <div style="margin-top: 16px; padding: 12px; border-radius: 10px; background: var(--pearl); font-size: 13px; color: var(--muted); line-height: 1.5;">
              <strong style="color: var(--ink);">Pricing note:</strong> {service.priceNotes}
            </div>
          )}

          <div style="margin-top: 20px;">
            <a
              href="/get-a-quote/"
              class="btn btn--accent btn--block btn--sm"
            >
              Request Free Quote <svg class="arrow"><use href="#i-arrow"/></svg>
            </a>
          </div>
        </div>
      </aside>
    </div>

    <!-- What's Included / Not Included Comparison -->
    {(service.whatsIncluded?.length || service.whatsNotIncluded?.length) && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
        <!-- What's Included -->
        <div style="background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--mint); border-radius: var(--r-lg); padding: 28px;">
          <h3 style="font-size: 18px; font-weight: 700; color: var(--ink); margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
            <svg style="width: 20px; height: 20px; color: var(--mint);"><use href="#i-check-circle"/></svg>
            <span>What's Included as Standard</span>
          </h3>
          <ul style="display: grid; gap: 10px; font-size: 14.5px; color: var(--text);">
            {service.whatsIncluded?.map((item) => (
              <li style="display: flex; gap: 8px; align-items: flex-start;">
                <span style="color: var(--mint); font-weight: bold;">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- What's Not Included (Transparent Exclusions) -->
        <div style="background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--muted); border-radius: var(--r-lg); padding: 28px;">
          <h3 style="font-size: 18px; font-weight: 700; color: var(--ink); margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
            <svg style="width: 20px; height: 20px; color: var(--muted);"><use href="#i-x"/></svg>
            <span>Excluded or Available as Add-On</span>
          </h3>
          <ul style="display: grid; gap: 10px; font-size: 14.5px; color: var(--muted);">
            {service.whatsNotIncluded?.map((item) => (
              <li style="display: flex; gap: 8px; align-items: flex-start;">
                <span style="color: var(--muted);">✕</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}

    <!-- Process Steps -->
    {service.process && service.process.length > 0 && (
      <HowItWorks
        title={`Our ${service.title} Process`}
        description="Meticulous planning and execution from your initial consultation to final delivery."
        steps={service.process.map(p => ({
          title: p.title,
          description: p.description,
          icon: 'box'
        }))}
      />
    )}

    <!-- Premium Services Callout -->
    {service.premiumAngle ? (
      <div style="background: var(--pearl); border: 1px solid var(--line); border-radius: var(--r-xl); padding: 28px;">
        <h3 style="font-size: 18px; font-weight: 700; color: var(--ink); margin-bottom: 8px;">
          White-Glove &amp; Specialist Care Available
        </h3>
        <p style="font-size: 14.5px; color: var(--muted); line-height: 1.6; margin: 0;">
          {service.premiumAngle}
        </p>
      </div>
    ) : (
      <PremiumServicesCallout />
    )}

    <!-- Top Areas for this Service -->
    <RelatedLinks
      heading={`Popular Areas We Provide ${service.title}`}
      links={topAreaLinks}
    />

    <!-- FAQs -->
    {service.faqs && service.faqs.length > 0 && (
      <FAQ items={service.faqs} title={`${service.title} FAQs`} />
    )}

    <!-- CTA Band -->
    <CTABand
      title={`Book Your ${service.title} in North West London`}
      description="Speak with our Cricklewood dispatch team or schedule a free video walk-through survey today."
    />

    <!-- Inline Form -->
    <QuoteFormSection title={`Get an Instant ${service.title} Quote`} />

  </article>
</BaseLayout>
